# --- secrets, storage, power ----------------------------------------------
gnome-keyring       # Secret Service for firefox/discord credentials
libsecret
udiskie             # automount removable media
gvfs
brightnessctl
ddcutil             # brightness on EXTERNAL monitors over DDC/CI. brightnessctl
                    # only drives the internal panel; an external display has
                    # no /sys/class/backlight entry at all.
fprintd             # the fingerprint reader. hypr/hyprlock.conf declares a
                    # fingerprint auth block, which silently does nothing
                    # without this -- it talks to fprintd over D-Bus.
power-profiles-daemon   # PPD, never TLP: the two conflict. ergon-hardware adds the
                        # drop-in that stops it desaturating an amdgpu panel.
fwupd                   # firmware updates from LVFS (BIOS, fingerprint reader,
                        # docks, SSDs). ergon-sleep check reports pending ones.
restic                  # ergon backup: /home off this disk. Snapshots share the
                        # disk they protect; this is what survives a dead SSD.
nfs-utils               # the NAS is an NFS share, and a restic repository is a
                        # path on it. Not needed for an sftp: or rest: one.

# --- graphics ------------------------------------------------------------
# mesa and the loader are vendor-neutral and always needed; the ICD that
# actually drives your GPU is chosen at provision time from what is on the PCI
# bus (see the "graphics" stage in provision-arch.sh). Listing every vendor's
# driver here would pull Intel and Nouveau onto an AMD laptop for nothing.
#
# Hyprland needs a working Vulkan or GLES path. Without an ICD it starts,
# renders through llvmpipe, and feels broken in a way that reads as a compositor
# problem rather than a missing package.
mesa
vulkan-icd-loader
libva-utils         # `vainfo` is how you find out whether hardware video
                    # decode is actually working, rather than assuming

# --- clipboard and capture -------------------------------------------------
wl-clipboard
cliphist            # clipboard history
grim
slurp
satty               # screenshot annotation
imagemagick         # bin/ergon-wallpaper generates the background from the
                    # palette; also the general-purpose image converter
wf-recorder
tesseract           # OCR; see bin/ergon-ocr
tesseract-data-eng

time                # GNU time, for peak RSS. ergon-watch records it per run;
                    # without this the journal's peak_mb column is always zero
                    # and "what did that fit actually need" stays unanswerable.

# --- synthetic input -------------------------------------------------------
# Injects events at the kernel level (uinput), so the compositor sees them as a
# real device rather than as a client request. That is the only way to test a
# CLICK: every waybar module's on-click is a shell command that nothing else in
# this repo ever executes, and "waybar mapped a layer surface" says nothing
# about whether pressing it does anything. See test/arch-vm/guest-desktop.sh.
ydotool

