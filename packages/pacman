wl-clipboard
cliphist            # clipboard history
wtype               # types the emoji ergon-emoji picks
unicode-emoji       # emoji-test.txt, the data ergon-emoji lists
grim
slurp
satty               # screenshot annotation
imagemagick         # bin/ergon-wallpaper generates the background from the
                    # palette; also the general-purpose image converter
wf-recorder
tesseract           # OCR; see bin/ergon-ocr
tesseract-data-eng
zbar                # QR decoding (zbarimg); see bin/ergon-qr
ffmpeg              # webcam recording; see bin/ergon-webcam. mpv pulls the libs, but
