# --- system ----------------------------------------------------------------
inetutils           # hostname(1); arch-bootstrap writes /etc/hostname
networkmanager      # nmcli/nmtui; bin/ergon-wifi is the picker, waybar's network module reads it
pacman-contrib      # paccache, checkupdates, pacdiff
rebuild-detector    # checkrebuild: which installed packages link a shared
                    # library that is no longer on disk. Nothing else on an
                    # Arch machine ever rebuilds an AUR package after a soname
                    # bump, and the failure is silent -- the binary dies at
                    # exec, so waybar-git simply never appears and no log says
                    # why. `ergon update` and `ergon doctor` both read it.
reflector           # mirror ranking
informant           # BLOCKS an upgrade until the Arch news item is read.
                    # On a rolling distro the manual-intervention notices are
                    # the ones that break a machine, and they are always
                    # announced before they land.
docker
docker-compose
nftables            # the firewall provisioning writes. iptables-nft, which docker
                    # depends on, is the iptables CLI over the same backend --
                    # it ships neither the nft command nor nftables.service
tailscale
age
sops
uv                  # python tooling; per-tool venvs, never a system python

# --- printing (ERGON-40) ----------------------------------------------------
# Driverless IPP only -- campus and observatory printers overwhelmingly speak
# it, and it needs no PPD or vendor driver on this machine at all.
cups                # NOT cups-browsed: Omarchy shipped it and then removed it
                    # (migrations/1788009111.sh over there). system-config-printer
                    # is left out too; nothing here has needed a GUI for a queue.
avahi               # advertises/browses over mDNS; cups already depends on it,
                    # listed anyway because provisioning enables it by name
nss-mdns            # resolves a *.local NAME through avahi; does nothing until
                    # nsswitch.conf's hosts: line says to try it (provisioning)

