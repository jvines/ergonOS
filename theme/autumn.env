# autumn — candidate palette, same derivation as cool.env:
# matplotlib's `autumn` colormap sampled at t = 0, .25, .5, .75, 1 and
# pastelised toward white at strength 0.68; the alert pair at 0.25. The dark
# neutrals carry the ramp's own hue so the palette reads as one family.
COOL_BG0=#281B0E
COOL_BG1=#3D2D1C
COOL_BG2=#533E2A
COOL_FG0=#FFF6ED
COOL_FG1=#FFD6AD
COOL_DIM=#FFC68C
COOL_DIMMER=#FFB973
COOL_0=#FFADAD
COOL_1=#FFC2AD
COOL_2=#FFD6AD
COOL_3=#FFEBAD
COOL_4=#FFFFAD
COOL_HOT_0=#FF4040
COOL_HOT_4=#FFFF40
COOL_MINT=#FFC2AD
COOL_BLUSH=#FFEBAD
COOL_ACCENT=#FFADAD
COOL_ACTIVE=#FF4040
COOL_URGENT=#FFFF40
COOL_WARN=#FFEBAD
COOL_GOOD=#FFC2AD
COOL_INACTIVE=#533E2A
