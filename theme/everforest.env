# everforest — Everforest dark, medium contrast, mapped onto Ergon's 22 roles.
#
# Upstream: https://github.com/sainnhe/everforest
# Licence:  MIT
#
# Everforest publishes one foreground and a graded set of backgrounds, so FG1
# is grey2 rather than a second full-strength foreground -- upstream simply does
# not define one, and inventing a value would put a colour in this file that
# does not exist in the scheme.

# -- neutrals ---------------------------------------------------------------
COOL_BG0=#2D353B          # bg0
COOL_BG1=#343F44          # bg1
COOL_BG2=#3D484D          # bg2
COOL_FG0=#D3C6AA          # fg
COOL_FG1=#9DA9A0          # grey2
COOL_DIM=#9DA9A0          # grey2
COOL_DIMMER=#859289       # grey1
# -- the ramp: blue -> aqua -> green -> yellow -> orange --------------------
COOL_0=#7FBBB3
COOL_1=#83C092
COOL_2=#A7C080
COOL_3=#DBBC7F
COOL_4=#E69875
# -- alert pair -------------------------------------------------------------
COOL_HOT_0=#7FBBB3
COOL_HOT_4=#E67E80        # red
# -- off-ramp tints ---------------------------------------------------------
COOL_MINT=#A7C080         # green
COOL_BLUSH=#D699B6        # purple
# -- semantic aliases -------------------------------------------------------
COOL_ACCENT=#83C092       # aqua
COOL_ACTIVE=#A7C080       # green, the colour Everforest is named for
COOL_URGENT=#E67E80       # red
COOL_WARN=#DBBC7F         # yellow
COOL_GOOD=#A7C080         # green
COOL_INACTIVE=#3D484D     # bg2
