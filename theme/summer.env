# summer — candidate palette, same derivation as cool.env:
# matplotlib's `summer` colormap sampled at t = 0, .25, .5, .75, 1 and
# pastelised toward white at strength 0.68; the alert pair at 0.25. The dark
# neutrals carry the ramp's own hue so the palette reads as one family.
COOL_BG0=#1B2118
COOL_BG1=#2D3529
COOL_BG2=#3E493A
COOL_FG0=#F6FBF4
COOL_FG1=#D6EBCE
COOL_DIM=#C6E2BA
COOL_DIMMER=#B9DCAB
COOL_0=#ADD6CE
COOL_1=#C2E0CE
COOL_2=#D6EBCE
COOL_3=#EBF5CE
COOL_4=#FFFFCE
COOL_HOT_0=#409F8C
COOL_HOT_4=#FFFF8C
COOL_MINT=#C2E0CE
COOL_BLUSH=#EBF5CE
COOL_ACCENT=#ADD6CE
COOL_ACTIVE=#409F8C
COOL_URGENT=#FFFF8C
COOL_WARN=#EBF5CE
COOL_GOOD=#C2E0CE
COOL_INACTIVE=#3E493A
