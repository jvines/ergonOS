# retro-82 — 1982 synthwave: navy, teal and orange (dark), from omarchy's retro-82 theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/retro-82/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.

COOL_BG0=#05182E
COOL_BG1=#0A2540
COOL_BG2=#134E5A
COOL_FG0=#F6DCAC
COOL_FG1=#F6DCAC
COOL_DIM=#A7C9C6
COOL_DIMMER=#3F8F8A
COOL_0=#8CBFB8
COOL_1=#3F8F8A
COOL_2=#3F8F8A
COOL_3=#E97B3C
COOL_4=#F85525
COOL_HOT_0=#8CBFB8
COOL_HOT_4=#F85525
COOL_MINT=#028391
COOL_BLUSH=#3F8F8A
COOL_ACCENT=#3F8F8A
COOL_ACTIVE=#FAA968
COOL_URGENT=#F85525
COOL_WARN=#E97B3C
COOL_GOOD=#028391
COOL_INACTIVE=#134E5A
