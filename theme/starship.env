# starship — graphite with amber (dark), from omarchy's starship theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/starship/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.

COOL_BG0=#1C1C1E
COOL_BG1=#2C2C2E
COOL_BG2=#3A3A3C
COOL_FG0=#FFFFFF
COOL_FG1=#F5F5F7
COOL_DIM=#FBFBFD
COOL_DIMMER=#98989D
COOL_0=#A6DCEF
COOL_1=#8FB8DE
COOL_2=#FF8FA3
COOL_3=#FFC27A
COOL_4=#FF5F4A
COOL_HOT_0=#CDEEFA
COOL_HOT_4=#FF8373
COOL_MINT=#FF9F0A
COOL_BLUSH=#FFB3C1
COOL_ACCENT=#8FB8DE
COOL_ACTIVE=#FF9F0A
COOL_URGENT=#FF5F4A
COOL_WARN=#FFC27A
COOL_GOOD=#FF9F0A
COOL_INACTIVE=#3A3A3C
