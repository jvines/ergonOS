# hackerman — green-on-navy terminal (dark), from omarchy's hackerman theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/hackerman/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.
# Every hue in this theme is a green or a blue, red and yellow included. That is the theme.

COOL_BG0=#0B0C16
COOL_BG1=#151828
COOL_BG2=#1F253A
COOL_FG0=#DDF7FF
COOL_FG1=#DDF7FF
COOL_DIM=#B5C5DB
COOL_DIMMER=#6A6E95
COOL_0=#7CF8F7
COOL_1=#829DD4
COOL_2=#86A7DF
COOL_3=#50F7D4
COOL_4=#50F872
COOL_HOT_0=#D1FFFE
COOL_HOT_4=#85FF9D
COOL_MINT=#4FE88F
COOL_BLUSH=#CDDBF4
COOL_ACCENT=#829DD4
COOL_ACTIVE=#82FB9C
COOL_URGENT=#50F872
COOL_WARN=#50F7D4
COOL_GOOD=#4FE88F
COOL_INACTIVE=#1F253A
