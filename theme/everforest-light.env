# everforest-light — Everforest light, medium contrast.
#
# Upstream: https://github.com/sainnhe/everforest
# Licence:  MIT
#
# Everforest publishes one foreground per ground, so FG1 is statusline2 rather
# than a second full-strength foreground -- upstream does not define one, and
# inventing a value would put a colour in this file the scheme does not have.

# -- neutrals ---------------------------------------------------------------
COOL_BG0=#FDF6E3          # bg0
COOL_BG1=#F4F0D9          # bg1
COOL_BG2=#E0DCC7          # bg4
COOL_FG0=#5C6A72          # fg
COOL_FG1=#708089          # statusline2
COOL_DIM=#829181          # grey2
COOL_DIMMER=#939F91       # grey1
# -- the ramp: blue -> aqua -> green -> yellow -> orange --------------------
COOL_0=#3A94C5
COOL_1=#35A77C
COOL_2=#8DA101
COOL_3=#DFA000
COOL_4=#F57D26
# -- alert pair -------------------------------------------------------------
COOL_HOT_0=#3A94C5
COOL_HOT_4=#F85552        # red
# -- off-ramp tints ---------------------------------------------------------
COOL_MINT=#8DA101         # green
COOL_BLUSH=#DF69BA        # purple
# -- semantic aliases -------------------------------------------------------
COOL_ACCENT=#35A77C       # aqua
COOL_ACTIVE=#8DA101       # green
COOL_URGENT=#F85552       # red
COOL_WARN=#DFA000         # yellow
COOL_GOOD=#8DA101         # green
COOL_INACTIVE=#E0DCC7     # bg4
