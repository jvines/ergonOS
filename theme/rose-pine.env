# rose-pine — Rosé Pine (main, dark), mapped onto Ergon's 22 roles.
#
# Upstream: https://github.com/rose-pine/rose-pine-theme
# Licence:  MIT, Copyright (c) 2023 Rosé Pine
#
# `main` is the original dark variant; the others are `moon` and `dawn`.
#
# Rosé Pine publishes NO green. GOOD is therefore foam, its blue-green, rather
# than a green borrowed from somewhere else -- a palette should not grow colours
# it does not have just to fill a role.

# -- neutrals ---------------------------------------------------------------
COOL_BG0=#191724          # base
COOL_BG1=#1F1D2E          # surface
COOL_BG2=#403D52          # highlightMed, the first shade that reads as a border
COOL_FG0=#E0DEF4          # text
COOL_FG1=#908CAA          # subtle
COOL_DIM=#908CAA          # subtle
COOL_DIMMER=#6E6A86       # muted
# -- the ramp: foam -> iris -> rose -> gold -> love -------------------------
# pine (#31748F) is deliberately NOT in the ramp: it is dark enough that on
# base it reads as a border rather than as an accent.
COOL_0=#9CCFD8
COOL_1=#C4A7E7
COOL_2=#EBBCBA
COOL_3=#F6C177
COOL_4=#EB6F92
# -- alert pair -------------------------------------------------------------
COOL_HOT_0=#9CCFD8
COOL_HOT_4=#EB6F92        # love
# -- off-ramp tints ---------------------------------------------------------
COOL_MINT=#9CCFD8         # foam
COOL_BLUSH=#EBBCBA        # rose
# -- semantic aliases -------------------------------------------------------
COOL_ACCENT=#9CCFD8       # foam
COOL_ACTIVE=#C4A7E7       # iris
COOL_URGENT=#EB6F92       # love
COOL_WARN=#F6C177         # gold
COOL_GOOD=#9CCFD8         # foam -- see the note above
COOL_INACTIVE=#403D52     # highlightMed
