# Text size, in points. The one number the bar, notifications, launcher,
# terminals and GTK are all sized from (ERGON-37).
#
# NOT a palette, though it lives beside them: bin/ergon-theme skips it when
# listing and stepping palettes, and refuses it by name. It is read with rules
# of its own -- TEXT_SIZE and nothing else, a whole number from 8 to 32 -- and
# anything else stops the render rather than reaching a template.
#
# This is the default. Yours is set with `ergon display text N`, which keeps it
# in ~/.local/state/ergon/type.env, so changing it never dirties the checkout.
TEXT_SIZE=11
