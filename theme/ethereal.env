# ethereal — a deep midnight blue with peach text (dark), from omarchy's ethereal theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/ethereal/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.

COOL_BG0=#060B1E
COOL_BG1=#131A3A
COOL_BG2=#252E56
COOL_FG0=#FFCEAD
COOL_FG1=#FFCEAD
COOL_DIM=#C9B8A6
COOL_DIMMER=#6D7DB6
COOL_0=#A3BFD1
COOL_1=#7D82D9
COOL_2=#C89DC1
COOL_3=#E9BB4F
COOL_4=#ED5B5A
COOL_HOT_0=#DFEAF0
COOL_HOT_4=#FAAAA9
COOL_MINT=#92A593
COOL_BLUSH=#EAD7E7
COOL_ACCENT=#7D82D9
COOL_ACTIVE=#7D82D9
COOL_URGENT=#ED5B5A
COOL_WARN=#E9BB4F
COOL_GOOD=#92A593
COOL_INACTIVE=#252E56
