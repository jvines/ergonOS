# The palette. Single source of truth for every themed surface on this machine.
#
# It is not a taste decision and it is not copied from anyone: it is the `cool`
# colormap — the same one every plot on this fleet uses — sampled evenly and
# pastelised toward white, exactly as cool_pastel() does in matplotlib:
#
#     cool(t)  = (255t, 255(1-t), 255)          cyan -> magenta
#     pastel   = c + (255 - c) * strength
#
# strength 0.68 is the documented look and reproduces glow/cool.json byte for
# byte (#ADFFFF / #D6D6FF / #FFADFF are t = 0, 0.5, 1). A second ramp at 0.25 is
# kept for surfaces that must read as an alert rather than as decoration.
#
# Nothing reads this file at runtime. bin/ergon-theme-render expands it into the
# committed configs, because a colour scheme rendered into $HOME at install time
# would fight install.sh's link().

# -- neutrals: the ground the ramp sits on ----------------------------------
COOL_BG0=#1A1A2E          # window/bar background
COOL_BG1=#2A2A3E          # raised surface: code blocks, input fields
COOL_BG2=#3A3A4E          # hover, inactive border
COOL_FG0=#EDEDF8          # primary text
COOL_FG1=#D6D6FF          # secondary text (also ramp midpoint, t=0.5)
COOL_DIM=#A6A6BC          # comments, disabled
COOL_DIMMER=#9494B0       # rules, separators

# -- the ramp, strength 0.68 (t = 0, .25, .5, .75, 1) -----------------------
COOL_0=#ADFFFF
COOL_1=#C2EBFF
COOL_2=#D6D6FF
COOL_3=#EBC2FF
COOL_4=#FFADFF

# -- the same ramp at strength 0.25, for alerts only ------------------------
COOL_HOT_0=#40FFFF
COOL_HOT_4=#FF40FF

# -- off-ramp tints inherited from glow/cool.json ---------------------------
COOL_MINT=#D0FFEA         # strings, "good" states
COOL_BLUSH=#FFE0FF        # numbers, inline code

# -- semantic aliases: what the configs actually reference ------------------
# Change these to re-point a role without touching the ramp.
COOL_ACCENT=#ADFFFF       # normal accent
COOL_ACTIVE=#40FFFF       # focused window, active workspace
COOL_URGENT=#FF40FF       # critical battery, urgent notification
COOL_WARN=#EBC2FF
COOL_GOOD=#D0FFEA
COOL_INACTIVE=#3A3A4E
