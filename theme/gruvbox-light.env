# gruvbox-light — Gruvbox light, medium contrast.
#
# Upstream: https://github.com/morhetz/gruvbox
# Licence:  MIT/X11, DECLARED ONLY. The repository ships no LICENSE file; the
#           claim appears in README.md and package.json and GitHub's licence
#           API returns 404 for it. See theme/LICENSES.md.
#
# Note how much darker the accents are than gruvbox's dark ones: #9D0006 rather
# than #FB4934 for red. Upstream publishes a separate set for each ground, and
# using the dark variant's accents on a light background is the usual way these
# ports come out unreadable.

# -- neutrals ---------------------------------------------------------------
COOL_BG0=#FBF1C7          # bg0
COOL_BG1=#EBDBB2          # bg1
COOL_BG2=#D5C4A1          # bg2
COOL_FG0=#3C3836          # fg1
COOL_FG1=#504945          # fg2
COOL_DIM=#665C54          # fg3
COOL_DIMMER=#928374       # gray
# -- the ramp: blue -> aqua -> green -> yellow -> orange --------------------
COOL_0=#076678
COOL_1=#427B58
COOL_2=#79740E
COOL_3=#B57614
COOL_4=#AF3A03
# -- alert pair -------------------------------------------------------------
COOL_HOT_0=#076678
COOL_HOT_4=#9D0006        # red
# -- off-ramp tints ---------------------------------------------------------
COOL_MINT=#427B58         # aqua
COOL_BLUSH=#8F3F71        # purple
# -- semantic aliases -------------------------------------------------------
COOL_ACCENT=#427B58       # aqua
COOL_ACTIVE=#B57614       # yellow
COOL_URGENT=#9D0006       # red
COOL_WARN=#AF3A03         # orange
COOL_GOOD=#79740E         # green
COOL_INACTIVE=#D5C4A1     # bg2
