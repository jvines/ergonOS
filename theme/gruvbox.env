# gruvbox — Gruvbox dark, medium contrast, mapped onto Ergon's 22 roles.
#
# Upstream: https://github.com/morhetz/gruvbox
# Licence:  MIT/X11. The repository declares this in README.md and package.json
#           and ships NO LICENSE file; see theme/LICENSES.md.
#
# Medium is upstream's own default (g:gruvbox_contrast_dark = 'medium'), so bg0
# is dark0 rather than dark0_hard. Gruvbox is a warm palette and the ramp runs
# cool-to-warm across it, which is the direction its accents actually span.

# -- neutrals ---------------------------------------------------------------
COOL_BG0=#282828          # dark0
COOL_BG1=#3C3836          # dark1
COOL_BG2=#504945          # dark2
COOL_FG0=#EBDBB2          # light1
COOL_FG1=#D5C4A1          # light2
COOL_DIM=#A89984          # light4
COOL_DIMMER=#928374       # gray
# -- the ramp: blue -> aqua -> green -> yellow -> orange --------------------
COOL_0=#83A598
COOL_1=#8EC07C
COOL_2=#B8BB26
COOL_3=#FABD2F
COOL_4=#FE8019
# -- alert pair -------------------------------------------------------------
COOL_HOT_0=#83A598
COOL_HOT_4=#FB4934        # bright_red
# -- off-ramp tints ---------------------------------------------------------
COOL_MINT=#8EC07C         # bright_aqua
COOL_BLUSH=#D3869B        # bright_purple
# -- semantic aliases -------------------------------------------------------
# ACTIVE is yellow rather than orange: orange sits next to bright_red, and the
# focused window must not be confusable with an urgent one.
COOL_ACCENT=#8EC07C       # bright_aqua
COOL_ACTIVE=#FABD2F       # bright_yellow
COOL_URGENT=#FB4934       # bright_red
COOL_WARN=#FE8019         # bright_orange
COOL_GOOD=#B8BB26         # bright_green
COOL_INACTIVE=#504945     # dark2
