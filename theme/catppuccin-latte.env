# catppuccin-latte — Catppuccin Latte, the LIGHT flavour.
#
# Upstream: https://github.com/catppuccin/palette (palette.json v1.8.0)
# Licence:  MIT, Copyright (c) 2021 Catppuccin
#
# Light/dark is not declared here: ergon-theme derives it from the luminance of
# COOL_BG0, so a light background is what makes this a light desktop.
#
# The accents are Latte's own, which are DARK -- #1E66F5 rather than Mocha's
# #89B4FA. That is the whole difference between a light theme and a dark theme
# with the background inverted: the accents have to carry contrast against a
# light ground, not against a dark one.

# -- neutrals: lightest ground, darker surfaces -----------------------------
COOL_BG0=#EFF1F5          # base
COOL_BG1=#E6E9EF          # mantle
COOL_BG2=#BCC0CC          # surface1
COOL_FG0=#4C4F69          # text
COOL_FG1=#5C5F77          # subtext1
COOL_DIM=#6C6F85          # subtext0
COOL_DIMMER=#8C8FA1       # overlay1
# -- the ramp: teal -> sapphire -> blue -> mauve -> pink --------------------
COOL_0=#179299
COOL_1=#209FB5
COOL_2=#1E66F5
COOL_3=#8839EF
COOL_4=#EA76CB
# -- alert pair -------------------------------------------------------------
COOL_HOT_0=#04A5E5        # sky
COOL_HOT_4=#D20F39        # red
# -- off-ramp tints ---------------------------------------------------------
COOL_MINT=#40A02B         # green
COOL_BLUSH=#DC8A78        # rosewater
# -- semantic aliases -------------------------------------------------------
COOL_ACCENT=#1E66F5       # blue
COOL_ACTIVE=#8839EF       # mauve
COOL_URGENT=#D20F39       # red
COOL_WARN=#DF8E1D         # yellow
COOL_GOOD=#40A02B         # green
COOL_INACTIVE=#BCC0CC     # surface1
