# lupine — clean light grey with blue and violet (light), from omarchy's lupine theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/lupine/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.

COOL_BG0=#FAFAFA
COOL_BG1=#ECECEC
COOL_BG2=#D0D0D0
COOL_FG0=#000000
COOL_FG1=#212121
COOL_DIM=#424242
COOL_DIMMER=#757575
COOL_0=#0C67DE
COOL_1=#3264EB
COOL_2=#8A4AD7
COOL_3=#026FDE
COOL_4=#C900C4
COOL_HOT_0=#3986FF
COOL_HOT_4=#F930FB
COOL_MINT=#4A2FD0
COOL_BLUSH=#B363FF
COOL_ACCENT=#3264EB
COOL_ACTIVE=#3264EB
COOL_URGENT=#C900C4
COOL_WARN=#026FDE
COOL_GOOD=#4A2FD0
COOL_INACTIVE=#D0D0D0
