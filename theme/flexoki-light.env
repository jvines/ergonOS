# flexoki-light — Flexoki light, warm paper (light), from omarchy's flexoki-light theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/flexoki-light/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.

COOL_BG0=#FFFCF0
COOL_BG1=#F2EFE4
COOL_BG2=#CECDC3
COOL_FG0=#100F0F
COOL_FG1=#100F0F
COOL_DIM=#403E3C
COOL_DIMMER=#878580
COOL_0=#3AA99F
COOL_1=#205EA6
COOL_2=#CE5D97
COOL_3=#D0A215
COOL_4=#D14D41
COOL_HOT_0=#3AA99F
COOL_HOT_4=#D14D41
COOL_MINT=#879A39
COOL_BLUSH=#CE5D97
COOL_ACCENT=#205EA6
COOL_ACTIVE=#205EA6
COOL_URGENT=#D14D41
COOL_WARN=#D0A215
COOL_GOOD=#879A39
COOL_INACTIVE=#CECDC3
