# matte-black — matte black with amber (dark), from omarchy's matte-black theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/matte-black/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.
# WARN is the theme's amber (its 'green'); its 'yellow' is a red.

COOL_BG0=#121212
COOL_BG1=#1E1E1E
COOL_BG2=#2A2A2A
COOL_FG0=#BEBEBE
COOL_FG1=#BEBEBE
COOL_DIM=#8A8A8D
COOL_DIMMER=#555555
COOL_0=#BEBEBE
COOL_1=#E68E0D
COOL_2=#D35F5F
COOL_3=#B91C1C
COOL_4=#D35F5F
COOL_HOT_0=#EAEAEA
COOL_HOT_4=#B91C1C
COOL_MINT=#FFC107
COOL_BLUSH=#B91C1C
COOL_ACCENT=#E68E0D
COOL_ACTIVE=#E68E0D
COOL_URGENT=#D35F5F
COOL_WARN=#FFC107
COOL_GOOD=#FFC107
COOL_INACTIVE=#2A2A2A
