# miasma — muted olive and ochre on charcoal (dark), from omarchy's miasma theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/miasma/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.
# URGENT is the theme's burnt orange: its red (#685742) is brown at 2.3:1.

COOL_BG0=#222222
COOL_BG1=#2C2C2C
COOL_BG2=#383838
COOL_FG0=#C2C2B0
COOL_FG1=#C2C2B0
COOL_DIM=#8A8A7E
COOL_DIMMER=#555555
COOL_0=#C9A554
COOL_1=#78824B
COOL_2=#BB7744
COOL_3=#B36D43
COOL_4=#685742
COOL_HOT_0=#C9A554
COOL_HOT_4=#685742
COOL_MINT=#5F875F
COOL_BLUSH=#BB7744
COOL_ACCENT=#78824B
COOL_ACTIVE=#78824B
COOL_URGENT=#B36D43
COOL_WARN=#B36D43
COOL_GOOD=#5F875F
COOL_INACTIVE=#383838
