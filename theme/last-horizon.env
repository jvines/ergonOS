# last-horizon — near-black with dusty rose and slate (dark), from omarchy's last-horizon theme.
#
# Upstream: https://github.com/basecamp/omarchy  themes/last-horizon/colors.toml  (df3d01c)
# Licence:  MIT, Copyright (c) David Heinemeier Hansson
#
# Colours only; omarchy's wallpapers and images are not used. The mapping onto
# Ergon's 22 roles is ours, the same for every omarchy palette: BG0 background,
# BG1/BG2 the raised surfaces (lighter_background and selection; the darker
# step for a light ground), FG0 bright_foreground, FG1 foreground, DIM
# light_foreground, DIMMER dark_foreground, the ramp cyan/blue/magenta/yellow/
# red, HOT_* and BLUSH their bright_ forms, ACCENT blue, ACTIVE omarchy's accent.
# This theme's lighter_background equals its background, so BG1 is dark_background.

COOL_BG0=#0C0B0C
COOL_BG1=#090809
COOL_BG2=#584E51
COOL_FG0=#FAFCFB
COOL_FG1=#E2DDDC
COOL_DIM=#CFD3CD
COOL_DIMMER=#584E51
COOL_0=#A5A0B6
COOL_1=#B59790
COOL_2=#C4D8E2
COOL_3=#6B5E73
COOL_4=#C38B7B
COOL_HOT_0=#A5A0B6
COOL_HOT_4=#C38B7B
COOL_MINT=#87A9B0
COOL_BLUSH=#C4D8E2
COOL_ACCENT=#B59790
COOL_ACTIVE=#B59790
COOL_URGENT=#C38B7B
COOL_WARN=#6B5E73
COOL_GOOD=#87A9B0
COOL_INACTIVE=#584E51
