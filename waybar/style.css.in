/* GENERATED from waybar/style.css.in — edit the .in, then run: ergon theme
 *
 * The bar is flat and unblurred on purpose: blur on a laptop bar is a constant
 * GPU cost for a surface you look at for half a second at a time, and the panel
 * is the one thing on screen that never gets composited away.
 */

* {
  font-family: "JetBrainsMono Nerd Font", "Font Awesome 7 Free", monospace;
  font-size: 13px;
  min-height: 0;
  border: none;
  border-radius: 0;
}

window#waybar {
  background: @COOL_BG0@;
  color: @COOL_FG0@;
  border-bottom: 1px solid @COOL_BG2@;
}

/* Hyprland is told not to render a border on fullscreen windows, so the bar
 * hiding is what signals fullscreen. Keep the transition cheap. */
window#waybar.hidden { opacity: 0.0; }

/* -- workspaces ---------------------------------------------------------- */
#workspaces { margin-left: 4px; }

#workspaces button {
  padding: 0 9px;
  color: @COOL_DIM@;
  background: transparent;
  border-bottom: 2px solid transparent;
}

/* Empty workspaces were @COOL_BG2@ (#3A3A4E) on @COOL_BG0@ (#1A1A2E) -- two
 * near-identical darks, so 2-9 were invisible rather than quiet. Same hue as
 * an occupied-but-inactive workspace, dropped in opacity instead: still
 * obviously secondary, still readable.
 *
 * 0.42 was still not readable. "Quiet" and "illegible" are not the same
 * setting, and the workspace numbers are the one part of the bar you navigate
 * by -- a number you have to lean in to read is a broken indicator, not a
 * subtle one. 0.78 over the darkest palette ground keeps them clearly
 * secondary to the active workspace, which carries both a brighter colour and
 * an underline, while staying legible at a glance. */
#workspaces button.empty {
  color: @COOL_DIM@;
  opacity: 0.78;
}

#workspaces button:hover {
  color: @COOL_FG0@;
  background: @COOL_BG1@;
}

#workspaces button.active {
  color: @COOL_ACTIVE@;
  border-bottom: 2px solid @COOL_ACTIVE@;
}

/* Urgent uses the 0.25 ramp, not the 0.68 one. A pastel alert is not an alert. */
#workspaces button.urgent {
  color: @COOL_BG0@;
  background: @COOL_URGENT@;
}

#submap {
  color: @COOL_BG0@;
  background: @COOL_3@;
  padding: 0 10px;
}

/* -- window title -------------------------------------------------------- */
#window {
  color: @COOL_FG1@;
  padding: 0 10px;
}

window#waybar.empty #window { background: transparent; }

/* -- right-hand group ---------------------------------------------------- */
#custom-palette,
#custom-temperature,
#cpu, #memory, #wireplumber, #backlight,
#network, #bluetooth, #battery, #power-profiles-daemon,
#clock, #tray, #custom-session {
  padding: 0 8px;
  color: @COOL_FG0@;
}

/* Eight modules in a row with uniform padding read as one undifferentiated
 * string -- "-- 0% 1G 100% 0% 10.0.2.15" takes a moment to parse into fields.
 * A hairline before each GROUP (load, audio, radios, power, time) gives the eye
 * somewhere to break, without the noise of a divider between every module. */
#wireplumber,
#network,
#battery,
#clock {
  border-left: 1px solid @COOL_BG2@;
  margin-left: 2px;
  padding-left: 10px;
}

/* The palette name, in the palette's own accent -- so the module demonstrates
 * the thing it names. Its own group: it is a setting, not a reading, and it
 * does not belong in the load trio. */
#custom-palette { color: @COOL_ACTIVE@; }

/* The load trio reads as one unit, tinted along the ramp so you can tell them
 * apart at a glance without labels. */
#custom-temperature { color: @COOL_0@; }
#cpu                { color: @COOL_1@; }
#memory             { color: @COOL_2@; }

#wireplumber { color: @COOL_3@; }
#backlight   { color: @COOL_3@; }
#network     { color: @COOL_4@; }
#bluetooth   { color: @COOL_4@; }

#wireplumber.muted,
#network.disconnected,
#bluetooth.disabled,
#bluetooth.off { color: @COOL_DIMMER@; }

#battery { color: @COOL_GOOD@; }
#battery.charging, #battery.plugged { color: @COOL_MINT@; }
#battery.warning:not(.charging) { color: @COOL_WARN@; }

/* Critical blinks. Everything else on this bar is static, so motion here is
 * unambiguous — it is the only thing that ever moves. */
#battery.critical:not(.charging) {
  color: @COOL_BG0@;
  background: @COOL_URGENT@;
  animation: blink 1s steps(2, start) infinite;
}

@keyframes blink { to { background: @COOL_BG0@; color: @COOL_URGENT@; } }

#power-profiles-daemon.performance  { color: @COOL_URGENT@; }
#power-profiles-daemon.balanced     { color: @COOL_FG1@; }
#power-profiles-daemon.power-saver  { color: @COOL_GOOD@; }

#custom-temperature.hot {
  color: @COOL_BG0@;
  background: @COOL_URGENT@;
}

/* No background slab. Every other module is flat on the bar, so a filled panel
 * behind the clock reads as an inconsistency rather than as emphasis. The time
 * is already the rightmost thing and the only wide field; it does not need
 * help being found. */
#clock {
  color: @COOL_FG0@;
  padding-right: 12px;
}

#tray { padding-right: 10px; }
#tray > .passive { -gtk-icon-effect: dim; }
#tray > .needs-attention { -gtk-icon-effect: highlight; }

/* Quiet until touched -- this is the exit for the whole session, not a
 * reading, and it does not need to compete with the load trio for attention.
 * The hover colour is the same one battery.critical blinks with: the one
 * warm accent on an otherwise cool bar, here meaning "this click matters". */
#custom-session {
  color: @COOL_DIM@;
  padding-left: 4px;
  padding-right: 12px;
}
#custom-session:hover { color: @COOL_URGENT@; }

tooltip {
  background: @COOL_BG1@;
  border: 1px solid @COOL_BG2@;
  border-radius: 4px;
}
tooltip label { color: @COOL_FG0@; padding: 4px; }

/* Your overrides, from a file this repo never renders over.
 *
 * LAST in the file on purpose. GTK3 splices an imported stylesheet into the
 * cascade exactly where the @import sits, and ties break on source order -- so
 * at the top the rules above would beat yours and this would silently do
 * nothing. Measured, not assumed.
 *
 * Relative, and not ~ or an absolute path: ~ is never expanded (GTK looks for a
 * directory literally named "~"), and the renderer has no $HOME to bake in.
 * GTK resolves the path lexically against the file it was ASKED for, not the
 * symlink's target, so from ~/.config/waybar/style.css this lands on
 * ~/.config/ergon/waybar.css even though ~/.config/waybar is a link into the
 * repo. Verified against GTK3 for both link shapes this repo uses.
 *
 * If that file is missing, waybar does not lose the override -- it loses the
 * BAR. GTK discards the whole stylesheet on a failed import, including
 * everything above this line. lib/user-config.sh is what guarantees it exists.
 */
@import url("../ergon/waybar.css");
