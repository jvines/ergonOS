// Bar. One line of status, not a control panel — anything that needs more than
// a glance lives in a TUI that is one keystroke away.
//
// Module choice is for THIS machine's job: a cluster frontend that runs long
// MCMC locally. cpu / memory / temperature are first-class and sit leftmost in
// the right group, because a sampler quietly thermal-throttling or a chain
// eating 90 GB is the failure you actually need to see. Everything else is
// laptop housekeeping.
//
// Colours are not here: style.css is generated from theme/cool.env.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "modules-left":   ["custom/menu", "hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right":  [
    "custom/status", "custom/layout",
    "custom/temperature", "cpu", "memory",
    "wireplumber", "backlight",
    "network", "bluetooth", "battery", "power-profiles-daemon",
    "clock", "tray", "custom/session"
  ],

  // The tree that reaches System, Style (palettes, backgrounds), Commands
  // and Help (bin/ergon-menu, ERGON-31; SUPER+ALT+SPACE, hypr/common/binds.lua).
  // Leftmost, because that is the one spot modules-left had nothing in --
  // workspaces and the submap -- and because a keybind is not reachable from
  // every seat (see custom/session). With the palette label gone (ERGON-80),
  // this is also the only way to pick a palette with the pointer alone.
  "custom/menu": {
    "format": "󰍜",
    "tooltip": true,
    "tooltip-format": "Menu — system, style, commands, help",
    "on-click": "ergon-menu"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    // Persistent 1-9 so the bar has a fixed geometry; a workspace that does not
    // exist yet is still a target you can click or jump to.
    "persistent-workspaces": { "*": 9 }
  },

  "hyprland/submap": {
    "format": "󰌆 {}",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 90,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹  $1",
      "(.*) - Discord": "󰙯  $1",
      "^(.*)\\s*$": "$1"
    }
  },

  // The modes this session is in, and only while each is on (ERGON-32): a
  // recording, do-not-disturb, a night-light tint, `ergon watch` runs, pending
  // updates or unread news. Each one fails silently when forgotten, which is
  // the case for drawing it. Empty text when none is on, so the module hides.
  // A click stops a recording, else ends do-not-disturb. See bin/ergon-status.
  //
  // Signalled, not polled (ERGON-81): whatever changes a mode runs
  // `ergon-status --poke`, which sends SIGRTMIN+8, and waybar re-runs this at
  // once. It polled every 3 s, two processes a second all session. The 60 s
  // interval is only the backstop, for a change made behind ergonOS's back.
  "custom/status": {
    "exec": "ergon-status --waybar",
    "return-type": "json",
    "interval": 60,
    "signal": 8,
    "format": "{}",
    "on-click": "ergon-status --click",
    "tooltip": true
  },

  // The active keyboard layout, only on a host that lists more than one in
  // kb_layout (ERGON-85): empty text hides the module otherwise. Signalled by
  // `ergon-layout`, which the key runs; the interval is the backstop.
  "custom/layout": {
    "exec": "ergon-layout --waybar",
    "return-type": "json",
    "interval": 60,
    "signal": 9,
    "format": "{}",
    "on-click": "ergon-layout",
    "tooltip": true
  },

  // k10temp's hwmon number is not stable across boots, so this is a script that
  // finds it rather than a hardcoded /sys path. See bin/ergon-temp.
  //
  // Every custom module calls the hyphenated binary (ergon-temp, ergon-session),
  // never the `ergon` dispatcher: that resolves only through the login shell's
  // PATH, which waybar and Hyprland's exec do not have. The palette label that
  // sat here until ERGON-80, called as `ergon theme --current`, printed "cool"
  // forever because its fallback fired on every poll.
  "custom/temperature": {
    "exec": "ergon-temp",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "on-click": "ergon-launch-tui btop"
  },

  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}%",
    "on-click": "ergon-launch-tui btop"
  },

  // Used GiB, not a percentage. On 96 GB a percentage hides the number that
  // matters — "71G" tells you whether the next chain fits, "74%" does not.
  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.0f}G",
    "tooltip-format": "{used:0.1f} GiB of {total:0.1f} GiB   swap {swapUsed:0.1f}G",
    "on-click": "ergon-launch-tui btop"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "ergon-launch-tui wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "ergon-audio-output",
    "scroll-step": 5
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip": false
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}\n{bandwidthDownBits} down  {bandwidthUpBits} up",
    "on-click": "ergon-launch-tui nmtui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },

  "battery": {
    "interval": 30,
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"],
    "tooltip-format": "{timeTo}   {power:0.1f} W"
  },

  // Blocked from touching amdgpu panel power — see
  // hardware/framework-13-amd/. Left
  // clickable so you can drop to power-saver before a flight without a TUI.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "{profile}",
    // Explicit. waybar's ppd module is documented to cycle on click and
    // depending on the build does not, which presents as a button drawing the
    // right icon and doing nothing at all -- reported from a real session while
    // the daemon was running correctly the whole time.
    //
    // ergon-power cycles by what the machine ACTUALLY offers: three profiles on
    // a laptop with platform_profile, two in a VM without one. A hardcoded
    // order breaks on whichever machine lacks the profile it assumes.
    "on-click": "ergon-power cycle",
    "on-click-right": "ergon-power balanced",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },

  // UTC on hover: every timestamp the fleet writes is UTC, and doing the
  // arithmetic in your head at 2am is how you misread a log.
  //
  // The comment above was a promise the tooltip did not keep: it showed only the
  // calendar (ERGON-32). "timezones" lists local first, so the bar itself is
  // unchanged, and {tz_list} prints every zone in the list under it.
  "clock": {
    "interval": 30,
    "format": "{:%a %d %b  %H:%M}",
    "timezones": ["", "Etc/UTC"],
    "tooltip-format": "<tt>{calendar}</tt>\n\n<tt>{tz_list}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<b><u>{}</u></b>" }
    },
    "actions": { "on-click-right": "mode" }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // Lock, suspend, hibernate, logout, reboot, shutdown -- see bin/ergon-session
  // and hypr/common/binds.lua (SUPER+SHIFT+E, XF86PowerOff). Clickable because a
  // keybind is not reachable from every seat: a remote client that drops SUPER
  // leaves the desktop unreachable from the keyboard while the pointer still
  // works, found the hard way over VNC. This is the one action that must still
  // be reachable then.
  "custom/session": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Session menu — lock, suspend, hibernate, logout, reboot, shutdown",
    "on-click": "ergon-session"
  }
}
