-- GENERATED from looknfeel.lua.in — edit the .in, then run: ergon theme
--
-- Appearance and input.
--
-- Every setting goes through hl.config(). There are no per-section functions:
-- hl.general{}, hl.decoration{}, hl.input{}, hl.misc{} and hl.animations{} do
-- not exist in the Lua API and a config calling them dies at load. Multiple
-- hl.config() calls are fine — each one merges into what came before, which is
-- why this file can be split into readable blocks.

-- The active border is the cool ramp itself: cyan at one corner, magenta at the
-- other, the same two endpoints as every colorbar this machine draws.
local active_border = {
  colors = { "rgba(@COOL_HOT_0:raw@ee)", "rgba(@COOL_HOT_4:raw@ee)" },
  angle = 45,
}
local inactive_border = "rgba(@COOL_INACTIVE:raw@aa)"

hl.config({
  general = {
    gaps_in = 4,
    gaps_out = 8,
    border_size = 2,
    layout = "dwindle",
    resize_on_border = true,
    allow_tearing = false,
    col = {
      active_border = active_border,
      inactive_border = inactive_border,
    },
  },

  decoration = {
    rounding = 4,
    -- Both off: they cost battery continuously and buy nothing on a screen that
    -- is text in a terminal ~95% of the time.
    blur = { enabled = false },
    shadow = { enabled = false },
    -- Slight transparency on unfocused windows only. Enough to see which window
    -- has the keyboard without reading the border.
    active_opacity = 1.0,
    inactive_opacity = 0.96,
  },

  group = {
    col = {
      border_active = active_border,
      border_inactive = inactive_border,
    },
    groupbar = {
      font_family = "@FONT_MONO@",
      font_size = 11,
      height = 18,
      indicator_height = 2,
      text_color = "rgb(@COOL_FG0:raw@)",
      col = {
        active = "rgb(@COOL_BG1:raw@)",
        inactive = "rgb(@COOL_BG0:raw@)",
      },
    },
  },

  dwindle = {
    preserve_split = true,
    -- Split along the longer edge. On a 2880x1920 3:2 panel the default
    -- always-vertical split gives you two tall slivers for side-by-side code.
    smart_split = false,
    force_split = 2,
  },

  input = {
    -- kb_layout is NOT set here: it is per machine, scaffolded into
    -- hosts/<host>/hyprland.lua from the keymap chosen at install.
    -- Hardcoding "us" gave every non-US user the wrong layout, and
    -- unlike a wrong locale you discover it by typing your password wrong.
    follow_mouse = 1,
    -- Focus follows the mouse but does NOT raise or warp. Passing the pointer
    -- over a window while reading should never reorder anything.
    mouse_refocus = false,
    touchpad = {
      natural_scroll = true,
      disable_while_typing = true,
      clickfinger_behavior = true,
      scroll_factor = 0.4,
    },
  },

  cursor = {
    -- The laptop is s2idle-only; anything that keeps the GPU awake matters.
    no_hardware_cursors = false,
    inactive_timeout = 5,
  },

  -- XWayland clients draw at the monitor's pixel size instead of being
  -- upscaled from 1x, which is what made them blurry at a fractional scale
  -- (ERGON-134). The cost is that they are then drawn small: GDK_SCALE (ergon
  -- display xscale) sizes GTK ones, and Tk, Java and Qt have their own knobs.
  -- Name checked against Hyprland 0.56: --verify-config rejects an unknown
  -- xwayland key as "unknown config key".
  xwayland = { force_zero_scaling = true },

  misc = {
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
    -- 0 = never lower the refresh rate on battery. VRR already handles idle,
    -- and a forced drop makes scrolling code feel broken.
    vrr = 1,
    focus_on_activate = true,
    background_color = "rgb(@COOL_BG0:raw@)",
  },

  -- Hyprland's own "Hyprland updated to 0.56.2" window opened over the
  -- desktop on the first session after provisioning (VM, ERGON-73). Updates
  -- here come through `ergon update`, which says what changed; a second
  -- announcement from the compositor is noise, and so is the donation nag.
  -- Both names checked against the 0.56.2 binary.
  ecosystem = {
    no_update_news = true,
    no_donation_nag = true,
  },

  animations = {
    enabled = true,
  },

  -- VFR is the single biggest idle-power win on a laptop, and it lives under
  -- `debug`, not `misc`, in current Hyprland -- misc:vfr no longer exists and is
  -- rejected as an unknown key. It defaults to on; set explicitly so a future
  -- default change does not quietly cost battery.
  debug = {
    vfr = true,
  },
})

-- ---------------------------------------------------------------------------
-- Motion (ERGON-42).
--
-- `enabled = true` alone meant Hyprland's BUILT-IN curves, which nobody chose:
-- every leaf on one "default" bezier at speed 8, and a horizontal slide on
-- every workspace switch. These are Omarchy's numbers (default/hypr/
-- looknfeel.lua on its quattro branch, read 2026-10-14), which are in turn the
-- curves Hyprland's own example config ships, with two leaves switched off.
-- Speeds are in deciseconds: 4.1 is a 410 ms pop-in.
--
-- Not hl.animations{}: that does not exist (see the header). The two calls
-- below are their own functions, and a curve has to be declared before an
-- animation names it.
--
-- Omarchy also declares easeInOutCubic and then uses it nowhere, as does
-- Hyprland's example config. It is left out rather than carried as a name
-- that nothing reads.
hl.curve("easeOutQuint", { type = "bezier", points = { { 0.23, 1 }, { 0.32, 1 } } })
hl.curve("linear", { type = "bezier", points = { { 0, 0 }, { 1, 1 } } })
hl.curve("almostLinear", { type = "bezier", points = { { 0.5, 0.5 }, { 0.75, 1.0 } } })
hl.curve("quick", { type = "bezier", points = { { 0.15, 0 }, { 0.1, 1 } } })

hl.animation({ leaf = "global", enabled = true, speed = 10, bezier = "default" })
hl.animation({ leaf = "border", enabled = true, speed = 5.39, bezier = "easeOutQuint" })
hl.animation({ leaf = "windows", enabled = true, speed = 3.79, bezier = "easeOutQuint" })
-- A new window grows from 87% of its size rather than from a point: enough
-- motion to see where it landed, not enough to read as a zoom.
hl.animation({ leaf = "windowsIn", enabled = true, speed = 4.1, bezier = "easeOutQuint", style = "popin 87%" })
-- Closing is faster than opening and linear: a window you dismissed should be
-- gone, not perform its exit.
hl.animation({ leaf = "windowsOut", enabled = true, speed = 1.49, bezier = "linear", style = "popin 87%" })
hl.animation({ leaf = "fadeIn", enabled = true, speed = 1.73, bezier = "almostLinear" })
hl.animation({ leaf = "fadeOut", enabled = true, speed = 1.46, bezier = "almostLinear" })
-- `fade` also carries the 0.96 inactive_opacity above, so focus moving
-- between windows dims one and lifts the other on this curve.
hl.animation({ leaf = "fade", enabled = true, speed = 3.03, bezier = "quick" })
-- Layers: mako, the OSD and the bar fade rather than slide. The launcher is
-- exempt -- hypr/common/windows.lua gives its namespace no_anim, because a
-- fade on something you summon and type into at once reads as lag.
hl.animation({ leaf = "layers", enabled = true, speed = 3.81, bezier = "easeOutQuint" })
hl.animation({ leaf = "layersIn", enabled = true, speed = 4, bezier = "easeOutQuint", style = "fade" })
hl.animation({ leaf = "layersOut", enabled = true, speed = 1.5, bezier = "linear", style = "fade" })
hl.animation({ leaf = "fadeLayersIn", enabled = true, speed = 1.79, bezier = "almostLinear" })
hl.animation({ leaf = "fadeLayersOut", enabled = true, speed = 1.39, bezier = "almostLinear" })
-- OFF, both. A workspace switch is the most frequent motion on this desktop
-- -- a keypress, many times an hour -- and a slide makes every one of them
-- wait for it. fadeSwitch is the dim-and-lift across a switch, the same
-- argument. The 3-finger swipe below still follows the fingers while they
-- move; with the leaf off, only the snap after release is instant.
hl.animation({ leaf = "workspaces", enabled = false })
hl.animation({ leaf = "fadeSwitch", enabled = false })

-- Native since 0.51. hyprgrass is not a package (only hyprgrass-git, which
-- depends on hyprland-git and would replace the official build).
hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })

-- More gestures (ERGON-137), each under pcall so an action this Hyprland does not
-- know costs that one gesture and never the config. 4 fingers: drag the window,
-- swipe down for fullscreen, up to float it. Native actions from the gestures
-- docs (move, fullscreen, float); 3 fingers stay on workspaces.
for _, g in ipairs({
  { fingers = 4, direction = "horizontal", action = "move" },
  { fingers = 4, direction = "down",       action = "fullscreen" },
  { fingers = 4, direction = "up",         action = "float" },
}) do
  pcall(hl.gesture, g)
end
