[Unit]
Description=Say on the desktop what systemd-oomd killed
# A follower that keeps dying is reported, not retried forever: five failures in
# five minutes leave it failed, which is what ergon doctor's oom-notify row reads.
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
ExecStart=%h/ergonOS/bin/ergon-oom-notify
Restart=on-failure
RestartSec=5s
# session.slice, not the default app.slice. app.slice is where oomd acts, and the
# one process that has to outlive a kill in order to report it must never be a
# candidate for that kill.
Slice=session.slice
# Belt and braces: GDBus falls back to $XDG_RUNTIME_DIR/bus without it (glib
# 2.88, measured), but the manager carries this only when something imported it,
# and the VM harness measured one that had not.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=default.target
