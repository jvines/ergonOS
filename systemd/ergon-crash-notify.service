[Unit]
Description=Say on the desktop which of your programs crashed
# A follower that keeps dying is reported, not retried forever: five failures in
# five minutes leave it failed, which is what ergon doctor's crash-notify row reads.
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
ExecStart=%h/ergonOS/bin/ergon-crash-notify
Restart=on-failure
RestartSec=5s
# session.slice, not the default app.slice, so that a memory kill in app.slice (see
# ergon-oom-notify.service) cannot take the reporter along with the crash it reports.
Slice=session.slice
# Belt and braces: GDBus falls back to $XDG_RUNTIME_DIR/bus without it (glib
# 2.88, measured), but the manager carries this only when something imported it,
# and the VM harness measured one that had not.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus

[Install]
WantedBy=default.target
