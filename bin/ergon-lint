#!/usr/bin/env bash
# ergon:summary=Check the repo's shell scripts for heredoc expansion hazards
# ergon:group=dev
# ergon:args=
#
# Heredocs are a blind spot: shellcheck does not look inside them, so an
# UNQUOTED heredoc is a place where ordinary-looking prose becomes code. A
# comment line beginning with the tool's own name is read as a directive, which
# is why this sentence does not. Two real bugs shipped from that blind spot
# in this repo:
#
#   arch-bootstrap.sh   a comment reading  no `resume' hook  -- one backtick,
#                       read as an unterminated command substitution. Killed
#                       every install at the chroot stage, AFTER partitioning
#                       and pacstrapping 150 packages.
#   test-arch-vm.sh     a comment containing a backtick PAIR, which bash happily
#                       executed, and Tcl variables ($timeout) eaten by the
#                       shell before expect ever saw them.
#
# Both are invisible in review and neither fails at parse time. This finds them.
set -euo pipefail

# readlink -f: this is reached through /usr/local/bin/<name>, which is a symlink
# into the repo. Without resolving it, BASH_SOURCE is the symlink's own path and
# the root comes out as /usr/local -- so every repo-relative file is looked for
# somewhere it cannot be. ergon-wallpaper died exactly that way, under set -e,
# before it could start hyprpaper, and the desktop had no wallpaper.
ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
rc=0

report() { printf '  %s:%s: %s\n' "$1" "$2" "$3"; rc=1; }

while IFS= read -r f; do
  # Walk each file tracking whether we are inside an unquoted heredoc. A QUOTED
  # delimiter (<<'EOF' or <<"EOF") disables all expansion, so those are safe and
  # deliberately skipped.
  awk -v F="${f#"$ERGON"/}" '
    # <<TAG or <<-TAG, unquoted
    match($0, /<<-?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*$/) {
      tag = substr($0, RSTART, RLENGTH)
      gsub(/[<>[:space:]-]/, "", tag)
      inhd = 1; next
    }
    inhd && $0 ~ ("^" tag "[[:space:]]*$") { inhd = 0; next }
    # An ESCAPED backtick is literal text, not command substitution. Strip
    # those before testing, or every heredoc that legitimately writes markdown
    # is a finding -- and a lint people learn to ignore is worse than none.
    inhd { line = $0; gsub(/\\`/, "", line)
           if (line ~ /`/) printf "%s\t%d\tbacktick inside an unquoted heredoc\n", F, NR }
  ' "$f"
done < <(find -L "$ERGON/bin" "$ERGON/test" -type f ! -name 'erg-*' \( -name '*.sh' -o -name 'ergon' -o -name 'ergon-*' \) 2>/dev/null | sort) \
  | while IFS=$'\t' read -r file line msg; do report "$file" "$line" "$msg"; done

# ---------------------------------------------------------------------------
# Single-line expect blocks.
#
#     expect { timeout {} "PAT" { set x 1 } }
#
# never matches. It does not error and it is not a syntax problem -- the pattern
# simply never fires, so a poll loop spins to exhaustion while the output it is
# waiting for scrolls past. The identical block written over two lines matches on
# the first try. Verified empirically; this cost several 12-minute VM runs.
#
# Detected by brace balance rather than by a pattern: a line that opens an expect
# block AND closes every brace it opened is a complete one-line block.
if find -L "$ERGON/bin" "$ERGON/test" -type f ! -name 'erg-*' -exec awk '
    /^[[:space:]]*#/ { next }
    /expect[[:space:]]*\{/ {
      o = gsub(/\{/, "{"); c = gsub(/\}/, "}")
      if (o > 0 && o == c) {
        printf "  %s:%d: %s\n", FILENAME, FNR, $0
        found = 1
      }
    }
    END { exit (found ? 1 : 0) }
  ' {} + 2>/dev/null; then
  echo "  ok   no single-line expect blocks"
else
  echo "  FAIL single-line expect block(s) above -- split the block across lines" >&2
  rc=1
fi

# The while-read above runs in a subshell, so recompute rc from the output.
if find -L "$ERGON/bin" "$ERGON/test" -type f ! -name 'erg-*' \( -name '*.sh' -o -name 'ergon' -o -name 'ergon-*' \) \
   -exec awk '
       match($0, /<<-?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*$/) {
         tag = substr($0, RSTART, RLENGTH); gsub(/[<>[:space:]-]/, "", tag); inhd = 1; next
       }
       inhd && $0 ~ ("^" tag "[[:space:]]*$") { inhd = 0; next }
       inhd { line = $0; gsub(/\\`/, "", line); if (line ~ /`/) found = 1 }
       END { exit (found ? 1 : 0) }
     ' {} + 2>/dev/null; then
  echo "  ok   no backticks inside unquoted heredocs"
else
  echo "  FAIL backticks found inside an unquoted heredoc (see above)" >&2
  rc=1
fi

# ---------------------------------------------------------------------------
# Classic `hyprctl dispatch` against a Lua config.
#
# This repo configures Hyprland in Lua, and a Lua-configured Hyprland evaluates
# the dispatch IPC payload AS LUA. So the twenty-year-old form
#
#     hyprctl dispatch workspace 3
#
# arrives as `return hl.dispatch(workspace 3)` and dies on a syntax error that
# only the caller sees -- and almost nothing checks a dispatch's exit status, so
# it looks exactly like nothing happening. It cost an evening in waybar (whose
# workspace buttons send precisely that string), and it had silently broken
# hypridle's dpms on/off, which means a laptop whose screen never blanks and,
# worse, never comes back.
#
# The Lua form is `hyprctl dispatch 'hl.dsp.<...>'`, with
# `hl.dsp.exec_raw("<classic string>")` as the general escape hatch.
if find -L "$ERGON/bin" "$ERGON/hypr" "$ERGON/waybar" "$ERGON/fuzzel" \
        "$ERGON/test" -type f ! -name 'erg-*' \
   -exec grep -nE "hyprctl[[:space:]]+dispatch[[:space:]]+[^\"'\$]" {} + \
   | grep -vE '(ergon|erg)-lint' \
   | grep -vE '^[^:]*:[0-9]*:[[:space:]]*(#|--|//)' ; then
  echo "  FAIL classic 'hyprctl dispatch <word>' above -- a Lua config parses that as Lua." >&2
  echo "       use: hyprctl dispatch 'hl.dsp.exec_raw(\"<the classic string>\")'" >&2
  rc=1
else
  echo "  ok   no classic hyprctl dispatch calls"
fi

# Every check sets rc rather than exiting, so one failure does not hide another.

# ---------------------------------------------------------------------------
# Every command must be executable.
#
# `ergon` finds commands by scanning bin/ for executables, and provisioning runs
# them by path. A command committed 644 is invisible to the first and fails the
# second with "Permission denied" -- which is what ergon-boot-guard did, from
# provisioning, inside a VM, an hour into a test run.
while IFS= read -r f; do
  [ -x "$f" ] || report "${f#"$ERGON"/}" 1 "not executable, so ergon cannot run it"
done < <(find -L "$ERGON/bin" -maxdepth 1 -type f -name 'ergon-*' | sort)

# ---------------------------------------------------------------------------
# A command that finds its own repo must resolve symlinks.
#
# Provisioning links every ergon-* into /usr/local/bin, because waybar and
# autostart exec them by name. A script that derives its root from BASH_SOURCE
# without readlink -f then computes /usr/local as the repo, and every
# repo-relative path it opens is wrong.
#
# ergon-wallpaper did exactly this: it tried to source /usr/local/theme/cool.env,
# died under set -e before it could start hyprpaper, and the desktop had no
# wallpaper at all -- with no error anywhere a person would look.
while IFS= read -r f; do
  grep -q 'BASH_SOURCE\[0\]' "$f" || continue
  grep -q 'ERGON=' "$f" || continue
  grep -q 'readlink -f "\${BASH_SOURCE\[0\]}"' "$f" \
    || report "${f#"$ERGON"/}" 1 "derives \$ERGON from BASH_SOURCE without readlink -f; breaks when run via /usr/local/bin"
done < <(find -L "$ERGON/bin" -maxdepth 1 -type f -name 'ergon-*' | sort)

# ---------------------------------------------------------------------------
# ERGON-30: every command declares how it takes --help.
#
# bin/ergon only lets -h/--help reach a command when its header carries
# `# ergon:help=native` -- that command's own proof that it prints help and
# exits rather than acting on whatever it does not recognise (`ergon record
# --help` used to start a recording; `ergon ocr --help` opened the region
# selector). Every other command gets help synthesised by the router from
# `# ergon:args=`, so a command with neither tag is one the router cannot
# build --help for at all, silently or otherwise -- catch that here rather
# than at the moment someone types --help and gets nothing useful.
help_bad=0
while IFS= read -r f; do
  head -20 "$f" | grep -qE '^# ergon:(help=native|args=)' || {
    report "${f#"$ERGON"/}" 1 \
      "no # ergon:help=native and no # ergon:args= -- bin/ergon cannot build --help for this command"
    help_bad=$((help_bad + 1))
  }
done < <(find -L "$ERGON/bin" -maxdepth 1 -type f -name 'ergon-*' | sort)
[ "$help_bad" = 0 ] && echo "  ok   every command carries ergon:help=native or ergon:args"

# ---------------------------------------------------------------------------
# Nothing shipped here writes under ~/.config/ergon.
#
# That directory is the half of the desktop the repository does not own. Every
# themed surface is rendered from a .in template on every install, so the only
# place a person's own settings can survive is a file this repo never renders
# over -- and a shipped script that appended to one would be reintroducing, by
# hand, exactly the clobbering that mechanism exists to prevent. That is not
# hypothetical: `ergon fingerprint` used to tell people to paste an auth block
# into the GENERATED hyprlock.conf, and every render ate it.
#
# lib/user-config.sh and lib/ergon_arxiv.py are the exceptions, and both may
# only CREATE a file that is absent -- never write one that exists. Four of these surfaces
# (waybar, mako, fuzzel, foot) do not start at all if their include target is
# missing, so something has to create them; keeping that in one auditable file
# is the point of this rule.
#
# Limit, stated rather than papered over: this matches a write and the path on
# the SAME line. Assigning the path to a variable first and writing through the
# variable later would slip past. It catches the form anyone would actually
# write, which is worth having; it is not a proof.
uc_bad=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  rel="${f#"$ERGON"/}"
  # The files allowed to create one of these, because each does it the safe
  # way: only when the file is absent, never over one that exists.
  # ergon_arxiv.py has done this for arxiv.toml since long before the rule --
  # the first version of this check named user-config.sh as the ONLY exception,
  # which was a claim the repo already contradicted.
  case "$rel" in lib/user-config.sh|lib/ergon_arxiv.py) continue ;; esac
  while IFS=: read -r ln _; do
    [ -n "$ln" ] || continue
    report "$rel" "$ln" \
      "writes under ~/.config/ergon — that is the user's file; create it only if absent, and only from lib/"
    uc_bad=$((uc_bad + 1))
  # Comments and Lua comments dropped first: these paths are named in prose all
  # over this repo, and a lint that fires on documentation is a lint people
  # switch off.
  # The path token, three spellings deep. It is written as ~/.config/ergon, as
  # "$XDG_CONFIG_HOME/ergon" -- which does not contain the literal string
  # "config/ergon" at all -- and with braces, "${XDG_CONFIG_HOME}/ergon" or
  # "${XDG_CONFIG_HOME:-$HOME/.config}/ergon", where a } sits between the two
  # halves. Probes caught this rule missing the second and third spellings.
  #
  # The trailing \b is what keeps ~/.config/ergonomics/ out of it.
  done < <(grep -niE 'config(_home)?\}?/ergon\b' "$f" 2>/dev/null \
             | grep -vE '^[0-9]+:[[:space:]]*(#|--)' \
             | grep -iE '(>[>|]?[[:space:]]*"?[^|;&]*config(_home)?\}?/ergon\b|(^|[^[:alnum:]_])(tee|cp|mv|ln|install|truncate|rm|dd|touch|rsync)[[:space:]][^|;&]*config(_home)?\}?/ergon\b|sed[[:space:]]+-i[^|;&]*config(_home)?\}?/ergon\b)' \
             || true)
# hypr/ and .forgejo/ are in the set too: a write from the compositor's Lua or
# from a CI step is exactly as invisible as one from bin/, and nothing else
# would have caught it.
done < <( { find -L "$ERGON/bin" "$ERGON/lib" "$ERGON/test" "$ERGON/hypr" \
                 "$ERGON/.forgejo" -type f ! -name 'erg-*' 2>/dev/null
            printf '%s\n' "$ERGON/install.sh"; } | sort )
[ "$uc_bad" = 0 ] && echo "  ok   nothing writes under ~/.config/ergon outside lib/"

# ---------------------------------------------------------------------------
# One SKILL.md, two harnesses.
#
# This OS ships Claude Code and Codex, and install.sh links the same skill
# directory into ~/.claude/skills and $CODEX_HOME/skills. That only keeps
# working while the frontmatter stays inside what BOTH accept. Codex parses it
# strictly and allows exactly: name, description, license, allowed-tools,
# metadata. A key outside that set is not a warning there, and a skill that
# silently fails to load is the kind of thing nobody notices until an agent
# confidently edits the Lua config the wrong way.
skills_seen=0; skills_bad=0
bad_skill() { report "$@"; skills_bad=$((skills_bad+1)); }
while IFS= read -r m; do
  skills_seen=$((skills_seen+1))
  rel="${m#"$ERGON"/}"
  if [ "$(head -1 "$m")" != "---" ]; then
    bad_skill "$rel" 1 "must start with YAML frontmatter, or no harness will load it"
    continue
  fi
  fm=$(sed -n '2,/^---$/p' "$m" | sed '$d')
  for key in name description; do
    printf '%s\n' "$fm" | grep -q "^$key:" \
      || bad_skill "$rel" 2 "frontmatter has no '$key:', which both harnesses require"
  done
  while IFS= read -r key; do
    case "$key" in
      name|description|license|allowed-tools|metadata) ;;
      '') ;;
      *) bad_skill "$rel" 2 "frontmatter key '$key' is not one Codex accepts (name, description, license, allowed-tools, metadata)" ;;
    esac
  done < <(printf '%s\n' "$fm" | sed -n 's/^\([A-Za-z][A-Za-z0-9_-]*\):.*/\1/p')
done < <(find -L "$ERGON/skills" -maxdepth 2 -name SKILL.md 2>/dev/null | sort)
if [ "$skills_seen" -gt 0 ] && [ "$skills_bad" = 0 ]; then
  echo "  ok   $skills_seen skill(s) valid for Claude Code and Codex"
elif [ "$skills_seen" = 0 ]; then
  # Not "&& echo": under set -e a false test here would abort the script
  # before `exit $rc` and report a lint failure that does not exist.
  echo "  !!   no skills found under $ERGON/skills" >&2
fi

# Wallpaper captions and render settings must not be set from inside generate().
#
# render.py reads TITLE, SUBTITLE and the render settings off the module. A
# generator that assigns them as globals inside generate() gets the right
# caption on a fresh render and the WRONG one on every palette switch, which
# re-colours a saved field without calling generate() at all. Nine generators
# were written that way in one pass. A seed-dependent caption belongs in
# caption(seed); see render.py.
#
# Tracked files only: this guards what the repository ships, and should not
# fail on work in progress that has not been committed yet.
if git -C "$ERGON" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  wp_files=$(git -C "$ERGON" ls-files 'wallpaper/*.py')
else
  wp_files=$(cd "$ERGON" && ls wallpaper/*.py 2>/dev/null || true)
fi
wp_bad=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  while IFS=: read -r ln _; do
    report "$f" "$ln" "render setting assigned inside a function -- it reverts when a palette switch re-colours the saved field; use caption(seed)"
    wp_bad=$((wp_bad+1))
  # Both spellings: `global SUBTITLE` then an assignment, and
  # `globals()["SUBTITLE"] = ...`, which reached the tree in a second
  # generator after the first was caught.
  done < <(grep -nE '^[[:space:]]+(global[[:space:]]+|globals\(\)\[["'"'"'])(TITLE|SUBTITLE|SCALE|GAMMA|BLEND|RAMP|REVERSE|SATURATION|EXPOSURE|SOFTEN|HUE_SMOOTH)\b' "$ERGON/$f" || true)
done <<< "$wp_files"
[ "$wp_bad" = 0 ] && echo "  ok   wallpaper generators take captions and settings from module level"

# Every shipped background must have a provenance row.
#
# A wallpaper is redistributed to everyone who installs this OS, and an image's
# licence is almost never the repository's. Omarchy ships 92 of them with no
# attribution anywhere in its tree, having renamed the files that once carried
# the photographers' names -- that is the failure this check exists to prevent,
# and a rule enforced only by a paragraph in a markdown file is not enforced.
bg_dir="$ERGON/theme/backgrounds"
bg_prov="$bg_dir/PROVENANCE.md"
if [ -d "$bg_dir" ]; then
  bg_seen=0; bg_bad=0
  while IFS= read -r img; do
    [ -n "$img" ] || continue
    bg_seen=$((bg_seen+1))
    base=$(basename "$img")
    # Substring match, deliberately: the row may write the name as a path or
    # wrap it in backticks.
    if ! grep -qF "$base" "$bg_prov" 2>/dev/null; then
      report "${img#"$ERGON"/}" 1 "no row in theme/backgrounds/PROVENANCE.md — where did this image come from, and under what licence?"
      bg_bad=$((bg_bad+1))
    fi
  done < <(find -L "$bg_dir" -type f \
             \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
                -o -iname '*.webp' -o -iname '*.avif' \) 2>/dev/null | sort)
  if [ "$bg_seen" = 0 ]; then
    echo "  ok   no shipped backgrounds"
  elif [ "$bg_bad" = 0 ]; then
    echo "  ok   $bg_seen shipped background(s), each with recorded provenance"
  fi
fi

# ---------------------------------------------------------------------------
# Keybindings: every one described, and no chord bound twice.
#
# `ergon keys` is built from what the compositor reports, and it reports a
# description only where the config gave one -- so an undescribed bind is a key
# the cheatsheet silently does not have. The screenshot, media and night-light
# binds were all missing that way, the capture key used most among them. And
# Hyprland fires EVERY bind that matches, so a chord bound twice is two actions
# on one press: SUPER+SHIFT+B changed the background and reset the colour
# temperature at once, for as long as both files had it.
#
# A bind is described when its hl.bind call says description=, or when it goes
# through a local helper whose body sets one (binds.lua's bind()). switch:
# binds (the lid) are events rather than keys, so they are exempt.
#
# This reads what is written. A chord built at runtime -- the workspace loop,
# the help key chosen by layout -- is not a literal, so it is skipped by the
# duplicate check, which is also why the help key's two if/else branches do not
# read as one chord bound twice. The session test checks the running
# compositor's list for duplicates, which covers those.
bind_awk=$(cat <<'AWK'
function strip(s) {
  gsub(/\[=*\[.*\]=*\]/, "\"\"", s)
  gsub(/"([^"\\]|\\.)*"/, "\"\"", s)
  gsub(/'([^'\\]|\\.)*'/, "''", s)
  sub(/--.*/, "", s)
  return s
}
function literal(line, name,   r) {
  if (!match(line, name "[ \t]*\\([ \t]*\"[^\"]*\"[ \t]*,")) return ""
  r = substr(line, RSTART, RLENGTH); sub(/^[^"]*"/, "", r); sub(/"[^"]*$/, "", r)
  return r
}
# Modifier order and case do not matter to Hyprland, so they must not matter
# here: SUPER + SHIFT + CTRL + D and SUPER + CTRL + SHIFT + D are one chord.
function canon(c,   n, p, i, t, key, fl, out) {
  n = split(c, p, "+"); fl = " "; key = ""; out = ""
  for (i = 1; i <= n; i++) {
    t = toupper(p[i]); gsub(/^[ \t]+|[ \t]+$/, "", t)
    if (t == "WIN" || t == "LOGO" || t == "MOD4" || t == "META") t = "SUPER"
    if (t == "CONTROL") t = "CTRL"
    if (t == "MOD1") t = "ALT"
    if (t ~ /^(SHIFT|CAPS|CTRL|ALT|MOD2|MOD3|SUPER|MOD5)$/) fl = fl t " "; else key = t
  }
  n = split("SUPER CTRL ALT SHIFT CAPS MOD2 MOD3 MOD5", p, " ")
  for (i = 1; i <= n; i++) if (index(fl, " " p[i] " ")) out = out p[i] " + "
  return out key
}
function chord(c, ln,   k) {
  if (c == "") return
  k = canon(c)
  if (k in seen) print FILENAME "\t" ln "\t\"" c "\" is already bound at " seen[k] " -- both would fire on one press"
  else seen[k] = FILENAME ":" ln
}
function finish(   msg) {
  open = 0
  if (acc !~ /description[ \t]*=/ && call !~ /^switch:/) {
    msg = FILENAME "\t" at "\thl.bind without a description -- ergon keys will not list it"
    if (infn) pend[++npend] = msg; else print msg
  }
  chord(call, at)
}
FNR == 1 { split("", helper); infn = 0; open = 0 }
{
  s = strip($0)
  if (open) {
    acc = acc " " s; depth += gsub(/\(/, "(", s) - gsub(/\)/, ")", s)
    if (depth <= 0) finish()
    next
  }
  def = (s ~ /^local[ \t]+function[ \t]/)
  if (def) {
    fn = s; sub(/^local[ \t]+function[ \t]+/, "", fn); sub(/[^A-Za-z0-9_].*/, "", fn)
    infn = 1; fndesc = 0; npend = 0
  }
  if (infn && s ~ /description[ \t]*=/) fndesc = 1
  if (match(s, /hl\.bind[ \t]*\(/)) {
    acc = substr(s, RSTART); at = FNR; call = literal($0, "hl\\.bind")
    depth = gsub(/\(/, "(", acc) - gsub(/\)/, ")", acc)
    open = 1; if (depth <= 0) finish()
  } else {
    for (h in helper) if (match($0, "^[ \t]*" h "[ \t]*\\(")) chord(literal($0, "^[ \t]*" h), FNR)
  }
  # A top-level function ends at an unindented `end`, or on its own line.
  if (infn && (s ~ /^end/ || (def && s ~ /[ \t;)]end[ \t]*$/))) {
    if (fndesc) helper[fn] = 1; else for (i = 1; i <= npend; i++) print pend[i]
    infn = 0
  }
}
AWK
)
bind_out=$(cd "$ERGON" && awk "$bind_awk" hypr/common/*.lua)
while IFS=$'\t' read -r f l m; do
  [ -n "$f" ] && report "$f" "$l" "$m"
done <<< "$bind_out"
if [ -z "$bind_out" ]; then echo "  ok   every keybinding described, no chord bound twice"; fi

# ---------------------------------------------------------------------------
# ERGON-59: every import in lib/ is something a package list provides, and every
# remediation names a bundle that provides what it is the remedy for.
#
# lib/ergon_observe.py imported astroplan, and astroplan was in no list. So a
# missing astroplan printed "ergon bundle add astronomy", the user ran it, and
# astroplan was still missing: the tool's own fix fixed nothing. peek did the
# same with h5py and xarray, and sent anyone without astropy to a bundle for a
# package the base python already has. The import, the hint and the list are
# three places one dependency is written down, and nothing compared them.
#
# Names are compared as DISTRIBUTIONS, normalised the way ergon-bundle's _norm
# does it, and a name that looks right is not a name that is right: lachesis on
# PyPI is a closed-caption tool, positron-bin on the AUR a movie-watchlist
# manager. A module whose distribution is called something else (PIL is pillow)
# needs a row in DIST below, and the failure says so.
#
# Parsed with ast, never grepped: ergon_cite has a docstring line beginning
# "from a service that", which an import regex reads as an import, and peek
# imports through need("<module>"), which no grep for the keyword sees at all.
#
# NOT checked, deliberately: ergon_cite's SOFTWARE_DOI names h5py. software()
# cites only what installed_version() finds and skips the rest, so that table is
# a lookup for whatever the user's own project uses -- not a claim that this
# system provides anything.
imp_py=$(cat <<'PY'
import ast, os, re, sys
os.chdir(sys.argv[1])
# Module -> distribution, only where the two differ.
DIST = {"PIL": "pillow", "sklearn": "scikit-learn", "yaml": "pyyaml",
        "batman": "batman-package"}
# A bundle NAME, not a placeholder (<name>) and not a source (github:me/x//y).
HINT = re.compile(r"\bergon[ -]bundle add ([a-z0-9][a-z0-9-]*)(?![\w:/@-])")

def norm(t):  # ergon-bundle's _norm
    m = re.match(r"[A-Za-z0-9._@+-]+", t.split(" @ ")[0])
    return re.sub(r"[._]", "-", (m.group(0) if m else t).lower())

def listed(path):  # ergon-bundle's _list: one per line, # starts a comment
    if not os.path.isfile(path):
        return set()
    with open(path, encoding="utf-8") as fh:
        return {norm(l) for l in (x.split("#")[0].strip() for x in fh) if l}

base = listed("packages/python")
bundles = {b: listed(f"packages/bundles/{b}/python") | listed(f"packages/bundles/{b}/git")
           for b in sorted(os.listdir("packages/bundles"))
           if os.path.isdir(f"packages/bundles/{b}")}
anywhere = base.union(*bundles.values())
# Not a dotfile: Emacs keeps a .#name.py lock symlink beside a file being
# edited, and it points at nothing, so opening it would crash the check.
py = sorted(f for f in os.listdir("lib") if f.endswith(".py") and not f.startswith("."))
own = {f[:-3] for f in py}
skip = set(sys.stdlib_module_names) | {"__future__"} | own
dist = lambda top: norm(DIST.get(top, top))
n_imp = n_hint = 0

def say(f, ln, msg):
    print(f"{f}\t{ln}\t{msg}")

def text(n):  # a literal's value; an f-string with each {field} as {}
    if isinstance(n, ast.Constant) and isinstance(n.value, str):
        return n.value
    if isinstance(n, ast.JoinedStr):
        return "".join(v.value if isinstance(v, ast.Constant) else "{}" for v in n.values)

def strings(node):  # an f-string counts once, not once per piece
    inner = {id(c) for j in ast.walk(node) if isinstance(j, ast.JoinedStr)
             for c in ast.walk(j) if c is not j}
    return [(n, text(n)) for n in ast.walk(node) if id(n) not in inner and text(n) is not None]

def imports(nodes):  # import x, from x import y, need("x"), import_module("x")
    for n in (m for s in nodes for m in ast.walk(s)):
        names = []
        if isinstance(n, ast.Import):
            names = [a.name for a in n.names]
        elif isinstance(n, ast.ImportFrom) and n.level == 0:
            names = [n.module]
        elif (isinstance(n, ast.Call) and n.args and isinstance(n.args[0], ast.Constant)
              and isinstance(n.args[0].value, str)
              and getattr(n.func, "id", getattr(n.func, "attr", None)) in ("need", "import_module")):
            names = [n.args[0].value]
        for top in (x.split(".")[0] for x in names):
            if top not in skip:
                yield n.lineno, top

def where(lines, n, needle):  # the line a hint is on, in a literal spanning several
    return next((i for i in range(n.lineno, (n.end_lineno or n.lineno) + 1)
                 if needle in lines[i - 1]), n.lineno)

def no_bundle(f, ln, m):
    global n_hint
    n_hint += 1
    if m.group(1) not in bundles:
        say(f, ln, f"'{m.group(0)}': there is no packages/bundles/{m.group(1)}")

for f in py:
    rel = f"lib/{f}"
    with open(rel, encoding="utf-8") as fh:
        src = fh.read()
    lines = src.splitlines()
    try:
        tree = ast.parse(src, rel)
    except SyntaxError as e:
        say(rel, e.lineno, f"does not parse, so nothing can check its imports: {e.msg}")
        continue
    for ln, top in imports([tree]):
        n_imp += 1
        if dist(top) not in anywhere:
            say(rel, ln, f"imports {top}, which no package list provides"
                f" (if its distribution is not {dist(top)}, add a DIST row in bin/ergon-lint)")
    for n, s in strings(tree):
        for m in HINT.finditer(s):
            no_bundle(rel, where(lines, n, m.group(0)), m)
    # A hint under `except ImportError` is the fix for what that try imports:
    # each import must be in the base python or in that bundle, and at least
    # one in the bundle, or adding it changes nothing.
    for t in (t for t in ast.walk(tree) if isinstance(t, ast.Try)):
        tops = sorted({top for _, top in imports(t.body)})
        for h in t.handlers:
            types = h.type.elts if isinstance(h.type, ast.Tuple) else [h.type]
            if not any(getattr(x, "id", None) in ("ImportError", "ModuleNotFoundError") for x in types):
                continue
            for n, s in strings(h):
                for m in (m for m in HINT.finditer(s) if m.group(1) in bundles):
                    n_hint += 1
                    ln, has = where(lines, n, m.group(0)), bundles[m.group(1)]
                    bad = [x for x in tops if dist(x) not in base | has]
                    for x in bad:
                        say(rel, ln, f"'{m.group(0)}' is the fix offered for {x}, and that bundle does not provide it")
                    if not bad and not any(dist(x) in has for x in tops):
                        say(rel, ln, f"'{m.group(0)}' is the fix offered for {', '.join(tops) or 'nothing third-party'}, and none of it needs that bundle")
    # A provider table, {"module": "the hint"}, as peek's PROVIDER is.
    for d in (d for d in ast.walk(tree) if isinstance(d, ast.Dict)):
        for k, v in zip(d.keys, d.values):
            key, s = (text(k) if k else None), text(v)
            if not (key and s and re.fullmatch(r"[A-Za-z_][\w.]*", key)):
                continue
            want = dist(key.split(".")[0])
            for m in (m for m in HINT.finditer(s) if m.group(1) in bundles):
                n_hint += 1
                if want not in bundles[m.group(1)]:
                    say(rel, where(lines, v, m.group(0)), f"'{m.group(0)}' is the hint for {key}, and that bundle does not provide it")
            if "pyfleet sync" in s:
                n_hint += 1
                if want not in base:
                    say(rel, where(lines, v, "pyfleet sync"), f"'pyfleet sync' is the hint for {key}, and packages/python does not list it")
            for m in re.finditer(r"\bpip install ([A-Za-z0-9][\w.-]*)", s):
                n_hint += 1
                if norm(m.group(1)) not in anywhere:
                    say(rel, where(lines, v, m.group(0)), f"'{m.group(0)}' is the hint for {key}, and no package list provides {m.group(1)}")

# The commands' own messages: only that the bundle they name exists.
for f in sorted(os.listdir("bin")):
    if (f == "ergon" or f.startswith("ergon-")) and os.path.isfile(f"bin/{f}"):
        with open(f"bin/{f}", encoding="utf-8", errors="replace") as fh:
            for ln, line in enumerate(fh, 1):
                if not line.lstrip().startswith("#"):
                    for m in HINT.finditer(line):
                        no_bundle(f"bin/{f}", ln, m)
print(f"=\t{n_imp}\t{n_hint}")
PY
)
imp_bad=0; imp_n=0; hint_n=0
if ! command -v python3 >/dev/null 2>&1; then
  echo "  FAIL no python3, so nothing checks lib/'s imports against the package lists" >&2
  rc=1
# -I: isolated, so a re.py in the caller's directory or a PYTHONPATH cannot
# stand in for the modules this check imports.
elif imp_out=$(python3 -I -c "$imp_py" "$ERGON"); then
  while IFS=$'\t' read -r f l m; do
    case "$f" in
      '') ;;
      =) imp_n=$l; hint_n=$m ;;
      *) report "$f" "$l" "$m"; imp_bad=$((imp_bad + 1)) ;;
    esac
  done <<< "$imp_out"
  if [ "$imp_bad" = 0 ]; then
    echo "  ok   $imp_n third-party import(s) in lib/ and $hint_n remediation hint(s), each provided by what it names"
  fi
else
  # A crash is not a pass. The traceback is above; say what it means.
  echo "  FAIL the import check did not run (python3 exited non-zero)" >&2
  rc=1
fi

# ---------------------------------------------------------------------------
# ERGON-41: every command and bind a knowledge topic NAMES actually exists.
#
# knowledge/*.md is read once and trusted, unlike `ergon --list` and `ergon
# keys`, which are regenerated from the running system every time -- so a
# command renamed or a bind moved leaves a topic pointing at nothing, silently,
# with nothing before this to notice.
#
# Checked only inside backticks and 4-space-indented blocks, because ordinary
# prose contains "ergon" without naming a command: security.md says "ergon
# policy" and "ergon installs no extension" in running sentences, and
# troubleshooting.md's own `environment.d/10-ergon-path.conf` and
# `49-ergon-desktop.rules` are paths that happen to contain the string
# "ergon-", not commands -- excluded by requiring nothing word-ish (a letter,
# digit, dot, slash or another hyphen) immediately before the match.
#
# Only the word right after ergon/ergon-/erg- is resolved against bin/: `ergon
# bundle add` and `ergon-hardware detect` name a subcommand or an argument, and
# confirming those exist would mean running the command, not reading bin/.
# Hyphenated command names (`ergon-launch-tui`, `ergon-wallpaper-gen`) are kept
# whole rather than cut at the first hyphen.
#
# Chords are canonicalised the same way the keybinding check above does --
# modifier order and case do not matter to Hyprland -- and checked against
# every literal chord hypr/common/*.lua actually binds, direct or through the
# local `bind()` wrapper (binds.lua, media.lua). A chord whose final key is a
# bare digit is skipped rather than checked: troubleshooting.md's "SHIFT+7"
# is a keyboard-layout illustration (what the US "/" key types on a Latin
# American layout), not a claim that this repo binds it, and workspace
# switching is bound in a runtime loop the same way the check above already
# excludes from its own duplicate detection.
knowledge_py=$(cat <<'PY'
import os, re, sys

root = sys.argv[1]
cmds = {f[len("ergon-"):] for f in os.listdir(os.path.join(root, "bin"))
        if f.startswith("ergon-") and os.path.isfile(os.path.join(root, "bin", f))}

MOD = {"SUPER": "SUPER", "WIN": "SUPER", "LOGO": "SUPER", "MOD4": "SUPER", "META": "SUPER",
       "CTRL": "CTRL", "CONTROL": "CTRL", "ALT": "ALT", "MOD1": "ALT",
       "SHIFT": "SHIFT", "CAPS": "CAPS", "MOD2": "MOD2", "MOD3": "MOD3", "MOD5": "MOD5"}
ORDER = ["SUPER", "CTRL", "ALT", "SHIFT", "CAPS", "MOD2", "MOD3", "MOD5"]

def canon(chord):
    mods, key = set(), ""
    for p in chord.split("+"):
        p = p.strip().upper()
        if p in MOD:
            mods.add(MOD[p])
        else:
            key = p
    return " + ".join(m for m in ORDER if m in mods) + " + " + key

binds = set()
hypr_dir = os.path.join(root, "hypr", "common")
for f in sorted(os.listdir(hypr_dir)) if os.path.isdir(hypr_dir) else []:
    if not f.endswith(".lua"):
        continue
    with open(os.path.join(hypr_dir, f), encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    for m in re.finditer(r'hl\.bind\(\s*"([^"]+)"', text):
        binds.add(canon(m.group(1)))
    for m in re.finditer(r'(?<![\w.])bind\(\s*"([^"]+)"', text):
        binds.add(canon(m.group(1)))

CMD = re.compile(r'(?<![\w./-])(?:ergon[ -]|erg-)([a-z][a-z0-9]*(?:-[a-z][a-z0-9]*)*)')
CHORD = re.compile(r'\b(?:SUPER|WIN|LOGO|MOD[1-5]|META|CTRL|CONTROL|ALT|SHIFT|CAPS)\b'
                    r'(?:\s*\+\s*[A-Za-z0-9_]+)+')
SPAN = re.compile(r'`([^`]+)`')

n_cmd = n_chord = 0
kdir = os.path.join(root, "knowledge")
for name in sorted(os.listdir(kdir)):
    if not name.endswith(".md"):
        continue
    path = os.path.join(kdir, name)
    rel = os.path.relpath(path, root)
    with open(path, encoding="utf-8", errors="replace") as fh:
        lines = fh.readlines()
    for lineno, line in enumerate(lines, 1):
        spans = SPAN.findall(line)
        if line.startswith("    "):
            spans.append(line[4:])
        for span in spans:
            for m in CMD.finditer(span):
                n_cmd += 1
                w = m.group(1)
                if w not in cmds:
                    print(f"{rel}\t{lineno}\tno such command 'ergon {w}' (bin/ergon-{w} does not exist)")
            for m in CHORD.finditer(span):
                key = canon(m.group(0)).rsplit(" ", 1)[-1]
                if key.isdigit():
                    continue
                n_chord += 1
                c = canon(m.group(0))
                if c not in binds:
                    print(f"{rel}\t{lineno}\t'{m.group(0)}' is not bound anywhere in hypr/common/*.lua")
print(f"=\t{n_cmd}\t{n_chord}")
PY
)
kn_bad=0; kn_cmd=0; kn_chord=0
if ! command -v python3 >/dev/null 2>&1; then
  echo "  FAIL no python3, so nothing checks knowledge/*.md's commands and binds against reality" >&2
  rc=1
elif kn_out=$(python3 -I -c "$knowledge_py" "$ERGON"); then
  while IFS=$'\t' read -r f l m; do
    case "$f" in
      '') ;;
      =) kn_cmd=$l; kn_chord=$m ;;
      *) report "$f" "$l" "$m"; kn_bad=$((kn_bad + 1)) ;;
    esac
  done <<< "$kn_out"
  if [ "$kn_bad" = 0 ]; then
    echo "  ok   $kn_cmd command mention(s) and $kn_chord chord mention(s) in knowledge/*.md, each real"
  fi
else
  echo "  FAIL the knowledge-reference check did not run (python3 exited non-zero)" >&2
  rc=1
fi

exit $rc
