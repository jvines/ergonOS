#!/usr/bin/env bash
# ergon:summary=Show or change the system language and formats (locale), no reinstall
# ergon:group=system
# ergon:args=[--show | --list | LOCALE [--formats LOCALE] [--numeric LOCALE]]
# ergon:help=native
#
#   ergon language                      pick a language (type part of a name), then formats
#   ergon language es_CL.UTF-8          set the language (LANG) directly
#   ergon language en_US.UTF-8 --formats en_DK.UTF-8
#                                       English UI, ISO dates (en_DK), metric paper/units
#   ergon language --list               locales glibc can generate (UTF-8 only)
#   ergon language --show               what is set now
#
# --formats LOCALE sets LC_TIME, LC_MONETARY, LC_PAPER and LC_MEASUREMENT
# (and LC_NAME/ADDRESS/TELEPHONE/IDENTIFICATION stay on LANG).
# LC_NUMERIC is NOT part of it: it is set to C.UTF-8 so the decimal separator
# stays '.', because a decimal comma breaks science tooling that parses numbers
# (awk, gnuplot, R, CSV readers). Pass --numeric LOCALE to choose otherwise.
#
# The locale is enabled in /etc/locale.gen, generated, and written with
# localectl. Apps launched later from the systemd/dbus user environment (the
# launcher, services) get it at once; apps already running keep their old
# language until restarted, and a terminal, Hyprland itself and its exec'd
# programs need a re-login for the full effect.
set -euo pipefail

SUPPORTED=${ERGON_LOCALE_SUPPORTED:-/usr/share/i18n/SUPPORTED}
LOCALE_GEN=${ERGON_LOCALE_GEN:-/etc/locale.gen}
LOCALE_CONF=${ERGON_LOCALE_CONF:-/etc/locale.conf}
die() { echo "ergon-language: $*" >&2; exit 1; }
priv() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }

# "en_US.UTF-8" for each UTF-8 entry. Plain "en_US" style names are not
# offered: a UTF-8 desktop has no use for legacy charsets.
locales() { awk '$2=="UTF-8"{print $1}' "$SUPPORTED" | sort -u; }
valid()   { locales | grep -qxF -- "$1"; }
current() { sed -n 's/^\(LANG\|LC_[A-Z]*\)=\(.*\)/\1=\2/p' "$LOCALE_CONF" 2>/dev/null; }

enable() {  # uncomment the locale in locale.gen, or append it
  local re=${1//./\\.}
  if grep -qE "^[[:space:]]*$re[[:space:]]+UTF-8" "$LOCALE_GEN"; then return 0; fi
  if grep -qE "^#[[:space:]]*$re[[:space:]]+UTF-8" "$LOCALE_GEN"; then
    priv sed -i -E "s/^#[[:space:]]*($re[[:space:]]+UTF-8)/\1/" "$LOCALE_GEN"
  else
    echo "$1 UTF-8" | priv tee -a "$LOCALE_GEN" >/dev/null
  fi
}

ask() {  # ask PROMPT -> reads a locale (substring filter, number, or exact); echoes it
  local q m n i
  while :; do
    printf '%s' "$1" >&2; read -r q || return 1
    [ -z "$q" ] && { echo ""; return 0; }
    valid "$q" && { echo "$q"; return 0; }
    m=$(locales | grep -i -- "$q" || true); n=$(grep -c . <<<"$m" || true)
    if [ -z "$m" ]; then echo "  nothing matches '$q'" >&2
    elif [ "$n" -eq 1 ]; then echo "$m"; return 0
    elif [ "$n" -le 40 ]; then
      i=0; while read -r l; do i=$((i+1)); printf '  %2d  %s\n' "$i" "$l" >&2; done <<<"$m"
      printf '  number (Enter = search again): ' >&2; read -r i || return 1
      [[ $i =~ ^[0-9]+$ ]] && [ "$i" -ge 1 ] && [ "$i" -le "$n" ] && { sed -n "${i}p" <<<"$m"; return 0; }
    else echo "  $n matches, type more of the name (es_, German, ...)" >&2; fi
  done
}

lang= formats= numeric=C.UTF-8
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --show)    current; exit 0 ;;
    --list)    locales; exit 0 ;;
    --formats) [ $# -ge 2 ] || die "--formats needs a locale"; formats=$2; shift ;;
    --numeric) [ $# -ge 2 ] || die "--numeric needs a locale"; numeric=$2; shift ;;
    -*)        die "unknown option $1" ;;
    *)         [ -z "$lang" ] || die "one LOCALE only"; lang=$1 ;;
  esac
  shift
done

if [ -z "$lang" ]; then
  [ -t 0 ] || { echo "ergon-language: needs a terminal, or pass a LOCALE" >&2; exit 2; }
  echo "now: $(current | tr '\n' ' ')" >&2
  lang=$(ask "language (part of a locale name, e.g. es_CL, de_DE): ") || exit 1
  [ -n "$lang" ] || exit 0
  formats=$(ask "formats for dates/currency/paper, if different (en_DK = ISO dates; Enter = same): ") || exit 1
  echo "numbers keep '.' as the decimal separator (LC_NUMERIC=$numeric); pass --numeric to change." >&2
fi

for l in "$lang" "$formats" "$numeric"; do
  [ -z "$l" ] || valid "$l" || die "not a UTF-8 locale glibc supports: $l (see: ergon language --list)"
done

args=("LANG=$lang")
if [ -n "$formats" ]; then
  for k in LC_TIME LC_MONETARY LC_PAPER LC_MEASUREMENT; do args+=("$k=$formats"); done
fi
args+=("LC_NUMERIC=$numeric")

for l in "$lang" "$formats" "$numeric"; do [ -z "$l" ] || enable "$l"; done
priv locale-gen >/dev/null
priv localectl set-locale "${args[@]}"

# Live: whatever the user manager and dbus start from now on sees it.
if [ "$(id -u)" != 0 ]; then
  all=(LANG LC_TIME LC_MONETARY LC_PAPER LC_MEASUREMENT LC_NUMERIC)
  unset_=(); for k in "${all[@]}"; do case " ${args[*]} " in *" $k="*) ;; *) unset_+=("$k") ;; esac; done
  systemctl --user set-environment "${args[@]}" 2>/dev/null || true
  [ ${#unset_[@]} -eq 0 ] || systemctl --user unset-environment "${unset_[@]}" 2>/dev/null || true
  dbus-update-activation-environment --systemd "${args[@]}" 2>/dev/null || true
fi

echo "language is now ${args[*]}"
echo "numbers: LC_NUMERIC=$numeric (decimal separator '.' unless that locale says otherwise)"
echo "new apps from the launcher pick it up; running apps need a restart, and a re-login gives the full effect."
