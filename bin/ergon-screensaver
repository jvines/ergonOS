#!/usr/bin/env bash
# ergon:summary=Idle screensaver: the ergonOS mark, animated by terminaltexteffects
# ergon:group=power
# ergon:args=[start | stop | run]
#
# hypridle starts it after 3 minutes idle and stops it on the first input
# (hypr/hypridle.conf), ahead of the dim at 4 and the lock at 10 (ERGON-140).
# `start` opens a fullscreen foot running `run`; `stop` closes it. Switch it off
# with `ergon toggle screensaver off`. A key press in the window also ends it.
#
# `run` plays the logo's terminal art (logo/term/) through `tte`, a different
# random effect each cycle, until a key is pressed. tte is not in the Arch
# repos: provisioning installs it as a uv tool, pinned (TTE_VERSION below and
# bin/provision-arch.sh must agree; bin/test-toggle.sh checks that). Without
# it, or when an effect fails, the static art is shown instead -- a screensaver
# that crashes is a blank screen at best. ERGON_SCREENSAVER_EFFECT=<name> pins
# the effect (the VM suite uses it for a repeatable screenshot).
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
here=${self%/*}
art_dir=$here/../logo/term
pidfile="${XDG_RUNTIME_DIR:-/tmp}/ergon-screensaver.pid"
TTE_VERSION=0.15.0

# The largest art that fits the window with a margin, or nothing.
pick_art() {
  local cols=$1 rows=$2 size
  for size in 60x25 36x15 24x10; do
    local w=${size%x*} h=${size#*x}
    if [ "$cols" -ge $((w + 4)) ] && [ "$rows" -ge $((h + 4)) ]; then echo "$art_dir/ergon-$size.txt"; return 0; fi
  done
  return 1
}

# The terminal's own background, so tte's fades land on it. foot.ini is the
# rendered palette; fall back to tte's default (black) if it is not there.
term_bg() {
  sed -n 's/^background *= *\([0-9A-Fa-f]\{6\}\).*/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/foot/foot.ini" 2>/dev/null | head -1 || true
}

# The static fallback: the art, centred, in the accent colour (ANSI cyan, which
# the terminal's palette sets).
still() {
  local art=$1 cols=$2 rows=$3 w h pad top line
  w=$(awk '{ if (length($0) > m) m = length($0) } END { print m }' "$art")
  h=$(wc -l < "$art")
  pad=$(( (cols - w) / 2 )); [ "$pad" -ge 0 ] || pad=0
  top=$(( (rows - h) / 2 )); [ "$top" -ge 0 ] || top=0
  printf '\e[2J\e[96m'
  while IFS= read -r line; do
    top=$((top + 1)); printf '\e[%d;%dH%s' "$top" $((pad + 1)) "$line"
  done < "$art"
  printf '\e[0m'
}

run() {
  trap 'printf "\e[?25h\e[?1049l"' EXIT
  printf '\e[?1049h\e[?25l'
  local cols rows art bg pid tte=""
  command -v tte >/dev/null 2>&1 && tte=tte
  [ -n "$tte" ] || { [ -x "$HOME/.local/bin/tte" ] && tte="$HOME/.local/bin/tte"; }
  while :; do
    # stty, not tput: it needs no $TERM, which a bare environment lacks.
    read -r rows cols < <(stty size 2>/dev/null || echo "24 80")
    art=$(pick_art "$cols" "$rows") || art=$art_dir/ergon-24x10.txt
    if [ -n "$tte" ] && [ -f "$art" ]; then
      bg=$(term_bg)
      printf '\e[2J\e[H'
      # --no-eol and --no-restore-cursor keep tte from scrolling the screen or
      # moving the cursor under the alternate screen; the canvas is the window
      # less two rows. Its stdout is the animation, so it keeps the terminal.
      # Backgrounded, so the key read below can end it at once.
      "$tte" -i "$art" --frame-rate 240 --canvas-width 0 --canvas-height $((rows - 2)) \
        --anchor-canvas c --anchor-text c ${bg:+--terminal-background-color "$bg"} \
        --no-eol --no-restore-cursor ${ERGON_SCREENSAVER_EFFECT:---random-effect} 2>/dev/null </dev/null &
      pid=$!
    else
      still "$art" "$cols" "$rows"
      pid=""
    fi
    # Any key ends it; otherwise wait for the effect, hold the finished logo
    # for a few seconds, and go again with another effect.
    while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; do
      if read -r -s -n1 -t 0.2; then kill "$pid" 2>/dev/null || true; exit 0; fi
    done
    [ -n "$pid" ] && wait "$pid" 2>/dev/null || still "$art" "$cols" "$rows"
    if read -r -s -n1 -t 4; then exit 0; fi
  done
}

case "${1:-start}" in
  run)   run ;;
  start)
    [ "$("$here/ergon-toggle" get screensaver 2>/dev/null || echo on)" = off ] && exit 0
    "$0" stop
    setsid foot --fullscreen --app-id=ergon-screensaver "$self" run >/dev/null 2>&1 &
    echo $! > "$pidfile"
    ;;
  stop)
    pid=$(cat "$pidfile" 2>/dev/null || true)
    # Only a process that is still ours: the pid may have been reused.
    if [ -n "$pid" ] && grep -aq ergon-screensaver "/proc/$pid/cmdline" 2>/dev/null; then kill "$pid" 2>/dev/null || true; fi
    rm -f "$pidfile"
    ;;
  -h|--help) sed -n "2,16p" "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "ergon-screensaver: unknown argument '$1'" >&2; exit 2 ;;
esac
