#!/usr/bin/env bash
# ergon:summary=Format an external drive (exFAT, ext4 or encrypted), or change its LUKS password
# ergon:group=hardware
# ergon:args=list [--why] | format [DEVICE] | passwd [DEVICE]
# ergon:help=native
#
#   ergon drive list [--why]    drives that may be formatted; --why also shows the refused ones
#   ergon drive format [DEV]    wipe a drive and make it exFAT, ext4 or LUKS2+ext4
#   ergon drive passwd [DEV]    change the password of an encrypted external drive
#
# DESTRUCTIVE, so the design is the refusals. Only removable / USB / hotplug
# DISKS are ever offered. A disk with anything mounted on any of its partitions
# (/, /boot, swap, a stick you are using) or an open LUKS container is refused:
# unmount it first. The DEVICE argument gets no exemption, it must be on the
# offered list. The wipe is confirmed by typing the drive's model or size, and
# the list is read again just before the wipe.
#
# exFAT opens on Linux, macOS and Windows. ext4 on Linux. LUKS2+ext4 is
# encrypted and opens ONLY on Linux. Writes use sudo (udisks has no format verb
# without a polkit session rule); the prompts say what is about to run.
#
# ERGON_DRIVE_LSBLK=file reads that lsblk JSON instead of the real one, for tests.
set -euo pipefail
exec 3<&0   # the operator's stdin, which a pipe into choose() would otherwise shadow

US=$'\037'   # field separator: not whitespace, so empty fields survive read
COLS=NAME,PATH,TRAN,RM,HOTPLUG,SIZE,MODEL,FSTYPE,MOUNTPOINTS,TYPE
lsblk_json() {
  if [ -n "${ERGON_DRIVE_LSBLK:-}" ]; then cat "$ERGON_DRIVE_LSBLK"
  else lsblk -J -o "$COLS"; fi
}

# One TSV line per top-level disk: path, ok|refused, reason-or-"", size, model,
# tran, partitions. A disk is only a candidate when it is removable, hotplug or
# USB; everything else is not even listed as refused.
classify='
  def mps: [.mountpoints[]?, .mountpoint?] | map(select(. != null and . != ""));
  def walk: ., (.children[]? | walk);
  def t: if . == null then "" else tostring end;
  .blockdevices[] | select(.type == "disk")
  | select(.rm == true or .rm == "1" or .hotplug == true or .hotplug == "1" or .tran == "usb")
  | [walk] as $all
  | ([$all[] | select(.type == "crypt")] | length) as $open
  | ([$all[] | mps[]] | unique | join(" ")) as $mounted
  | [ .path,
      (if $open > 0 then "refused" elif $mounted != "" then "refused" else "ok" end),
      (if $open > 0 then "an open encrypted container: close it first"
       elif $mounted != "" then "mounted at " + $mounted + ": unmount it first" else "" end),
      (.size | t), ((.model | t) | gsub("^ +| +$"; "")), (.tran | t),
      ([.children[]? | (.path | t) + " " + (.size | t) + (if (.fstype|t) != "" then " " + (.fstype|t) else "" end)] | join(", "))
    ] | @tsv'

classified() { lsblk_json | jq -r "$classify" | tr '\t' "$US"; }

# LUKS containers on eligible disks: path, size, disk.
luks_list() {
  lsblk_json | jq -r '
    def mps: [.mountpoints[]?, .mountpoint?] | map(select(. != null and . != ""));
    def walk: ., (.children[]? | walk);
    .blockdevices[] | select(.type == "disk")
    | select(.rm == true or .rm == "1" or .hotplug == true or .hotplug == "1" or .tran == "usb")
    | . as $d | [walk] as $all
    | select(([$all[] | select(.type == "crypt")] | length) == 0 and ([$all[] | mps[]] | length) == 0)
    | $all[] | select(.fstype == "crypto_LUKS") | "\(.path)  \(.size)  on \($d.path)"'
}

describe() { awk -F"$US" '{printf "%s  %s  %s%s\n", $1, $4, ($5==""?"(no model)":$5), ($7==""?"  [no partitions]":"  [" $7 "]")}'; }

cmd_list() {
  local why=0; [ "${1:-}" = "--why" ] && why=1
  local rows; rows=$(classified)
  [ -n "$rows" ] || { echo "no removable drive is attached" >&2; return 0; }
  grep -P '\x1fok\x1f' <<<"$rows" | describe || true
  [ "$why" = 1 ] && awk -F"$US" '$2=="refused"{printf "refused  %s  %s: %s\n", $1, $5, $3}' <<<"$rows"
  return 0
}

choose() {  # choose PROMPT < lines -> the chosen line; fzf on a tty, a numbered list otherwise
  local prompt="$1" lines; lines=$(cat)
  [ -n "$lines" ] || return 1
  [ "$(wc -l <<<"$lines")" = 1 ] && { printf "%s\n" "$lines"; return; }  # one choice is no choice
  if [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null; then
    fzf --prompt "$prompt  " --height 40% --reverse <<<"$lines"
  else
    local n i=0 l; while IFS= read -r l; do i=$((i + 1)); printf '  %d) %s\n' "$i" "$l" >&2; done <<<"$lines"
    printf '%s ' "$prompt" >&2; read -r n <&3
    sed -n "${n:-0}p" <<<"$lines"
  fi
}

pick_disk() {  # pick_disk [DEV] -> the row of an eligible disk
  local rows ok row; rows=$(classified); ok=$(grep -P '\x1fok\x1f' <<<"$rows" || true)
  if [ -n "${1:-}" ]; then
    row=$(awk -F"$US" -v d="$1" '$1==d' <<<"$ok")
    if [ -z "$row" ]; then
      echo "$1 is not on the list of drives that may be formatted:" >&2
      awk -F"$US" -v d="$1" '$1==d{print "  " $3}' <<<"$rows" >&2
      [ -n "$(awk -F"$US" -v d="$1" '$1==d' <<<"$rows")" ] || echo "  not a removable, USB or hotplug disk" >&2
      return 1
    fi
    printf '%s\n' "$row"; return
  fi
  if [ -z "$ok" ]; then
    echo "no drive may be formatted right now. Why:" >&2; cmd_list --why >&2; return 1
  fi
  local sel; sel=$(describe <<<"$ok" | choose "drive") || return 1
  awk -F"$US" -v d="${sel%% *}" '$1==d' <<<"$ok"
}

ask_password() {  # ask_password VAR_NAME [label]
  local a b; printf '%s: ' "${2:-New password}" >&2; IFS= read -rs a; echo >&2
  [ -n "$a" ] || { echo "an empty password is refused" >&2; return 1; }
  printf 'Again: ' >&2; IFS= read -rs b; echo >&2
  [ "$a" = "$b" ] || { echo "the two passwords differ" >&2; return 1; }
  printf -v "$1" '%s' "$a"
}

cmd_format() {
  local row dev size model fs
  row=$(pick_disk "${1:-}") || exit 1
  IFS="$US" read -r dev _ _ size model _ parts <<<"$row"
  echo "About to ERASE $dev: ${model:-no model}, $size"
  echo "  now holds: ${parts:-nothing recognisable}"
  fs=$(printf '%s\n' "exfat   works on Linux, macOS and Windows" \
                     "ext4    Linux only" \
                     "luks    encrypted LUKS2+ext4, opens ONLY on Linux" | choose "filesystem") || exit 1
  fs=${fs%% *}
  case "$fs" in exfat|ext4|luks) ;; *) echo "no filesystem chosen" >&2; exit 1 ;; esac
  local pw=""
  [ "$fs" = luks ] && { ask_password pw "Password for the drive" || exit 1; }
  printf 'Type the model (%s) or the size (%s) to erase it, anything else cancels: ' "${model:-none}" "$size" >&2
  local typed; IFS= read -r typed
  if [ -z "$typed" ] || { [ "$typed" != "$size" ] && [ "$typed" != "$model" ]; }; then
    echo "cancelled, nothing was written" >&2; exit 1
  fi
  # The list may have changed while the prompts were open: ask again.
  pick_disk "$dev" >/dev/null || { echo "the drive is no longer eligible, nothing was written" >&2; exit 1; }
  echo "sudo will now ask for your password to partition and format $dev." >&2
  sudo wipefs --all "$dev" >/dev/null
  sudo sfdisk --quiet "$dev" <<<'label: gpt
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4'
  sudo udevadm settle || true
  local part; part=$(lsblk_part "$dev")
  case "$fs" in
    exfat) sudo mkfs.exfat -L ERGON "$part" ;;
    ext4)  sudo mkfs.ext4 -q -L ergon "$part" ;;
    luks)
      local map="ergon-fmt-$$"
      printf '%s' "$pw" | sudo cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$part"
      printf '%s' "$pw" | sudo cryptsetup open --key-file - "$part" "$map"
      sudo mkfs.ext4 -q -L ergon "/dev/mapper/$map"
      sudo cryptsetup close "$map" ;;
  esac
  echo "done: $dev is $fs. Unplug it, or replug it to have it mounted."
  [ "$fs" = luks ] && echo "note: this drive opens only on Linux."
  return 0
}

lsblk_part() {  # the first partition of a disk, read after the table was written
  if [ -n "${ERGON_DRIVE_LSBLK:-}" ]; then
    case "$1" in *[0-9]) echo "${1}p1" ;; *) echo "${1}1" ;; esac
  else lsblk -nlpo PATH,TYPE "$1" | awk '$2=="part"{print $1; exit}'; fi
}

cmd_passwd() {
  local row dev
  row=$(luks_list | { [ -n "${1:-}" ] && awk -v d="$1" '$1==d' || cat; } | choose "encrypted drive") || true
  [ -n "$row" ] || { echo "no closed LUKS drive is attached (an open or mounted one must be unmounted first)" >&2; exit 1; }
  dev=${row%% *}
  local old new run="${XDG_RUNTIME_DIR:-/tmp}"
  printf 'Current password: ' >&2; IFS= read -rs old; echo >&2
  ask_password new "New password" || exit 1
  umask 077
  local d; d=$(mktemp -d "$run/ergon-drive.XXXXXX"); trap 'rm -rf "$d"' EXIT
  printf '%s' "$old" > "$d/old"; printf '%s' "$new" > "$d/new"
  echo "sudo will now ask for your password to change the key on $dev." >&2
  sudo cryptsetup luksChangeKey --batch-mode --key-file "$d/old" "$dev" "$d/new"
  echo "password changed on $dev"
}

case "${1:-list}" in
  list)   shift || true; cmd_list "$@" ;;
  format) shift; cmd_format "$@" ;;
  passwd) shift; cmd_passwd "$@" ;;
  -h|--help|help) sed -n '2,/^set -/p' "$0" | sed 's/^# \{0,1\}//' | grep -v -e '^set ' -e '^ergon:' ;;
  *) echo "usage: ergon drive list [--why] | format [DEVICE] | passwd [DEVICE]" >&2; exit 2 ;;
esac
