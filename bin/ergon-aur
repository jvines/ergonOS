#!/usr/bin/env bash
# ergon:summary=Build, rebuild and check the AUR packages this machine installs
# ergon:group=system
# ergon:args=<pkgname> | --rebuild <pkgname> | --outdated
#
# Clone, review, makepkg. No helper: the point is that a PKGBUILD gets looked at
# before it runs as you.
#
# This is a separate command because provisioning and `ergon-bundle` both need it,
# and the conflict handling below is the kind of thing that must exist in
# exactly one place.
#
# Three modes of the same small tool, not a package manager:
#
#   <pkgname>            build and install, unless it is already installed
#                        (and, if pinned, was built from that pin)
#   --rebuild <pkgname>  build and install even though it is
#   --outdated           say what has moved; build nothing, install nothing
#
# --rebuild exists because nothing else on an Arch machine ever rebuilds a
# foreign package. One is linked against the shared libraries of the day it was
# built; -Syu moves a soname, and the binary then dies at exec with "cannot open
# shared object file" and no other trace -- which for waybar-git is a desktop
# with no bar and no error anywhere a person would look. `ergon update` runs
# checkrebuild and calls this.
set -euo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
AURDIR="${AURDIR:-$HOME/.cache/aur}"
# What each package was actually BUILT from. Machine state, not config, so it
# lives beside the bundle ledger rather than in the repo -- and it is the only
# offline answer to "is what is installed the commit packages/aur reviewed",
# because a -git pkgver names the UPSTREAM commit while the pin is on the AUR
# repository that carries the PKGBUILD.
BUILT="${XDG_STATE_HOME:-$HOME/.local/state}/ergon/aur-builds"
mkdir -p "$AURDIR"

# The name becomes a path under $AURDIR and an argument to git and pacman, and
# ergon-bundle hands this whatever a bundle's aur file says. `../x` or `-x`
# must not get that far.
_is_pkg() { local LC_ALL=C; [[ $1 =~ ^[a-z0-9@_+][a-z0-9@._+-]{0,127}$ ]]; }

# The reviewed commit packages/aur records, if the package has one. Read off the
# package's OWN line: a continuation line of the comment above it begins with
# `#`, so $1 never matches a package name there.
_pin() {  # _pin <pkgname>
  awk -v p="$1" '$1 == p && match($0, /pin=[0-9a-f]{7,40}/) {
                   print substr($0, RSTART + 4, RLENGTH - 4) }' \
      "$ERGON/packages/aur" "$ERGON/packages/aur-hardware" 2>/dev/null || true
}

# A package the AUR has no repository for at all carries its PKGBUILD in this
# repo, under packages/pkgbuild/<name>/ (ERGON-79: fcitx5-omacento). It is
# still listed in packages/aur and still goes through everything below --
# makepkg -si, the conflict handling, the record of what it was built from,
# --rebuild after a soname bump, doctor's pin row. Three things differ, and
# only three:
#
#   * the recipe is copied out of the checkout instead of cloned from the AUR,
#     so nothing about it can change without a commit here;
#   * its pin is the UPSTREAM commit, since the PKGBUILD's own history is this
#     repo's. The PKGBUILD names it too (_commit=, which its source line
#     builds), and the two must agree or nothing is built: a pin that said one
#     commit while makepkg checked out another would be the claim-without-proof
#     a pin exists to prevent;
#   * --outdated asks upstream, through the bare clone makepkg keeps beside
#     the PKGBUILD, rather than the AUR.
LOCALPKG="$ERGON/packages/pkgbuild"
_local() { [ -f "$LOCALPKG/$1/PKGBUILD" ]; }
_commit_of() {  # _commit_of <pkgname> -> the _commit= its PKGBUILD builds
  sed -n "s/^_commit=['\"]\{0,1\}\([0-9a-f]\{7,40\}\).*/\1/p" "$LOCALPKG/$1/PKGBUILD" | head -1
}
# The bare clone makepkg keeps for a git source, named by the part of its
# source= entry before "::". makepkg clones it --mirror, so its HEAD is
# upstream's default branch as of the last fetch.
_mirror_of() {  # _mirror_of <pkgname> -> path, or nothing
  local n
  n=$(sed -n 's/^source=([^A-Za-z0-9_]*\([A-Za-z0-9_.+-]*\)::git+.*/\1/p' "$LOCALPKG/$1/PKGBUILD" | head -1)
  [ -z "$n" ] || printf '%s\n' "$AURDIR/$1/$n"
}

MODE=install
case "${1:-}" in
  --outdated) MODE=outdated ;;
  --rebuild)  MODE=rebuild; shift ;;
  -*)         echo "ergon-aur: unknown option: $1" >&2; exit 2 ;;
esac

if [ "$MODE" = outdated ]; then
  # Local first, and it cannot be wrong: `pacman -Qm` IS the foreign set.
  mapfile -t foreign < <(pacman -Qm 2>/dev/null | sort)
  [ "${#foreign[@]}" -gt 0 ] || { printf '   ok   no foreign packages\n'; exit 0; }

  # One RPC call for all of them. --max-time because this is also reached from
  # `ergon update`: an AUR that accepts the connection and then says nothing
  # would hang an upgrade that has already finished.
  q=""; for l in "${foreign[@]}"; do q="$q&arg[]=${l%% *}"; done
  reply=$(curl -fsS --max-time 10 "https://aur.archlinux.org/rpc/?v=5&type=info$q" 2>/dev/null) || reply=""
  # A reply that did not arrive, or did not parse, is not "everything is
  # current". Exit 2 so a caller can tell those two apart, and say which it is.
  if [ "$(printf '%s' "$reply" | jq -r '.type // empty' 2>/dev/null)" != multiinfo ]; then
    printf '   !!   the AUR did not answer — nothing below would have been a statement about what is current\n' >&2
    exit 2
  fi
  declare -A avail=()
  while IFS=$'\t' read -r n v; do
    [ -z "$n" ] || avail["$n"]="$v"
  done < <(printf '%s' "$reply" | jq -r '.results[] | "\(.Name)\t\(.Version)"' 2>/dev/null)

  for l in "${foreign[@]}"; do
    name=${l%% *}; have=${l##* }; pin=$(_pin "$name"); d="$AURDIR/$name"
    if [ -n "$pin" ]; then
      # A pinned package's AUR version says nothing about it: it is built from
      # the commit packages/aur records, not from whatever the packager last
      # pushed. What can be out of date is the PIN -- so print the two commands
      # that move it, because a pin nobody can advance gets deleted instead.
      #
      # A packages/pkgbuild one has no AUR repository to ask; its pin is an
      # upstream commit, so the same question goes to upstream's default
      # branch, in the clone makepkg made of it.
      ref=origin/master; what=PKGBUILD; where="the AUR"
      fix="put that commit in packages/aur"
      if _local "$name"; then
        d=$(_mirror_of "$name"); ref=HEAD; what=upstream; where=upstream
        fix="put that commit in packages/aur AND as _commit in packages/pkgbuild/$name/PKGBUILD"
      fi
      [ -z "$d" ] || [ ! -d "$d" ] || timeout 20 git -C "$d" fetch -q origin 2>/dev/null || true
      ahead=""; [ -z "$d" ] || ahead=$(git -C "$d" rev-list --count "$pin..$ref" 2>/dev/null || true)
      if [ -z "$ahead" ]; then
        printf '   ·    %s %s, pinned at %s — no clone under %s to compare against\n' \
          "$name" "$have" "${pin:0:7}" "$AURDIR"
      elif [ "$ahead" = 0 ]; then
        printf '   ok   %s %s, pinned at %s — %s has nothing newer\n' "$name" "$have" "${pin:0:7}" "$where"
      else
        printf '   ·    %s %s, pinned at %s — %s newer %s commit(s)\n' "$name" "$have" "${pin:0:7}" "$ahead" "$what"
        printf '        review: git -C %s log --oneline %s..%s\n' "$d" "${pin:0:7}" "$ref"
        printf '        then %s and: ergon aur --rebuild %s\n' "$fix" "$name"
      fi
    elif [ -z "${avail[$name]:-}" ]; then
      printf '   !!   %s %s is not in the AUR — nothing will ever update it\n' "$name" "$have"
    elif [ "$(vercmp "$have" "${avail[$name]}")" -lt 0 ]; then
      printf '   ·    %s %s → %s   (ergon aur --rebuild %s)\n' "$name" "$have" "${avail[$name]}" "$name"
    else
      printf '   ok   %s %s\n' "$name" "$have"
    fi
  done
  exit 0
fi

pkg="${1:?usage: ergon-aur <pkgname> | --rebuild <pkgname> | --outdated}"
_is_pkg "$pkg" || { echo "ergon-aur: '$pkg' is not a package name" >&2; exit 2; }

pin=$(_pin "$pkg")

# --rebuild differs from the plain form in exactly this: the package being
# installed already is the whole reason it was called.
#
# Unless it is pinned and was not built from that pin. The plain form is what
# provisioning calls, and a pin moved in packages/aur is what makes `ergon
# sync` re-provision -- so returning here before the pin was read meant the one
# path that reacts to a pin bump could not apply it, the stamp said it had, and
# doctor's aur-pins row warned forever. The comparison is doctor's own, so once
# this has run that row is green. A matching record still returns here:
# provisioning must not rebuild waybar-git every time. No record at all is a
# rebuild, once -- every machine built before the pins existed, which doctor
# already refuses to call ok.
if [ "$MODE" = install ] && pacman -Qi -- "$pkg" >/dev/null 2>&1; then
  was=$(awk -v p="$pkg" '$1 == p { print $2 }' "$BUILT" 2>/dev/null || true)
  if [ -z "$pin" ] || [ "${was:0:${#pin}}" = "$pin" ]; then
    printf '   ·   %s (already installed)\n' "$pkg"
    exit 0
  fi
  printf '   ·   %s is installed, but not from the commit packages/aur pins; rebuilding\n' "$pkg"
fi

if _local "$pkg"; then
  want=$(_commit_of "$pkg")
  if [ -z "$pin" ] || [ "$want" != "$pin" ]; then
    echo "ergon-aur: packages/aur pins $pkg at '${pin:-nothing}', but packages/pkgbuild/$pkg/PKGBUILD builds '${want:-no _commit}' -- they must name the same full commit" >&2
    exit 4
  fi
  # Copied, not built in place: makepkg writes src/, pkg/, the package and a
  # clone of the source into the directory it runs in, and that must not be
  # the checkout. Over whatever the last build left, so the clone is reused.
  mkdir -p "$AURDIR/$pkg"
  cp -f -- "$LOCALPKG/$pkg"/* "$AURDIR/$pkg/"
  cd "$AURDIR/$pkg"
  printf '   building %s from %s/PKGBUILD, upstream %s\n' "$pkg" "$LOCALPKG/$pkg" "${pin:0:12}"
else
  [ -d "$AURDIR/$pkg" ] || git clone -q -- "https://aur.archlinux.org/$pkg.git" "$AURDIR/$pkg"
  cd "$AURDIR/$pkg"
  if [ -n "$pin" ]; then
    # Fetch first: a pin is moved FORWARD by hand, so the commit named in
    # packages/aur is routinely one this clone has never seen. A checkout that
    # cannot find it is fatal -- building the previous pin instead would be
    # building a PKGBUILD nobody asked for while reporting success.
    timeout 60 git fetch -q origin 2>/dev/null || true
    git checkout -q --detach "$pin" 2>/dev/null \
      || { echo "ergon-aur: packages/aur pins $pkg at $pin, which is not in its AUR history" >&2; exit 4; }
  else
    # A package that WAS pinned and no longer is leaves this clone on a detached
    # HEAD, where `git pull --ff-only` fails quietly and every later build is
    # still the old pin.
    git symbolic-ref -q HEAD >/dev/null || git checkout -q master 2>/dev/null || true
    git pull -q --ff-only 2>/dev/null || true
  fi
  # Not paused for review: provisioning is non-interactive. Saying "review before
  # continuing" and then continuing was a promise this never kept.
  printf '   building %s from %s/PKGBUILD (read it there)\n' "$pkg" "$AURDIR/$pkg"
fi

# An AUR package that REPLACES a repo one cannot be installed by
# `makepkg -si --noconfirm` alone. pacman prompts
#
#     waybar-git and waybar are in conflict. Remove waybar? [y/N]
#
# and --noconfirm takes the default, No, then aborts with "unresolvable package
# conflicts". The build succeeds and the install does not, so the machine keeps
# the repo version and the only trace is one line in a log. That is exactly how
# waybar-git quietly failed to replace extra/waybar while the test suite went on
# asserting a bar that could not switch workspaces.
#
# Read the conflicts from the PKGBUILD's own declaration rather than from a list
# here that would go stale.
for c in $(makepkg --printsrcinfo 2>/dev/null | awk -F' = ' '$1 ~ /conflicts$/ { print $2 }'); do
  if [ "$c" != "$pkg" ] && pacman -Qq -- "$c" >/dev/null 2>&1; then
    # Bundles may not replace packages. waybar-git replacing waybar was
    # reviewed as part of provisioning; a bundle's AUR line displacing a base
    # package is something nobody looked at.
    if [ "${ERGON_AUR_NO_REPLACE:-0}" = 1 ]; then
      printf '   !!   %s would replace installed %s; bundles may not replace packages\n' "$pkg" "$c" >&2
      exit 3
    fi
    printf '   removing %s, which %s replaces\n' "$c" "$pkg"
    sudo pacman -Rdd --noconfirm "$c" || true
  fi
done

# -f, because $AURDIR/$pkg is kept between builds and makepkg refuses outright
# -- "A package has already been built. (use -f to overwrite)" -- when a tarball
# of the same pkgver is still sitting in it. A rebuild after a soname bump
# produces exactly that: the same pinned commit, built against new libraries. So
# without -f the one rebuild this tool exists to perform is the one that cannot
# run, `ergon update` warns and moves on, and checkrebuild names the package
# again on every upgrade forever.
makepkg -si --noconfirm --force

# What this build actually came from. `ergon doctor` compares it against the pin
# in packages/aur, which is how moving a pin forward becomes a visible "rebuild
# this" rather than an edit to a file nobody re-reads.
#
# For a packages/pkgbuild package that is the _commit its source line names:
# makepkg checks out exactly that commit or fails above, and it was refused
# unless it equals the pin. NOT `git rev-parse HEAD` here, which in a directory
# that is no repository answers for whatever repository encloses it -- a $HOME
# kept in git would have been recorded as the build.
if _local "$pkg"; then from=$(_commit_of "$pkg"); else from=$(git rev-parse HEAD); fi
mkdir -p "$(dirname "$BUILT")"
{ awk -v p="$pkg" '$1 != p' "$BUILT" 2>/dev/null || true
  printf '%s %s\n' "$pkg" "$from"; } | LC_ALL=C sort > "$BUILT.new"
mv -- "$BUILT.new" "$BUILT"
