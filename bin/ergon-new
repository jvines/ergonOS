#!/usr/bin/env bash
# ergon:summary=Scaffold a project: locked env, LSP, git, and the directories
# ergon:group=data
# ergon:args=<name> [--template bare|analysis|paper] [--lang python|r] [--here]
# ergon:help=native
#
# The twenty minutes between having an idea and running code, removed.
#
# What you get, and why each piece is there rather than left to taste:
#   pyproject.toml + uv.lock   the lockfile is what ships to a cluster node and
#                              what a reviewer needs; an environment without one
#                              is not reproducible, it is just working today
#   pyrightconfig.json         pointed at .venv, so imports resolve in any
#                              editor. Without it the language server resolves
#                              against the system python and underlines every
#                              import in your own project
#   .vscode/extensions.json    what VS Code offers to install on first open:
#                              basedpyright, which reads the file above, rather
#                              than Pylance, which Open VSX does not carry
#   data/ gitignored           data is not source. Committing it is how repos
#                              reach 4 GB and stop cloning
#   scratch/ gitignored        the place for things you will not delete, kept
#                              out of backup and out of history
#   figures/ tracked           they are the output you reason about, and
#                              ergon-fig stamps their provenance
#   refs.bib                   ergon-cite appends here
#
# --lang r scaffolds the same shape around R instead: R/ for source, renv for
# the lockfile, an .Rproj. renv is to an R project what uv.lock is to this one,
# and it is what an R user already knows -- a shared site library would be the
# thing they had to learn, and the thing that goes stale.
set -euo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
TEMPLATE=bare
LANG_=python
HERE=0
NAME=""
while [ $# -gt 0 ]; do
  case "$1" in
    --template) TEMPLATE="${2:?--template needs a name}"; shift 2 ;;
    --lang)     LANG_="${2:?--lang needs python or r}"; shift 2 ;;
    --here)     HERE=1; shift ;;
    -h|--help)  sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)         echo "ergon-new: unknown flag $1" >&2; exit 2 ;;
    *)          NAME="$1"; shift ;;
  esac
done
[ -n "$NAME" ] || { echo "usage: ergon new <name> [--template bare|analysis|paper]" >&2; exit 2; }

case "$LANG_" in
  python|r) ;;
  *) echo "ergon-new: unknown language '$LANG_' (python|r)" >&2; exit 2 ;;
esac

case "$TEMPLATE" in
  bare)     DEPS='"numpy", "scipy", "matplotlib"'; RDEPS='' ;;
  analysis) DEPS='"numpy", "scipy", "matplotlib", "pandas", "arviz", "corner"'
            RDEPS='tidyverse' ;;
  paper)    DEPS='"numpy", "scipy", "matplotlib", "pandas"'
            RDEPS='tidyverse' ;;
  *) echo "ergon-new: unknown template '$TEMPLATE' (bare|analysis|paper)" >&2; exit 2 ;;
esac

UV=""
if [ "$LANG_" = python ]; then
  for p in "$HOME/.local/bin/uv" /usr/local/bin/uv /opt/homebrew/bin/uv /usr/bin/uv; do
    [ -x "$p" ] && { UV="$p"; break; }
  done
  [ -n "$UV" ] || { echo "ergon-new: uv not found (it is in packages/pacman)" >&2; exit 1; }
else
  command -v R >/dev/null 2>&1 \
    || { echo "ergon-new: R not found -- run: ergon bundle add r" >&2; exit 1; }
fi

if [ "$HERE" = 1 ]; then
  DIR="$PWD"
else
  DIR="$PWD/$NAME"
  [ -e "$DIR" ] && { echo "ergon-new: $DIR already exists" >&2; exit 1; }
  mkdir -p "$DIR"
fi
cd "$DIR"
if [ "$LANG_" = python ]; then
  mkdir -p data figures scratch src/"${NAME//-/_}"
else
  mkdir -p data figures scratch R
fi

if [ "$LANG_" = python ]; then
cat > pyproject.toml <<TOML
[project]
name = "${NAME}"
version = "0.1.0"
description = ""
requires-python = ">=3.13"
dependencies = [$DEPS]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/${NAME//-/_}"]
TOML

# The LSP config. Editor-agnostic on purpose: pyright is what most language
# servers use under the hood, and pointing it at .venv is the one setting that
# makes imports resolve. Doing it once here beats doing it per editor forever.
# VS Code included: the basedpyright extension recommended below reads this
# file, and sets python.languageServer to None itself, so no settings.json.
cat > pyrightconfig.json <<'JSON'
{
  "venvPath": ".",
  "venv": ".venv",
  "include": ["src", "."],
  "exclude": ["data", "scratch", ".venv", "**/__pycache__"],
  "typeCheckingMode": "basic"
}
JSON
fi

# Recommended, never installed: VS Code offers these on first open, and the
# file is inert without it. An extension ergon installed would sit in
# ~/.vscode-oss where the bundle ledger cannot see it. Every ID here installed
# from Open VSX with `code --install-extension` on 1.138; ms-python.python's
# pack also names Pylance, which is not there and is skipped without an error.
case "$LANG_" in
  python) EXTS=(detachhead.basedpyright charliermarsh.ruff ms-python.python ms-python.debugpy
                ms-toolsai.jupyter marimo-team.vscode-marimo) ;;
  r)      EXTS=(REditorSupport.r) ;;
esac
# Only if absent: under --here, a project's own list is its author's.
mkdir -p .vscode
[ -e .vscode/extensions.json ] || {
  printf '{\n  "recommendations": [\n'
  printf '    "%s",\n' "${EXTS[@]}" | sed '$ s/,$//'
  printf '  ]\n}\n'; } > .vscode/extensions.json

cat > .gitignore <<'GIT'
# Data is not source. Committing it is how a repo reaches 4 GB and stops
# cloning; keep it reproducible or keep it in the archive, not in history.
data/
scratch/

.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# renv keeps the LOCKFILE in git and the library out of it: renv.lock is what
# reproduces the project, renv/library is a few hundred MB of compiled objects
# for one machine's architecture.
renv/library/
renv/local/
renv/staging/
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# LaTeX build products
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
GIT

touch refs.bib
if [ "$LANG_" = python ]; then
  SRCLINE='- `src/` the package'
  touch "src/${NAME//-/_}/__init__.py"
else
  SRCLINE='- `R/` the source'
fi
printf '# %s\n\nScaffolded by `ergon new`.\n\n%s\n- `data/` inputs, gitignored\n- `figures/` outputs, tracked, provenance-stamped by ergon-fig\n- `scratch/` things you will not delete, ignored and not backed up\n' "$NAME" "$SRCLINE" > README.md

# The R project, where uv's job is renv's. DESCRIPTION rather than a stray
# library() call in a source file: it is where R declares dependencies, and it
# is what renv's explicit snapshot mode reads, so `renv::install()` needs no
# argument and the declaration lives somewhere a human looks.
if [ "$LANG_" = r ]; then
  cat > DESCRIPTION <<DESC
Package: ${NAME//-/.}
Type: Project
Title: ${NAME}
Version: 0.1.0
Description: Scaffolded by ergon new.
Encoding: UTF-8
DESC
  [ -n "$RDEPS" ] && printf 'Imports:\n    %s\n' "$RDEPS" >> DESCRIPTION

  # Read by RStudio and by Positron. Harmless without either, and it is the
  # file an R user looks for to know the directory is a project.
  cat > "${NAME}.Rproj" <<'RPROJ'
Version: 1.0

RestoreWorkspace: No
SaveWorkspace: No
AlwaysSaveHistory: No

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8
RnwWeave: knitr
LaTeX: pdfLaTeX
RPROJ
fi

if [ "$TEMPLATE" = paper ]; then
  mkdir -p paper
  printf '%% Scaffolded by `ergon new --template paper`.\n%% ergon-cite appends to ../refs.bib\n\\documentclass{article}\n\\begin{document}\n\n\\bibliography{../refs}\n\\end{document}\n' > paper/ms.tex
fi

printf '   ok  %s/\n' "$DIR"
if [ "$LANG_" = python ]; then
  "$UV" lock >/dev/null 2>&1 && printf '   ok  uv.lock (this is what ships to a node)\n' \
    || printf '   !!  uv lock failed — run it by hand once you have network\n'
  "$UV" sync --quiet >/dev/null 2>&1 && printf '   ok  .venv\n' || true
else
  # bare=TRUE on purpose. renv's default scans for dependencies and installs
  # them, and on Arch every CRAN package is a source build -- a scaffold that
  # silently starts a forty-minute tidyverse compile is not a scaffold. This
  # writes renv.lock, renv/activate.R and .Rprofile in about a second; the
  # install is the user's next command, made explicit below.
  #
  # renv itself comes from R's own user library, installed here if absent.
  # That is one package through R's standard mechanism -- deliberately not a
  # distro-managed site library, which is the whole point of doing it this way.
  if R --vanilla -q -s -e 'if (!requireNamespace("renv", quietly = TRUE)) install.packages("renv", repos = "https://cloud.r-project.org"); renv::init(bare = TRUE, restart = FALSE); renv::settings$snapshot.type("explicit")' >/dev/null 2>&1 && [ -f renv/activate.R ]; then
    # Note what this did and did NOT do. `init(bare = TRUE)` writes
    # renv/activate.R, .Rprofile and renv/settings.json; it does not write
    # renv.lock, because a lockfile is a record of an installed library and
    # nothing is installed yet. Saying "ok renv.lock" here would name a file
    # that is not on disk, which is the shape of bug this repo keeps finding.
    printf '   ok  renv (snapshot after the install writes renv.lock)\n'
  else
    printf '   !!  renv init failed — run it by hand once you have network\n'
  fi
fi

if command -v git >/dev/null && [ ! -d .git ]; then
  git init -q
  git add -A && git -c user.email=noreply -c user.name=ergon commit -qm "scaffold: $NAME ($TEMPLATE, $LANG_)" 2>/dev/null || true
  printf '   ok  git initialised\n'
fi
if [ "$LANG_" = python ]; then
  printf '\n   next:  ergon kernel        register this env for notebooks\n'
  printf '          ergon cite <doi>    into refs.bib\n'
else
  printf "\n   next:  R -e 'renv::install()'   from DESCRIPTION. CRAN builds from\n"
  printf "                                  source here, so the first one is slow\n"
  printf "          R -e 'renv::snapshot()'  once it succeeds, to pin it\n"
  printf "          ergon cite <doi>          into refs.bib\n"
fi
