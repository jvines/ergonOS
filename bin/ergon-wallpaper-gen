#!/usr/bin/env bash
# ergon:summary=Compute wallpapers from simulations, in the active palette
# ergon:group=theme
# ergon:args=[--list | --all | --recolour | GENERATOR [SEED]]
#
# Wallpapers this machine computes for itself, rather than photographs it is
# not licensed to redistribute.
#
# That is not a workaround. A simulation renders at the panel's exact
# resolution, is coloured from whichever palette is active, is reproducible
# from a seed, and belongs to whoever ran it. A photograph is none of those:
# fixed size, fixed palette, and a licence that is almost never the
# repository's. Omarchy bundles 92 images with no attribution anywhere in its
# tree; this is the alternative rather than the compromise.
#
# The generators live in wallpaper/ and are plain numpy. Output goes to
#   $XDG_DATA_HOME/ergon/backgrounds/<palette>/<generator>-<seed>.png
# which ergon-wallpaper searches, so a generated image joins the --next cycle
# as soon as it exists.
set -euo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
GENDIR="$ERGON/wallpaper"
VENV="${PYFLEET_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/pyfleet}"
PY="$VENV/bin/python"

# The base pyfleet venv already carries numpy and matplotlib (packages/python),
# which is the whole reason the generators are restricted to those two: a
# wallpaper that needs its own dependency tree is a wallpaper that breaks.
[ -x "$PY" ] || { echo "no python at $PY — run: pyfleet ensure" >&2; exit 1; }

# A generator is a module that defines generate(). Not every module in
# wallpaper/ is one: lib.py and render.py never were, and shared helpers
# (pen.py, the vector pen behind the line-art generators) arrived later.
# Excluding by name would need updating for every new helper, and missing one
# makes --all try to render a module that cannot, so the test is the contract
# itself.
_generators() {
  grep -l '^def generate(' "$GENDIR"/*.py 2>/dev/null \
    | sed 's#.*/##; s/\.py$//' | sort
}

# The palette resolves exactly as it does in ergon-theme and ergon-wallpaper,
# so a generated image is filed under the palette that coloured it.
#
# A FUNCTION, because this run does not keep the answer it started with. The
# expensive work is done under a lock, and whoever holds that lock serves
# whichever palette is current when it gets there -- see _recolour().
PALETTE_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ergon/palette"
_resolve_palette() {
  local _want
  if [ -n "${ERGON_PALETTE:-}" ]; then _want="$ERGON_PALETTE"
  elif [ -f "$PALETTE_STATE" ];   then _want=$(cat "$PALETTE_STATE")
  else                                 _want=cool
  fi
  case "$_want" in
    /*|./*|../*) PALETTE="$_want" ;;
    *)           PALETTE="$ERGON/theme/$_want.env" ;;
  esac
  # Refuse, as ergon-theme and ergon-wallpaper do. This fell back to cool.env,
  # which here is worse than a wrong colour: OUTDIR is named after PAL_NAME, so
  # an unresolvable palette rendered cool-coloured images and FILED THEM UNDER
  # cool, where they then look like a legitimate cache for a palette nobody
  # asked for.
  [ -f "$PALETTE" ] || {
    echo "no palette '$_want' (try: ergon theme --list)" >&2; return 1
  }
  PAL_NAME=$(basename "$PALETTE" .env)
  OUTDIR="${XDG_DATA_HOME:-$HOME/.local/share}/ergon/backgrounds/$PAL_NAME"
}
_resolve_palette || exit 1

# Fields are kept, and they are PALETTE-INDEPENDENT.
#
# A generator computes a scalar density; the palette only decides how that
# density becomes colour. So the minutes of simulation are spent ONCE and every
# palette is served from the same field in about a second -- which is what
# makes `--recolour` on a palette switch possible at all. Without it, keeping
# nine backgrounds in step with nineteen palettes would be 171 simulations.
FIELDDIR="${XDG_DATA_HOME:-$HOME/.local/share}/ergon/fields"

# Rendered ABOVE the panel, on purpose, and capped at 4K.
#
# A wallpaper generated at exactly the panel's resolution has no headroom: it
# is correct on that monitor and soft on any larger one, and it cannot survive
# being downscaled with a decent filter because there is nothing to downscale.
# Rendering with a 3840-pixel long edge and letting the compositor scale down
# gives every panel a clean image -- downsampling is cheap and always improves
# an image, upsampling never does.
#
# 4K rather than 8K: an 8K frame is four times the pixels, four times the
# render time and about 70 MB on disk, and once it is downscaled to a laptop
# panel the difference from 4K is not visible. The extra cost is real and the
# gain is not.
#
# The ASPECT comes from the panel, not from a fixed 16:9, because a 16:10
# laptop showing a 16:9 image either crops the structure or pillarboxes it.
# Only the aspect is taken from the monitor; the size is ours.
LONG_EDGE=${ERGON_WALLPAPER_LONG_EDGE:-3840}
# The panel itself, kept separately from the render target: masters are 4K,
# re-coloured copies are panel-sized, and conflating the two is how a palette
# switch ends up colouring 9.2M pixels to show 1M of them.
PANEL=""
if [ -n "${ERGON_WALLPAPER_SIZE:-}" ]; then
  SIZE="$ERGON_WALLPAPER_SIZE"
elif command -v hyprctl >/dev/null 2>&1 \
     && _panel=$(hyprctl monitors -j 2>/dev/null \
                 | jq -r 'max_by(.width * .height) | "\(.width)x\(.height)"' 2>/dev/null) \
     && [ -n "$_panel" ] && [ "$_panel" != "null" ]; then
  PANEL="$_panel"
  _pw=${_panel%x*}; _ph=${_panel#*x}
  # Never render SMALLER than the panel, which would be upscaled on display.
  if [ "$_pw" -ge "$LONG_EDGE" ]; then
    SIZE="$_panel"
  else
    SIZE="${LONG_EDGE}x$(( LONG_EDGE * _ph / _pw ))"
  fi
  echo "  panel ${_panel}, rendering at $SIZE for downsampling"
else
  # No compositor to ask -- provisioning over ssh, or a first run before the
  # session exists. 16:10, because that is what this OS's reference machine is.
  SIZE="${LONG_EDGE}x$(( LONG_EDGE * 10 / 16 ))"
fi

_render() {
  local gen="$1" seed="${2:-0}"
  mkdir -p "$OUTDIR" "$FIELDDIR"
  # --save-prepared alongside --save-field, because this is the only command in
  # the tree that ever creates a field, and a field without its prepared entry
  # means the NEXT palette switch has to bake all of them -- which is the
  # two-minute lock hold that starved every other palette of its backgrounds.
  mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/ergon/prepared"
  "$PY" "$GENDIR/render.py" \
    --generator "$gen" --palette "$PALETTE" \
    --size "$SIZE" --seed "$seed" \
    --save-field "$FIELDDIR/$gen-$seed-$SIZE.npy" \
    --save-prepared "${XDG_DATA_HOME:-$HOME/.local/share}/ergon/prepared/$gen-$seed.npz" \
    --out "$OUTDIR/$gen-$seed.png"
}

# Colour every cached field into the ACTIVE palette, skipping what is already
# current. Seconds per image against minutes to simulate one.
# Is the palette this run was started for still the one in use?
#
# Cycling palettes starts a re-colour per switch, and a slow one from an
# EARLIER palette will otherwise finish last and apply its own image over the
# current one -- the desktop visibly reverting to the previous colours a few
# seconds after changing. Every step checks, so a superseded run stops at the
# next image instead of finishing work nobody wants.
_still_current() {
  # A palette named explicitly is always "still current": the caller asked for
  # THAT one, and the state file describes the desktop rather than this run.
  # Without this, `ERGON_PALETTE=bone ergon-wallpaper-gen --recolour` -- the way
  # to fill in a palette that was starved of backgrounds, without switching the
  # desktop to it -- gave up immediately, because the desktop was on something
  # else. Which is the whole point of naming it.
  if [ -n "${ERGON_PALETTE:-}" ]; then return 0; fi
  local now
  now=$(cat "$PALETTE_STATE" 2>/dev/null || echo cool)
  [ "$(basename "$now" .env)" = "$PAL_NAME" ]
}

# Is this palette the one the DESKTOP is showing? A different question from
# _still_current, and only this one may put an image on screen. They were the
# same test, so a run for a palette named on the command line would have
# repainted the background of a session sitting on another palette.
_is_on_screen_palette() {
  local now
  now=$(cat "$PALETTE_STATE" 2>/dev/null || echo cool)
  [ "$(basename "$now" .env)" = "$PAL_NAME" ]
}

_recolour() {
  local gen seed fsize f base

  # One at a time. flock is not about corruption -- two runs write different
  # palettes' files -- but about not having four of them competing for the CPU
  # of a machine whose desktop is meant to stay responsive.
  local lock="${XDG_RUNTIME_DIR:-/tmp}/ergon-recolour.lock"
  # WAIT for the lock, and KEEP waiting while this palette is still the one in
  # use. `flock -w 120 || return 0` was a silent no-op dressed as a wait: a full
  # pass measured 119.4s in the VM, so a switch landing during one timed out at
  # the finish line and returned having generated nothing -- and nothing ever
  # came back for it. Measured, on chiki, 2026-09-24: of nineteen palettes, six
  # had zero backgrounds, four had two or nine, three had the full sixty-nine.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$lock"
    local _waited=0
    until flock -w 20 9; do
      _waited=$((_waited + 20))
      # Give up only when this palette is no longer wanted -- then the run that
      # IS current owns the problem, and a second worker would only fight it.
      _still_current || { echo "  another recolour has the lock and the palette has moved on"; return 0; }
      [ "$_waited" -ge 300 ] && { echo "  gave up waiting for the recolour lock after ${_waited}s" >&2; return 0; }
      echo "  waiting for another recolour (${_waited}s)"
    done
  fi

  # WHOEVER HOLDS THE LOCK SERVES WHOEVER IS CURRENT.
  #
  # This run resolved a palette at startup and then spent its life asking
  # whether it was still wanted -- and answering "no" by doing nothing at all,
  # before even creating the output directory. Every palette flicked past during
  # a comparison got exactly that: no directory, no images, and no second
  # chance. Inverted here: take the lock first, then ask what to paint, and if
  # the answer changes while painting, paint the new one rather than exiting.
  local _rounds=0
  while :; do
    _resolve_palette || return 1
    _recolour_once
    _rounds=$((_rounds + 1))
    _still_current && break
    if [ "$_rounds" -ge 4 ]; then
      echo "  the palette is still moving after $_rounds rounds; leaving the rest to the next switch"
      break
    fi
  done
}

_recolour_once() {
  local made=0 gen seed fsize f base
  [ -d "$FIELDDIR" ] || { echo "  no cached fields yet"; return 0; }
  mkdir -p "$OUTDIR"
  # The one currently on screen FIRST. Re-colouring the whole set takes as long
  # as it takes, but the user is looking at ONE background and it should follow
  # the palette immediately; the rest can arrive while they carry on.
  local first="" want
  want=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/ergon/background" 2>/dev/null || true)
  case "$want" in */*) want=$(basename "$want" .png) ;; *) want="" ;; esac
  [ -n "$want" ] && first=$(ls "$FIELDDIR"/"$want"-*.npy 2>/dev/null | head -1)

  # The PREPARED cache: lib.prepare()'s output, which is everything about an
  # image that the palette has nothing to do with.
  #
  # This loop used to call render.py once per background, and render.py redid
  # the whole palette-independent half every time: open the field, downsample
  # it, run SOFTEN's Gaussian, normalise, run HUE_SMOOTH's two more. 46 of the
  # 61 generators ask for the first and 47 for the second, so that was the
  # normal path, and it is ALL the same answer for every palette.
  #
  # Measured per image: 1.9s that way; 0.26s of it preparation, 0.17s the
  # actual palette work, and a further 1.1s of it PYTHON STARTUP, because one
  # process per image imports matplotlib sixty-nine times. Hence both changes
  # below -- cache the preparation, and do the colouring in ONE process.
  PREPDIR="${XDG_DATA_HOME:-$HOME/.local/share}/ergon/prepared"
  mkdir -p "$PREPDIR"

  # Bake anything not cached yet, from the field, once ever. This is the only
  # step that still reads a field, and after it a palette switch never does.
  for f in $(ls "$FIELDDIR"/*.npy 2>/dev/null); do
    [ -e "$f" ] || continue
    base=$(basename "$f" .npy)              # <gen>-<seed>-<WxH>
    gen=${base%-*-*}; seed=${base#"$gen"-}; seed=${seed%-*}
    _generators | grep -qx "$gen" || continue
    [ -s "$PREPDIR/$gen-$seed.npz" ] && continue
    # A switch, mid-bake. BREAK rather than return: everything baked so far is
    # kept (the prepared cache is palette-independent, so it is never wasted),
    # and the caller re-resolves and comes straight back for whoever is current
    # now. Returning here is what left a palette with no directory at all.
    _still_current || break
    # nice + ionice: this is bulk work that must never make the session it is
    # decorating feel slow. Eight 4K matplotlib renders will saturate a laptop
    # -- measured by doing exactly that inside the test VM and making its
    # shells crawl -- and none of it is urgent.
    # At the PANEL size, not the field's 4K: a re-coloured background is for
    # showing now, and the cache only has to serve what will be shown.
    nice -n 19 ionice -c3 "$PY" "$GENDIR/render.py" \
      --generator "$gen" --palette "$PALETTE" \
      --size "${PANEL:-$SIZE}" --seed "$seed" \
      --from-field "$f" --save-prepared "$PREPDIR/$gen-$seed.npz" \
      --out "$OUTDIR/$gen-$seed.png" >/dev/null && made=$((made+1))
  done

  if [ "$made" -gt 0 ]; then echo "  baked $made new prepared field(s)"; fi

  # Superseded during the bake: go back to the caller, which re-resolves and
  # runs again for the palette that is current now. Doing the 120-second full
  # pass for a palette nobody is looking at is exactly what made the next one
  # wait out `flock -w 120` and give up.
  _still_current || return 0

  # THE ONE BEING LOOKED AT, on its own and first.
  #
  # Re-colouring the whole set takes as long as it takes, but the user is
  # looking at ONE background and it should follow the palette immediately;
  # the rest can arrive while they carry on. --only is what makes that a
  # half-second rather than a place in a queue of sixty-nine.
  if [ -n "$want" ] && [ -s "$PREPDIR/$want.npz" ] && _still_current; then
    if nice -n 19 ionice -c3 "$PY" "$GENDIR/recolour.py" \
         --palette "$PALETTE" --cache "$PREPDIR" --out "$OUTDIR" \
         --only "$want" >/dev/null 2>&1; then
      command -v ergon-wallpaper >/dev/null 2>&1 && _is_on_screen_palette \
        && ergon-wallpaper --set "$OUTDIR/$want.png" >/dev/null 2>&1 || true
    fi
  fi

  # And the rest, in ONE process rather than one per image.
  #
  # --expect/--palette-state make that process INTERRUPTIBLE, which is the
  # difference between this working and not. Measured in the VM: 69 images in
  # 119.4 seconds, against the `flock -w 120` above -- so every switch arriving
  # during a full pass waited out the entire set and then timed out having done
  # nothing, and its palette ended up with an empty directory. Now the holder
  # stops within one image of a switch and hands the lock over.
  local _rc=0
  nice -n 19 ionice -c3 "$PY" "$GENDIR/recolour.py" \
    --palette "$PALETTE" --cache "$PREPDIR" --out "$OUTDIR" \
    --expect "$PAL_NAME" --palette-state "$PALETTE_STATE" | sed 's/^/  /' || _rc=$?
  [ "$_rc" = 0 ] || echo "  the recolour exited $_rc; see above" >&2

  # N of M, out loud. The count was computed and dropped on the floor before,
  # and the only way to find out that a palette had two backgrounds and another
  # had sixty-nine was to cycle through them and notice. A palette short of the
  # prepared set is a fact this script knows and should say.
  local _have _want
  _have=$(find "$OUTDIR" -maxdepth 1 -name '*.png' 2>/dev/null | wc -l)
  _want=$(find "$PREPDIR" -maxdepth 1 -name '*.npz' 2>/dev/null | wc -l)
  echo "  $_have of $_want backgrounds for $PAL_NAME in $OUTDIR"

  # Put the equivalent background back on screen: the user was looking at, say,
  # lorenz, and after a palette switch they should still be looking at lorenz
  # rather than at the fallback gradient.
  local prev
  prev=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/ergon/background" 2>/dev/null || true)
  case "$prev" in
    */*) prev=$(basename "$prev") ;;
    *)   prev="" ;;
  esac
  if [ -n "$prev" ] && [ -s "$OUTDIR/$prev" ] && _is_on_screen_palette \
     && command -v ergon-wallpaper >/dev/null 2>&1; then
    ergon-wallpaper --set "$OUTDIR/$prev" >/dev/null 2>&1 || true
  fi
}

case "${1:---list}" in
  --recolour|--recolor)
    _recolour
    ;;
  --list)
    echo "  generators (palette: $PAL_NAME, size: $SIZE)"
    _generators | sed 's/^/     /'
    echo "  output: $OUTDIR"
    ;;
  --all)
    # One seed each. Rendering every seed of every generator is minutes of CPU
    # for images nobody asked for; --next through them and generate more of
    # whichever earns it.
    while IFS= read -r g; do
      [ -n "$g" ] && _render "$g" "${2:-0}"
    done < <(_generators)
    ;;
  -h|--help|help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    _generators | grep -qx "$1" || {
      echo "no generator '$1' (have: $(_generators | tr '\n' ' '))" >&2; exit 1
    }
    _render "$1" "${2:-0}"
    ;;
esac
