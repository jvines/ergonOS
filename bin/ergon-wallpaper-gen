#!/usr/bin/env bash
# ergon:summary=Compute wallpapers from simulations, in the active palette
# ergon:group=theme
# ergon:args=[--list | --all | GENERATOR [SEED]]
#
# Wallpapers this machine computes for itself, rather than photographs it is
# not licensed to redistribute.
#
# That is not a workaround. A simulation renders at the panel's exact
# resolution, is coloured from whichever palette is active, is reproducible
# from a seed, and belongs to whoever ran it. A photograph is none of those:
# fixed size, fixed palette, and a licence that is almost never the
# repository's. Omarchy bundles 92 images with no attribution anywhere in its
# tree; this is the alternative rather than the compromise.
#
# The generators live in wallpaper/ and are plain numpy. Output goes to
#   $XDG_DATA_HOME/ergon/backgrounds/<palette>/<generator>-<seed>.png
# which ergon-wallpaper searches, so a generated image joins the --next cycle
# as soon as it exists.
set -euo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
GENDIR="$ERGON/wallpaper"
VENV="${PYFLEET_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/pyfleet}"
PY="$VENV/bin/python"

# The base pyfleet venv already carries numpy and matplotlib (packages/python),
# which is the whole reason the generators are restricted to those two: a
# wallpaper that needs its own dependency tree is a wallpaper that breaks.
[ -x "$PY" ] || { echo "no python at $PY — run: pyfleet ensure" >&2; exit 1; }

_generators() {
  find -L "$GENDIR" -maxdepth 1 -name '*.py' \
    -not -name 'lib.py' -not -name 'render.py' -printf '%f\n' 2>/dev/null \
    | sed 's/\.py$//' | sort
}

# The palette resolves exactly as it does in ergon-theme and ergon-wallpaper,
# so a generated image is filed under the palette that coloured it.
_state="${XDG_STATE_HOME:-$HOME/.local/state}/ergon/palette"
if [ -n "${ERGON_PALETTE:-}" ]; then _want="$ERGON_PALETTE"
elif [ -f "$_state" ];          then _want=$(cat "$_state")
else                                 _want=cool
fi
case "$_want" in
  /*|./*|../*) PALETTE="$_want" ;;
  *)           PALETTE="$ERGON/theme/$_want.env" ;;
esac
[ -f "$PALETTE" ] || PALETTE="$ERGON/theme/cool.env"
PAL_NAME=$(basename "$PALETTE" .env)

OUTDIR="${XDG_DATA_HOME:-$HOME/.local/share}/ergon/backgrounds/$PAL_NAME"

# Rendered ABOVE the panel, on purpose, and capped at 4K.
#
# A wallpaper generated at exactly the panel's resolution has no headroom: it
# is correct on that monitor and soft on any larger one, and it cannot survive
# being downscaled with a decent filter because there is nothing to downscale.
# Rendering with a 3840-pixel long edge and letting the compositor scale down
# gives every panel a clean image -- downsampling is cheap and always improves
# an image, upsampling never does.
#
# 4K rather than 8K: an 8K frame is four times the pixels, four times the
# render time and about 70 MB on disk, and once it is downscaled to a laptop
# panel the difference from 4K is not visible. The extra cost is real and the
# gain is not.
#
# The ASPECT comes from the panel, not from a fixed 16:9, because a 16:10
# laptop showing a 16:9 image either crops the structure or pillarboxes it.
# Only the aspect is taken from the monitor; the size is ours.
LONG_EDGE=${ERGON_WALLPAPER_LONG_EDGE:-3840}
if [ -n "${ERGON_WALLPAPER_SIZE:-}" ]; then
  SIZE="$ERGON_WALLPAPER_SIZE"
elif command -v hyprctl >/dev/null 2>&1 \
     && _panel=$(hyprctl monitors -j 2>/dev/null \
                 | jq -r 'max_by(.width * .height) | "\(.width)x\(.height)"' 2>/dev/null) \
     && [ -n "$_panel" ] && [ "$_panel" != "null" ]; then
  _pw=${_panel%x*}; _ph=${_panel#*x}
  # Never render SMALLER than the panel, which would be upscaled on display.
  if [ "$_pw" -ge "$LONG_EDGE" ]; then
    SIZE="$_panel"
  else
    SIZE="${LONG_EDGE}x$(( LONG_EDGE * _ph / _pw ))"
  fi
  echo "  panel ${_panel}, rendering at $SIZE for downsampling"
else
  # No compositor to ask -- provisioning over ssh, or a first run before the
  # session exists. 16:10, because that is what this OS's reference machine is.
  SIZE="${LONG_EDGE}x$(( LONG_EDGE * 10 / 16 ))"
fi

_render() {
  local gen="$1" seed="${2:-0}"
  mkdir -p "$OUTDIR"
  "$PY" "$GENDIR/render.py" \
    --generator "$gen" --palette "$PALETTE" \
    --size "$SIZE" --seed "$seed" \
    --out "$OUTDIR/$gen-$seed.png"
}

case "${1:---list}" in
  --list)
    echo "  generators (palette: $PAL_NAME, size: $SIZE)"
    _generators | sed 's/^/     /'
    echo "  output: $OUTDIR"
    ;;
  --all)
    # One seed each. Rendering every seed of every generator is minutes of CPU
    # for images nobody asked for; --next through them and generate more of
    # whichever earns it.
    while IFS= read -r g; do
      [ -n "$g" ] && _render "$g" "${2:-0}"
    done < <(_generators)
    ;;
  -h|--help|help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    _generators | grep -qx "$1" || {
      echo "no generator '$1' (have: $(_generators | tr '\n' ' '))" >&2; exit 1
    }
    _render "$1" "${2:-0}"
    ;;
esac
