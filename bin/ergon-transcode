#!/usr/bin/env bash
# ergon:summary=Convert a video or image: mp4 for slides, webm, gif, mp3, png, jpg, webp
# ergon:group=media
# ergon:args=[FILE [TARGET] [WIDTH]]
# ergon:help=native
#
#   ergon transcode talk.mov mp4      H.264 + AAC, yuv420p so every slide viewer plays it
#   ergon transcode run.mp4 gif 720   a 12 fps palette gif, 720 px wide
#   ergon transcode fig.png webp 1600 resize to 1600 px wide as it converts
#
# With no FILE it asks for one (fzf over the current directory), and with no
# TARGET it offers the ones that fit the input. The result goes next to the
# input as <name>.<target>; an existing file is never overwritten (-1, -2...).
# Video and audio use ffmpeg, images use ImageMagick.
# shellcheck source=../lib/i18n.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/i18n.sh"
set -euo pipefail

die() { echo "ergon-transcode: $*" >&2; exit 1; }
case "${1:-}" in -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

in=${1:-}
[ -n "$in" ] || in=$(find . -maxdepth 3 -type f \( -iname '*.mp4' -o -iname '*.mov' -o -iname '*.mkv' -o -iname '*.webm' -o -iname '*.gif' -o -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | fzf --prompt='transcode > ') || exit 0
[ -f "$in" ] || die "no such file: $in"

mime=$(file -b --mime-type -- "$in")
case "$mime" in
  image/*) kind=image; opts="png jpg webp" ;;
  video/*|audio/*) kind=video; opts="mp4 webm gif mp3" ;;
  *) die "not a video or image: $mime" ;;
esac
to=${2:-}
[ -n "$to" ] || to=$(tr ' ' '\n' <<<"$opts" | fzf --prompt='to > ') || exit 0
grep -qw -- "$to" <<<"$opts" || die "a $kind cannot become $to (try: $opts)"
w=${3:-}
[[ -z "$w" || "$w" =~ ^[0-9]+$ ]] || die "width must be a number of pixels"

base=${in%.*}; out="$base.$to"; n=0
while [ -e "$out" ]; do n=$((n+1)); out="$base-$n.$to"; done

if [ "$kind" = image ]; then
  magick "$in" ${w:+-resize "${w}x"} "$out"
else
  vf=${w:+scale=$w:-2}
  case "$to" in
    mp4)  ffmpeg -nostdin -v error -i "$in" ${vf:+-vf "$vf"} -c:v libx264 -pix_fmt yuv420p -crf 20 -c:a aac "$out" ;;
    webm) ffmpeg -nostdin -v error -i "$in" ${vf:+-vf "$vf"} -c:v libvpx-vp9 -crf 32 -b:v 0 -c:a libopus "$out" ;;
    gif)  ffmpeg -nostdin -v error -i "$in" -vf "fps=12,${vf:+$vf,}split[a][b];[a]palettegen[p];[b][p]paletteuse" "$out" ;;
    mp3)  ffmpeg -nostdin -v error -i "$in" -vn -q:a 2 "$out" ;;
  esac
fi
echo "$out"
notify-send -a ergon-transcode -u low "$(_t Transcoded)" "$out" >/dev/null 2>&1 || true
