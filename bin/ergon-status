#!/usr/bin/env bash
# ergon:summary=The modes this session is in right now, for the bar and for you
# ergon:group=bar
# ergon:args=[--waybar | --click | --refresh | --poke]
#
# Which of these is on: a screen recording, do-not-disturb, stay-awake (ergon-awake,
# ERGON-83), a night-light tint,
# an `ergon watch` run, pending updates or unread Arch news. Each fails
# silently when forgotten -- a recording nobody stopped, a warm tint over a
# colormap being judged, toasts swallowed long after the talk ended -- so the
# bar shows each one, and only while it is on (ERGON-32).
#
#   ergon-status             one line per active mode, for a terminal
#   ergon-status --waybar    the same as waybar JSON: empty text hides the module
#   ergon-status --click     stop the loudest one: a recording, do-not-disturb, stay-awake
#   ergon-status --refresh   recount updates and news now (normally hourly)
#   ergon-status --poke      tell the bar to ask again, now
#
# Every probe asks the thing itself -- wf-recorder's process, mako's mode,
# hyprsunset's temperature, the user manager's scopes -- rather than a flag
# file a crashed toggle could leave behind. Updates are the exception: asking
# the mirrors takes seconds and the network, so their count is cached in
# $XDG_CACHE_HOME/ergon/updates and refreshed in the background once an hour.
#
# The bar is TOLD, not polling (ERGON-81). It ran this every 3 s -- bash plus
# pgrep, makoctl, hyprctl and systemctl, two processes a second for the whole
# session, to learn that nothing had changed. Every mode here is changed by
# something ergonOS runs (the DND, night-light and record keys, ergon-record,
# ergon-display, ergon watch, --click, --refresh), and each runs --poke, which
# sends waybar the module's signal. The module's 60 s interval is the backstop
# for a change made behind ergonOS's back: a bare makoctl, a wf-recorder that
# crashed.
set -euo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ergon/updates"
# hyprsunset starts at 6500K (hypr/common/autostart.lua). Anything else is a
# tint someone chose, and the point is to show that it is still on.
NEUTRAL=6500
# waybar/config.jsonc's custom/status has "signal": this number. waybar re-runs
# the module on SIGRTMIN+N; test-status.sh holds the two to each other.
SIGNAL=8
poke() { pkill -RTMIN+"$SIGNAL" -x waybar 2>/dev/null || true; }
# Before anything else, the stale-count check below included: a poke is sent
# from key binds and must cost one pkill.
[ "${1:-}" = --poke ] && { poke; exit 0; }

recording() { pgrep -x wf-recorder >/dev/null 2>&1; }
dnd()       { grep -qx do-not-disturb <<<"$(makoctl mode 2>/dev/null)"; }
# `hyprctl hyprsunset temperature` answers with the current temperature; an
# identity transform (SUPER+CTRL+N) or no hyprsunset at all reads as neutral.
tint() {
  local t
  t=$(grep -m1 -oE '^[0-9]+' <<<"$(hyprctl hyprsunset temperature 2>/dev/null)") || true
  [ -n "$t" ] && [ "$t" != "$NEUTRAL" ] && printf '%s' "$t"
}
awake()     { systemctl --user is-active --quiet ergon-awake.service 2>/dev/null || full; }
full()      { systemctl --user is-active --quiet ergon-awake-full.service 2>/dev/null; }
watches() {
  grep -c . <<<"$(systemctl --user list-units --no-legend --state=active 'ergon-watch-*.scope' 2>/dev/null)" || true
}

refresh() {
  mkdir -p "$(dirname "$CACHE")"
  local n=0 news=0
  if command -v checkupdates >/dev/null 2>&1; then
    n=$(grep -c . <<<"$(checkupdates 2>/dev/null)" || true)
  fi
  if command -v informant >/dev/null 2>&1 && ! informant check >/dev/null 2>&1; then
    news=1
  fi
  printf '%s %s\n' "$n" "$news" > "$CACHE.new" && mv -f "$CACHE.new" "$CACHE"
}

# Older than an hour, or missing: count again, detached, and show what is
# cached meanwhile. The bar polls every few seconds and must never wait on a
# mirror, nor start a second count while one is running.
stale() { [ ! -s "$CACHE" ] || [ -n "$(find "$CACHE" -mmin +60 2>/dev/null)" ]; }
if [ "${1:-}" != --refresh ] && stale && command -v flock >/dev/null 2>&1; then
  ( setsid flock -n "$CACHE.lock" "$0" --refresh </dev/null >/dev/null 2>&1 & ) || true
fi

case "${1:-}" in
  --refresh) refresh; poke; exit 0 ;;
  --click)
    # A recording is stopped by ergon-record, which pokes once wf-recorder has
    # actually exited; it is still finishing the file when this would.
    if recording; then exec ergon-record
    elif dnd; then makoctl mode -r do-not-disturb >/dev/null; poke
    elif awake; then ergon-awake off  # pokes the bar itself
    fi
    exit 0 ;;
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

text=() tip=() class=()
if recording; then text+=("󰑋"); tip+=("recording -- click to stop"); class+=(recording); fi
if dnd; then text+=("󰂛"); tip+=("do not disturb -- SUPER+CTRL+D to end it"); class+=(dnd); fi
if t=$(tint); then text+=("󰖔"); tip+=("night light at ${t}K"); class+=(tint); fi
if full; then text+=("󰅶"); tip+=("staying fully awake, lid included: no suspend -- SUPER+CTRL+SHIFT+I to end it"); class+=(awake-full)
elif awake; then text+=("󰅶"); tip+=("staying awake -- SUPER+CTRL+I to end it"); class+=(awake); fi
w=$(watches)
if [ "${w:-0}" -gt 0 ]; then text+=("󰔟 $w"); tip+=("$w ergon watch run(s)"); class+=(watch); fi
read -r upd news 2>/dev/null < "$CACHE" || { upd=0; news=0; }
if [ "${upd:-0}" -gt 0 ] || [ "${news:-0}" = 1 ]; then
  if [ "${news:-0}" = 1 ]; then tip+=("unread Arch news -- read it before ergon update"); fi
  if [ "${upd:-0}" -gt 0 ]; then tip+=("$upd package update(s) pending"); fi
  text+=("󰚰"); class+=(updates)
fi

if [ "${1:-}" != --waybar ]; then
  [ "${#tip[@]}" -gt 0 ] && printf '%s\n' "${tip[@]}"
  exit 0
fi

# JSON by hand, as ergon-temp does: every value here is built from fixed
# strings and numbers, so there is nothing to escape but the newlines.
join() { local IFS="$1"; shift; printf '%s' "$*"; }
cls=""
for c in "${class[@]}"; do cls="${cls:+$cls,}\"$c\""; done
printf '{"text":"%s","tooltip":"%s","class":[%s]}\n' \
  "$(join ' ' "${text[@]}")" "$(join $'\n' "${tip[@]}" | sed ':a;N;$!ba;s/\n/\\n/g')" "$cls"
