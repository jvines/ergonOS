#!/usr/bin/env bash
# ergon:summary=Mirror or extend to a projector, set mode, rotation, scale, text
# ergon:group=hardware
# ergon:args=present|mirror|extend [right|left]|mode WxH[@Hz]|modes|rotate 0|90|180|270|next|position XxY|scale +|-|cycle|save|text [N]
#
# Giving a talk used to mean editing Lua in front of the audience (ERGON-37).
#
#   ergon display present         mirror, and mako's do-not-disturb mode
#   ergon display mirror          every other output shows the internal one
#                                 (eDP-*), or the focused one on a desktop
#   ergon display extend          undo both
#   ergon display extend right    ... and put the other outputs to the right of
#                                 the internal one, else the first-connected screen (or left): the projector
#   ergon display mode WxH[@Hz]   a resolution and refresh rate the output offers
#   ergon display modes           ... and which those are
#   ergon display rotate 90       0, 90, 180, 270, or next
#   ergon display position XxY    where the output sits in the layout
#   ergon display scale +|-|cycle step the focused output through 1 1.25 1.5 1.6
#                                 1.75 2 3 4; cycle wraps (SUPER+CTRL+M)
#   ergon display save            keep the layout as it is now, across sessions
#   ergon display text [N]        the text size every surface is sized from
#
# OUTPUT (the second argument of mode, rotate, position) defaults to the
# focused output. Any change takes --save to keep it across sessions too.
#
# Every monitor change is `hyprctl eval`, which is Lua source the compositor
# runs (ergon explain desktop-config). So nothing reaches it that this script
# did not build from a closed vocabulary: output names come from the compositor
# and are refused unless they are plain connector names, modes come from the
# output's own list, scales from the list below, and a text size never goes
# near Lua -- ergon-theme validates it.
#
# What changed is also written to $XDG_RUNTIME_DIR/ergon/display.lua, which
# hypr/hyprland.lua re-reads on every load. `hyprctl reload` clears every
# monitor rule (ConfigManager.cpp, 0.56.2) and `ergon theme` reloads, so without
# it `text` would undo the mirror mid-talk. Runtime, not state, on purpose: a
# mirror must not outlive the session and ambush the next screen plugged into
# that port. --save and `save` write the same rule, minus the mirror, to
# $XDG_STATE_HOME/ergon/display.lua, which loads before it. (Not under
# ~/.config/ergon: that is yours, and nothing here may write it.) A rule is
# per connector name, and hosts/<host>/hyprland.lua still loads first.
set -euo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
SAVED="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ergon/display.lua"
PERSIST="${XDG_STATE_HOME:-$HOME/.local/state}/ergon/display.lua"

usage() { sed -n 's/^#   \{0,1\}ergon display/ergon display/p' "$0" >&2; exit 2; }
[ -n "${1:-}" ] || usage
SAVE="" ARGS=()
for a in "$@"; do if [ "$a" = --save ]; then SAVE=1; else ARGS+=("$a"); fi; done
set -- "${ARGS[@]}"
[ -n "${1:-}" ] || usage
if [ "$1" = text ]; then exec "$ERGON/bin/ergon-theme" --text ${2:+"$2"}; fi

command -v hyprctl >/dev/null && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] \
  || { echo "ergon display: not in a Hyprland session" >&2; exit 1; }

# eDP-1, HDMI-A-1, DP-3, Virtual-1, HEADLESS-2. A quote, bracket or backslash
# would be Lua source, so the name is refused rather than escaped.
name_ok() { [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "refusing output name '$1'" >&2; return 1; }; }

# The saved rule's output name, key first: a line per output, so a later change
# to the same output replaces it. "X" closed by its quote, so X never matches X2.
write_line() {  # FILE LINE
  local f=$1
  local key="hl.monitor({ output = \"$(sed 's/^[^"]*"\([^"]*\)".*/\1/' <<<"$2")\""
  mkdir -p "${f%/*}"
  { grep -vF "$key" "$f" 2>/dev/null || true; printf '%s\n' "$2"; } > "$f.new"
  mv -f "$f.new" "$f"
}

# What a saved rule keeps. A mirror is for this session and never outlives it.
persistable() {
  local l="${1/, mirror = \"*\"/}"
  [[ $l == *'", '* ]] || return 1
  printf '%s\n' "$l"
}

# rule_line OUTPUT [field=value ...]: one COMPLETE rule for OUTPUT -- mode,
# position, scale, transform, mirror as the compositor holds them now -- with
# the given fields replaced (an empty value drops the field). Complete, because
# a rule that names only the scale is a rule that also says "preferred mode,
# auto position" unless Hyprland merges, and that was never measured. Fields the
# compositor did not report are left out, which is also what keeps this usable
# against a stub. Every value is checked against the closed vocabulary below
# before it is Lua source.
rule_line() {
  local out=$1 mode pos scale tr mir kv line unmir=; shift
  IFS='|' read -r mode pos scale tr mir < <(hyprctl monitors all -j | jq -r --arg n "$out" '
    (map({key: (.id | tostring), value: .name}) | from_entries) as $ids
    | (map(select(.name == $n))[0] // {}) | [
        (if .width and .refreshRate then "\(.width)x\(.height)@\((.refreshRate * 100 | round) / 100)" else "" end),
        (if .x != null and .y != null then "\(.x)x\(.y)" else "" end),
        (if .scale then "\((.scale * 100 | round) / 100)" else "" end),
        (if (.transform // 0) != 0 then "\(.transform)" else "" end),
        (if (.mirrorOf // "none") != "none" then ($ids[.mirrorOf | tostring] // "") else "" end)
      ] | join("|")')
  for kv in "$@"; do
    case "$kv" in
      mode=*) mode=${kv#*=} ;; position=*) pos=${kv#*=} ;; scale=*) scale=${kv#*=} ;;
      transform=*) tr=${kv#*=} ;; mirror=*) mir=${kv#*=}; [ -n "$mir" ] || unmir=1 ;;
    esac
  done
  [[ -z $mode || $mode =~ ^[0-9]+x[0-9]+@[0-9.]+$ ]] || { echo "refusing mode '$mode'" >&2; return 1; }
  [[ -z $pos || $pos =~ ^-?[0-9]+x-?[0-9]+$ ]]       || { echo "refusing position '$pos'" >&2; return 1; }
  [[ -z $scale || $scale =~ ^[0-9.]+$ ]]             || { echo "refusing scale '$scale'" >&2; return 1; }
  [[ -z $tr || $tr =~ ^[0-3]$ ]]                     || { echo "refusing transform '$tr'" >&2; return 1; }
  [ -z "$mir" ] || name_ok "$mir"
  line="hl.monitor({ output = \"$out\""
  [ -z "$mode" ]  || line+=", mode = \"$mode\""
  [ -z "$pos" ]   || line+=", position = \"$pos\""
  [ -z "$scale" ] || line+=", scale = \"$scale\""
  [ -z "$tr" ]    || line+=", transform = $tr"
  [ -z "$mir" ]   || line+=", mirror = \"$mir\""
  # Hyprland merges a rule into the output's existing one (hl.monitor, 0.57), so
  # a rule that merely omits mirror leaves the mirror standing: say "" outright.
  [ -z "$unmir" ] || [ -n "$mir" ] || line+=", mirror = \"\""
  printf '%s })\n' "$line"
}

# set_rule OUTPUT field=value ...: now, and for every reload this session; with
# --save, for every session too. hyprctl's exit status only reflects a reply
# that starts "error:" (hyprctl/src/main.cpp, 0.56.2), and under set -e that
# status would end the script before saying why -- so the reply is the check:
# anything but "ok" is a refusal.
set_rule() {
  local line r p
  line=$(rule_line "$@") || return 1
  r=$(hyprctl eval "$line" 2>&1) || true
  [ "$r" = ok ] || { echo "hyprland refused ${line#hl.monitor(}: $r" >&2; return 1; }
  write_line "$SAVED" "$line"
  if [ -n "$SAVE" ] && p=$(persistable "$line"); then write_line "$PERSIST" "$p"; fi
}

# The focused output, or the one named: its JSON, and a plain name.
target() {
  local mon
  mon=$(hyprctl monitors -j | jq -c --arg n "${1:-}" 'map(select(($n == "" and .focused) or .name == $n))[0] // empty')
  [ -n "$mon" ] || { echo "no such output: ${1:-the focused one}" >&2; return 1; }
  name_ok "$(jq -r .name <<<"$mon")" && printf '%s\n' "$mon"
}

# Resolutions and refresh rates the output offers, as WxH@Hz. Only these are
# accepted, so a typo never reaches the compositor and a mode it would refuse
# is never offered.
modes() { jq -r '.availableModes | map(sub("Hz$"; "")) | unique_by(.) | .[]' <<<"$(target "${1:-}")"; }

mode() {  # WxH[@Hz] [OUTPUT]
  local mon name size hz pick
  [[ ${1:-} =~ ^([0-9]+x[0-9]+)(@([0-9.]+))?$ ]] || { echo "mode: want WxH or WxH@Hz" >&2; return 1; }
  size=${BASH_REMATCH[1]} hz=${BASH_REMATCH[3]}
  mon=$(target "${2:-}") || return 1
  name=$(jq -r .name <<<"$mon")
  pick=$(jq -r --arg s "$size" --arg h "$hz" '
    [.availableModes[] | sub("Hz$"; "") | split("@") | {s: .[0], h: ((.[1] | tonumber) + 0)}] | map(select(.s == $s)) as $c
    | (if $h == "" then $c[0]
       else (($c | map(select(.h == ($h | tonumber)))[0]) // ($c | map(select((.h | round) == ($h | tonumber | round)))[0])) end)
    | if . then "\(.s)@\(.h)" else empty end' <<<"$mon")
  [ -n "$pick" ] || { echo "$name has no ${1} mode (ergon display modes)" >&2; return 1; }
  set_rule "$name" mode="$pick" && echo "   $name: $pick"
}

rotate() {  # 0|90|180|270|next [OUTPUT]
  local mon name t
  mon=$(target "${2:-}") || return 1
  name=$(jq -r .name <<<"$mon")
  case "${1:-}" in
    0) t=0 ;; 90) t=1 ;; 180) t=2 ;; 270) t=3 ;;
    next) t=$(( ($(jq -r '.transform // 0' <<<"$mon") + 1) % 4 )) ;;
    *) echo "rotate: want 0, 90, 180, 270 or next" >&2; return 1 ;;
  esac
  set_rule "$name" transform="$t" && echo "   $name: rotated $((t * 90))"
}

position() {  # XxY [OUTPUT]
  local name
  [[ ${1:-} =~ ^-?[0-9]+x-?[0-9]+$ ]] || { echo "position: want XxY, e.g. 1920x0" >&2; return 1; }
  name=$(target "${2:-}" | jq -r .name) && [ -n "$name" ] || return 1
  set_rule "$name" position="$1" && echo "   $name: at $1"
}

# Write every connected output's rule as it stands: the way to keep what was
# arranged with the menu. A mirror is not kept (see persistable).
save() {
  local n p rc=0
  while IFS= read -r n; do
    name_ok "$n" || { rc=1; continue; }
    if p=$(persistable "$(rule_line "$n")"); then write_line "$PERSIST" "$p"; echo "   kept $n"; fi
  done < <(hyprctl monitors -j | jq -r '.[].name')
  return "$rc"
}

mirror() {
  local mons src t n=0 rc=0
  mons=$(hyprctl monitors -j)    # enabled outputs, not counting mirrors
  src=$(jq -r '(map(select(.name | startswith("eDP"))) + map(select(.focused)))[0].name // empty' <<<"$mons")
  [ -n "$src" ] && name_ok "$src" || { echo "no output to mirror" >&2; return 1; }
  while IFS= read -r t; do
    if name_ok "$t" && set_rule "$t" mirror="$src"; then echo "   $t mirrors $src"; n=$((n + 1)); else rc=1; fi
  done < <(jq -r --arg s "$src" '.[] | select(.name != $s) | .name' <<<"$mons")
  [ "$n" -gt 0 ] || [ "$rc" != 0 ] && return "$rc"
  hyprctl monitors all -j | jq -e 'any(.[]; .mirrorOf != "none")' >/dev/null \
    && { echo "   already mirrored"; return 0; }
  echo "only $src is connected: nothing to mirror onto" >&2; return 1
}

# The steps, as exact fractions. Hyprland will not take a scale that leaves a
# fractional logical pixel: it searches 1/120ths either side for one that does
# not, uses that, and puts up a red warning (Monitor.cpp, 0.56.2). Replaying
# that search: 3 on a 2560x1440 panel becomes 3.2, and 1.25 on 1366x768 becomes
# 1 -- a keypress that changes nothing but the warning. So a step the mode
# does not divide by is skipped here instead, by integer arithmetic: 1.5 and
# 1.75 stay in the list and drop out of every mode they do not divide.
STEPS="1:1:1 1.25:5:4 1.5:3:2 1.6:8:5 1.75:7:4 2:2:1 3:3:1 4:4:1"

scale() {
  local mon name w h cur pick="" first="" st dec num den
  mon=$(target) || return 1
  read -r name w h cur < <(jq -r '"\(.name) \(.width) \(.height) \(.scale * 100 | round)"' <<<"$mon")
  for st in $STEPS; do
    IFS=: read -r dec num den <<<"$st"
    (( (w * den) % num == 0 && (h * den) % num == 0 )) || continue
    [ -n "$first" ] || first=$st
    if [ "$1" != - ]; then
      [ $((100 * num / den)) -gt "$cur" ] && { pick=$st; break; }
    else
      [ $((100 * num / den)) -lt "$cur" ] && pick=$st
    fi
  done
  [ "$1" != cycle ] || [ -n "$pick" ] || pick=$first    # past the last step: back to the first
  [ -n "$pick" ] || { echo "$name (${w}x$h) is at the end of the steps that divide it evenly" >&2; return 1; }
  IFS=: read -r dec num den <<<"$pick"
  set_rule "$name" scale="$dec"
  echo "   $name: scale $dec ($((w * den / num))x$((h * den / num)))"
  xscale "$name" "$dec"
}

# XWayland draws at the monitor's pixel size (xwayland.force_zero_scaling, in
# looknfeel.lua.in), so what makes an X11 app readable is its own toolkit's
# scale: GDK_SCALE, an integer. The lowest monitor's, rounded, because an app
# can sit on any of them. Set for new clients: in the compositor, and in the
# user manager for anything launched by uwsm. [NAME SCALE] is the output that
# has just changed, whose new scale the compositor does not report yet.
xscale() {
  local n
  n=$(hyprctl monitors -j | jq -r --arg o "${1:-}" --arg s "${2:-}" '
    map(if .name == $o then .scale = ($s | tonumber) else . end) | map(.scale) | min // 1 | . + 0.5 | floor | if . < 1 then 1 else . end')
  [[ $n =~ ^[1-9]$ ]] || return 0
  hyprctl eval "hl.env(\"GDK_SCALE\", \"$n\")" >/dev/null 2>&1 || true
  systemctl --user set-environment "GDK_SCALE=$n" 2>/dev/null || true
}

# Everything but the first output goes beside it. Sizes are the logical ones,
# so a scaled or rotated output leaves exactly its width of room.
place() {  # right|left SOURCE
  hyprctl monitors all -j | jq -r --arg d "$1" --arg s "$2" '
    def lw: ((if ((.transform // 0) % 2) == 1 then .height else .width end) / (.scale // 1)) | round;
    (map(select(.name == $s))[0]) as $src
    | [.[] | select(.name != $s and .name != "FALLBACK" and (.disabled | not))] as $o
    | reduce $o[] as $m ({x: (if $d == "right" then ($src.x // 0) + ($src | lw) else ($src.x // 0) end), l: []};
        if $d == "right" then .l += ["\($m.name) \(.x)x\($src.y // 0)"] | .x += ($m | lw)
        else .x -= ($m | lw) | .l += ["\($m.name) \(.x)x\($src.y // 0)"] end)
    | .l[]'
}

case "$1" in
  mirror)  mirror ;;
  present)
    mirror
    makoctl mode -a do-not-disturb >/dev/null 2>&1 \
      && echo "   notifications hidden (do-not-disturb)" \
      || echo "   mako did not take do-not-disturb: notifications will show" >&2
    ergon-status --poke 2>/dev/null || true ;;   # the bar shows DND (ERGON-81)
  extend)
    rc=0
    case "${2:-}" in
      right|left)
        src=$(hyprctl monitors -j | jq -r '(map(select(.name | startswith("eDP"))) + sort_by(.id))[0].name // empty')
        [ -n "$src" ] && name_ok "$src" || { echo "no output to extend from" >&2; exit 1; }
        while read -r t xy; do
          [ -n "$t" ] || continue
          if name_ok "$t" && set_rule "$t" mirror= position="$xy"; then echo "   $t extends the desktop to the $2 of $src, at $xy"; else rc=1; fi
        done < <(place "$2" "$src") ;;
      "")
        while IFS= read -r t; do
          if name_ok "$t" && set_rule "$t" mirror=; then echo "   $t extends the desktop"; else rc=1; fi
        done < <(hyprctl monitors all -j | jq -r '.[] | select(.mirrorOf != "none") | .name') ;;
      *) usage ;;
    esac
    # A refused unmirror leaves the projector mirrored, so its saved rule and
    # do-not-disturb stay too. Dropping them anyway returned 0 while the next
    # reload quietly unmirrored it and toasts drew over the slides.
    [ "$rc" = 0 ] || exit 1
    # A mirror of an output unplugged since, too, or it returns on replug.
    [ ! -f "$SAVED" ] || sed -i -e 's/, mirror = "[^"]*"//' -e '/^hl.monitor({ output = "[^"]*" })$/d' "$SAVED"
    makoctl mode -r do-not-disturb >/dev/null 2>&1 || true
    ergon-status --poke 2>/dev/null || true ;;
  scale)
    case "${2:-}" in +|-|cycle) scale "$2" ;; *) usage ;; esac ;;
  xscale) xscale ;;
  mode)     mode "${2:-}" "${3:-}" ;;
  modes)    modes "${2:-}" ;;
  rotate)   rotate "${2:-}" "${3:-}" ;;
  position) position "${2:-}" "${3:-}" ;;
  save)     save ;;
  *) usage ;;
esac
