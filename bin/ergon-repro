#!/usr/bin/env bash
# ergon:summary=Emit what someone else needs to reproduce this project
# ergon:group=data
# ergon:args=[--out DIR] [--with-data]
# ergon:help=native
#
#   ergon repro                 -> repro/ next to the project
#   ergon repro --out /tmp/sub
#
# Journals and reviewers increasingly ask for this and everyone improvises it.
# What lands:
#
#   pyproject.toml, uv.lock    the environment, exactly. Not `pip freeze`,
#                              which records what you happen to have rather
#                              than what resolves
#   data.sha256                a manifest, not the data. Bytes are usually too
#                              big and often embargoed; a hash proves the
#                              reviewer has the same inputs you did
#   git.txt                    commit, branch, remote, and the FULL diff if the
#                              tree is dirty -- without it a hash identifies
#                              code that does not exist anywhere
#   Containerfile              built from the lock, so the environment can be
#                              rebuilt without trusting uv to still exist
#   apptainer.def              because university clusters give you Apptainer,
#                              not Docker. Docker wants a root daemon and no
#                              shared cluster will run one
set -euo pipefail

OUT="repro"
WITH_DATA=0
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="${2:?}"; shift 2 ;;
    --with-data) WITH_DATA=1; shift ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ergon-repro: unknown argument $1" >&2; exit 2 ;;
  esac
done

[ -f pyproject.toml ] || { echo "ergon-repro: no pyproject.toml here — is this a project root?" >&2; exit 1; }

# Guard before anything below can delete a byte: --with-data (and the
# staleness check further down) replace $OUT/data wholesale, and $OUT must
# never be able to resolve onto the project root, onto data/ itself, or
# anywhere inside it -- `ergon repro --out . --with-data` must not be able to
# delete the user's data. realpath -m tolerates a path that does not exist
# yet, which is the ordinary case for OUT on a first run.
PROJECT_ROOT=$(realpath -m "$PWD")
DATA_REAL=$(realpath -m "$PWD/data")
OUT_REAL=$(realpath -m "$OUT")
refused=0
case "$OUT_REAL" in
  "$PROJECT_ROOT"|"$DATA_REAL")  refused=1 ;;
  "$DATA_REAL"/*)                refused=1 ;;
esac
# The check above is on $OUT, but what `rm -rf` actually deletes below is
# $OUT/data -- a project whose ROOT is itself named "data" (or that sits
# under a directory named "data") lets $OUT/data resolve ONTO the project
# root, or an ancestor of it, once $OUT points one level up, even though
# $OUT_REAL itself matched none of the patterns above. Guard the literal rm
# target too, not just $OUT.
RM_REAL="$OUT_REAL/data"
case "$PROJECT_ROOT/" in "$RM_REAL"/*) refused=1 ;; esac
case "$DATA_REAL/"    in "$RM_REAL"/*) refused=1 ;; esac
if [ "$refused" = 1 ]; then
  echo "ergon-repro: --out $OUT resolves to the project root or into data/" >&2
  echo "             refusing -- this command can replace \$OUT/data wholesale" >&2
  exit 2
fi

mkdir -p "$OUT"

cp pyproject.toml "$OUT/"
if [ -f uv.lock ]; then
  cp uv.lock "$OUT/"
  printf '   ok  uv.lock\n'
else
  printf '   !!  no uv.lock — run `uv lock`. Without it this is not reproducible,\n'
  printf '       only currently-working.\n'
fi

{
  echo "# git state at $(date -Iseconds)"
  if git rev-parse --git-dir >/dev/null 2>&1; then
    echo "commit:  $(git rev-parse HEAD 2>/dev/null)"
    echo "branch:  $(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    echo "remote:  $(git remote get-url origin 2>/dev/null || echo none)"
    if [ -n "$(git status --porcelain)" ]; then
      echo
      echo "# THE TREE WAS DIRTY. The commit above does not describe the code that"
      echo "# ran; this diff is the rest of it."
      echo
      git status --short
      echo
      git diff HEAD
    else
      echo "clean:   yes"
    fi
  else
    echo "not a git repository — there is no record of what the code was"
  fi
} > "$OUT/git.txt"
printf '   ok  git.txt\n'

# True iff $OUT/data holds exactly the files data.sha256 lists, with matching
# hashes. Used below to catch a copy left over from an earlier --with-data
# run that no longer describes today's data/ -- a bundle that lies about its
# own payload must not exit 0.
data_matches_manifest() {
  local have want
  have=$(cd "$OUT/data" && find . -type f -printf '%P\n' | sort)
  # Manifest lines are "<hex>  data/relpath" (sha256sum's own format, one or
  # two spaces before a * in binary mode); strip the hash and the leading
  # "data/" that `find data` put on every path to land on the same relpaths
  # find above just produced under $OUT/data.
  want=$(sed -E 's/^[0-9a-f]+ [ *]//' "$OUT/data.sha256" | sed 's|^data/||' | sort)
  # An empty data/ writes an empty manifest, which sha256sum -c rejects as
  # having no checksum lines -- a false "stale" for a payload that matches.
  [ "$have" = "$want" ] || return 1
  [ ! -s "$OUT/data.sha256" ] || (cd "$OUT" && sha256sum --quiet -c data.sha256) >/dev/null 2>&1
}

if [ -d data ]; then
  # A symlink whose target is unreachable (NAS not mounted, target moved or
  # deleted) is invisible to the -L pipeline below rather than an error: under
  # -L, `find -type f` reports a symlink as the type of what it points AT, so
  # a broken one matches neither -type f nor anything else and is just left
  # out, silently, with find's own exit status staying 0. Catch it here by
  # name, before anything is deleted, so a broken link can never make the
  # manifest quietly incomplete or make --with-data wipe a good payload only
  # to fail partway through cp on the same file.
  broken=$(find -L data -type l)
  if [ -n "$broken" ]; then
    printf '   !!  data/ has a symlink pointing at nothing -- cannot hash or copy it:\n' >&2
    printf '%s\n' "$broken" | sed 's/^/       /' >&2
    exit 1
  fi

  # Hash the inputs rather than shipping them. Sorted, so two manifests of the
  # same data compare equal regardless of filesystem order. -L on both find and
  # cp below: data/ routinely symlinks large files off a NAS, and plain `find
  # -type f` skips a symlinked file (silently dropping it from the manifest)
  # while plain `cp -r` copies the symlink itself -- a dangling absolute path
  # for anyone else who unpacks the bundle. Following the link makes the
  # manifest and the payload describe the same bytes.
  #
  # No `2>/dev/null || true`: a file sha256sum cannot read (permission denied)
  # used to be swallowed, leaving a manifest that silently omits it. A
  # manifest that cannot be complete is an error, not a partial success --
  # name the file and fail.
  if ! find -L data -type f -print0 | sort -z | xargs -0 -r sha256sum \
       > "$OUT/data.sha256" 2>"$OUT/.data.sha256.err"; then
    printf '   !!  data.sha256 incomplete -- could not hash every file under data/:\n' >&2
    sed 's/^/       /' "$OUT/.data.sha256.err" >&2
    rm -f "$OUT/.data.sha256.err" "$OUT/data.sha256"
    exit 1
  fi
  rm -f "$OUT/.data.sha256.err"
  printf '   ok  data.sha256 (%s files, %s)\n' \
    "$(wc -l < "$OUT/data.sha256")" "$(du -sh data 2>/dev/null | cut -f1)"

  if [ "$WITH_DATA" = 1 ]; then
    # Replace wholesale, never accumulate. `cp -r data "$OUT/data"` alone
    # nests a second copy inside the first when $OUT/data already exists
    # (from a previous run of this same command) instead of refreshing it,
    # and never drops a file removed from data/ since. rm -rf first makes
    # every run's payload exactly today's data/, whatever was there before.
    rm -rf "$OUT/data"
    cp -rL data "$OUT/data"
    printf '   ok  data/ copied (--with-data)\n'
  elif [ -e "$OUT/data" ]; then
    # Not ours to delete on a whim -- it may be exactly what the user wants
    # kept -- but if it no longer matches the manifest just written above, it
    # is a leftover from an earlier --with-data run and describes a data/
    # that no longer exists. Say so and fail rather than hand back a bundle
    # whose payload and manifest disagree.
    if ! data_matches_manifest; then
      printf '   !!  %s/data no longer matches data/ -- it is left from an earlier\n' "$OUT" >&2
      printf '       --with-data run. Remove it, or re-run with --with-data.\n' >&2
      exit 1
    fi
  fi
else
  # data/ was there for an earlier run and is gone now (removed, renamed) --
  # there is no fresh manifest to write and nothing to check a leftover
  # payload against, but the bundle must not go on describing inputs that no
  # longer exist just because this branch has nothing to compare.
  rm -f "$OUT/data.sha256"
  if [ "$WITH_DATA" = 1 ]; then
    # The payload is exactly today's data/, and today there is none.
    rm -rf "$OUT/data"
  elif [ -e "$OUT/data" ]; then
    printf '   !!  %s/data is left from an earlier run -- data/ itself is gone now.\n' "$OUT" >&2
    printf '       Remove it, or re-run with --with-data.\n' >&2
    exit 1
  fi
fi

PYVER=$(sed -n 's/.*requires-python *= *"[^0-9]*\([0-9.]*\).*/\1/p' pyproject.toml | head -1)
PYVER="${PYVER:-3.13}"

cat > "$OUT/Containerfile" <<EOF
# Rebuilt from uv.lock, so this is the environment that ran and not an
# approximation of it. Build:  podman build -t repro -f Containerfile .
FROM python:${PYVER}-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /work
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY . .
ENV PATH="/work/.venv/bin:\$PATH"
EOF

cat > "$OUT/apptainer.def" <<EOF
# For a cluster. Universities give you Apptainer, not Docker: Docker needs a
# root daemon and no shared machine will run one.
#   apptainer build repro.sif apptainer.def
Bootstrap: docker
From: python:${PYVER}-slim

%files
    pyproject.toml /work/pyproject.toml
    uv.lock /work/uv.lock

%post
    pip install --no-cache-dir uv
    cd /work && uv sync --frozen --no-dev

%environment
    export PATH=/work/.venv/bin:\$PATH
EOF
printf '   ok  Containerfile, apptainer.def\n'

cat > "$OUT/README.md" <<EOF
# Reproduction bundle

Generated by \`ergon repro\` on $(date -Iseconds) from $(uname -n).

    uv sync --frozen        # the exact environment, from uv.lock
    sha256sum -c data.sha256    # confirm the inputs match

\`git.txt\` records the commit, and the full diff if the working tree was dirty
when this was made — a hash alone would identify code that exists nowhere.

If you have neither uv nor the right Python, build the container:

    podman build -t repro -f Containerfile .      # workstation
    apptainer build repro.sif apptainer.def       # cluster
EOF
printf '   ok  %s/\n' "$OUT"
