#!/usr/bin/env bash
# ergon:summary=Fuzzel tree for system actions, palettes, backgrounds and help
# ergon:group=help
# ergon:args=[--dump]
#
# `ergon` (bare) already lists every command and `ergon --pick` already pops a
# flat picker of them, but nothing on the desktop opened either one, and a
# palette or a background could only be STEPPED (SUPER+T, SUPER+SHIFT+B),
# one repaint per palette to reach the one you want. This is the tree that reaches all
# of it by name: System, Style, Commands, Help.
#
# ERGON-31's own verification found the OLD flat picker (bin/ergon:42-46, the
# non-tty-stdout branch this file replaces as a menu entry point) running the
# chosen command with NO terminal and NO arguments -- so `doctor`, `update`,
# anything that prints or asks for sudo did it into a void, with nothing on
# screen to say it had even started. Every command reached from Commands or
# Help below runs bare, in a REAL terminal, and pauses before the window
# closes -- the "any key to close" idiom bin/ergon-keys already uses for its
# own terminal fallback, reused here rather than invented twice.
#
# Bare, not `--help` and not a typed-args prompt: every command in bin/ that
# NEEDS an argument already dies with its own usage line when it is missing
# (bin/ergon-rollback's `[ -n "${TARGET:-}" ] || die "usage: ..."`,
# bin/ergon-launch-tui's `${1:?usage: ...}`, and so on) -- verified against
# both of those. So bare invocation already IS "ask for args": read the
# message the command itself prints, then type the real one into the terminal
# that is now sitting open, focused, and yours.
#
# System (Timezone, Language and Channel excepted: they ask questions or print) and Style are the two exceptions: `ergon-session` and the
# `ergon-theme`/`ergon-wallpaper` setters are quick, self-contained and
# already either fuzzel-driven or silent-on-success, so they run detached,
# the same way SUPER+T and SUPER+SHIFT+B already do.
set -euo pipefail

BINDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Group and command names come from bin/ergon's own entries() (via --groups
# and --group), topics from bin/ergon-explain's own --list. Nothing here
# parses a `# ergon:` header a second time, and nothing here hardcodes a
# topic name -- both lists are read fresh on every run, so a new command or a
# new knowledge topic appears on its own.
groups()   { "$BINDIR/ergon" --groups; }
in_group() { "$BINDIR/ergon" --group "$1"; }                      # "name   summary" lines
topics()   { "$BINDIR/ergon-explain" --list | tail -n +3 | awk '{print $1}'; }

# ergon-theme --list and ergon-wallpaper --list both mark the active entry
# with a fixed 5-column " * "/"   " prefix (the --list branch of each) --
# stripping it is not re-parsing anything,
# it is un-doing formatting the same two commands already applied.
unmarked() { cut -c6-; }

# $2, when given, is a fuzzel --width. 48 (fuzzel.ini.in's default) is fine
# for the four top-level nouns; a command's own summary or a background's
# path needs more room than that to read as anything but a shared prefix.
pick() { fuzzel --dmenu --prompt "$1  " ${2:+--width "$2"}; }

# ERGON-31 review: binds.lua runs this whole menu with no `launch` prefix
# (bare `hl.dsp.exec_cmd("ergon-menu")`), same as SUPER+T/SUPER+SHIFT+B right
# above it in that file -- fine for a process that only ever picks and
# execs. A TERMINAL it opens is not that: "EVERY terminal goes through
# `launch` too (ERGON-19)" (binds.lua), because a bare one lives in
# wayland-wm@hyprland.service, where a kill ends the session, not just the
# window. Plain `ergon-term` does not add that scope on its own --
# ergon-launch-tui does, by probing for a live uwsm session first -- so this
# reuses that exact probe rather than assuming uwsm-app is even there.
launch() {
  if command -v uwsm-app >/dev/null 2>&1 \
     && grep -q . <<<"$(systemctl --user list-units --state=active --no-legend 'wayland-wm@*.service' 2>/dev/null)"; then
    exec uwsm-app -- "$@"
  fi
  exec "$@"
}

run_in_terminal() {  # args: an `ergon` subcommand and its arguments
  # $BINDIR/ergon by full path, not `ergon` off PATH: the menu already read
  # its command list from THIS checkout, so the terminal it opens runs the
  # same one rather than whatever `ergon` a differently-scoped PATH finds.
  launch "$BINDIR/ergon-term" sh -c \
    '"$0" "$@" || true; echo; echo "-- press enter to close --"; read -r _' \
    "$BINDIR/ergon" "$@"
}

show_topic() {  # $1: an `ergon explain` topic name
  # Paged the way bin/ergon-welcome pages the same topics (glow, else a
  # plain fallback): desktop-config/troubleshooting/security run 214-359
  # lines each (`wc -l knowledge/*.md`), so unpaged the terminal scrolls
  # straight to the tail and the close prompt, never the start of the page.
  launch "$BINDIR/ergon-term" sh -c '
    if command -v glow >/dev/null 2>&1; then "$0" explain "$1" | glow -p -
    elif command -v less >/dev/null 2>&1; then "$0" explain "$1" | less -R
    else "$0" explain "$1"; echo; echo "-- press enter to close --"; read -r _
    fi' "$BINDIR/ergon" "$@"
}

web_app_menu() {
  local sel
  sel=$(printf 'Add\nRemove\nList\n' | pick "web app") || exit 0
  case "$sel" in
    Add)    exec "$BINDIR/ergon-webapp" add ;;   # asks name and URL in fuzzel
    Remove) exec "$BINDIR/ergon-webapp" rm ;;    # fuzzel pick
    List)   run_in_terminal webapp ;;
  esac
}

restart_menu() {
  local sel
  sel=$(printf 'audio\nbluetooth\nwifi\ntrackpad\n' | pick restart) || exit 0
  run_in_terminal restart "$sel"   # sudo asks for the password, so a real terminal
}

system_menu() {
  local sel
  sel=$(printf 'Session\nWi-Fi\nSign in to Wi-Fi\nDNS\nSSH server\nVault\nTailscale\nRestart\nTouchpad\nTouchscreen\nWorld clock\nTranscode\nWeb app\nTimezone\nLanguage\nChannel\n' | pick system) || exit 0
  case "$sel" in
    Session)  exec "$BINDIR/ergon-session" ;;
    Wi-Fi)    exec "$BINDIR/ergon-wifi" ;;
    "Sign in to Wi-Fi") exec "$BINDIR/ergon-captive" ;;
    DNS)      exec "$BINDIR/ergon-dns" ;;
    "SSH server") run_in_terminal ssh-enable ;;   # refuses or asks sudo, so a terminal
    Vault)    run_in_terminal vault ;;         # asks for the server URL once
    Tailscale) run_in_terminal tailscale ;;   # sudo, login URL and QR: a real terminal
    Restart)  restart_menu ;;
    Touchpad) exec "$BINDIR/ergon-toggle-input" touchpad ;;
    Touchscreen) exec "$BINDIR/ergon-toggle-input" touchscreen ;;
    "World clock") exec "$BINDIR/ergon-clock" ;;
    Transcode) run_in_terminal transcode ;;   # asks for a file, then a target
    "Web app") web_app_menu ;;
    Timezone) run_in_terminal timezone ;;   # asks questions, so a real terminal
    Language) run_in_terminal language ;;   # asks questions too
    Channel)  run_in_terminal channel ;;    # prints it; the terminal stays open to change it
  esac
}

# Mirror and extend for a projector (ERGON-132), one entry each. ergon-display
# says why it refused on stderr and nothing is watching that, so it is shown.
display_do() {
  local out
  out=$("$BINDIR/ergon-display" "$@" 2>&1) || { notify-send "ergon display" "$out" 2>/dev/null || true; }
}

display_menu() {
  local sel
  sel=$(printf 'Present (mirror, no notifications)\nMirror\nExtend right\nExtend left\nExtend (undo mirror)\nScale (next)\nResolution and refresh\nRotate\nKeep this layout\n' | pick display 40) || exit 0
  case "$sel" in
    Present*)       display_do present ;;
    Mirror)         display_do mirror ;;
    "Extend right") display_do extend right ;;
    "Extend left")  display_do extend left ;;
    Extend*)        display_do extend ;;
    Scale*)         display_do scale cycle ;;
    Resolution*)    sel=$("$BINDIR/ergon-display" modes | pick resolution) || exit 0; display_do mode "$sel" ;;
    Rotate)         sel=$(printf '0\n90\n180\n270\n' | pick rotate) || exit 0; display_do rotate "$sel" ;;
    Keep*)          display_do save ;;
  esac
}

style_menu() {
  local sel
  sel=$(printf 'Palette\nBackground\nToggles\n' | pick style) || exit 0
  case "$sel" in
    Palette)
      sel=$("$BINDIR/ergon-theme" --list | pick palette) || exit 0
      exec "$BINDIR/ergon-theme" "$(unmarked <<<"$sel")"
      ;;
    Background)
      background_menu
      ;;
    Toggles)
      # "name  on|off" lines straight from ergon-toggle; picking one flips it.
      sel=$("$BINDIR/ergon-toggle" list | pick toggle) || exit 0
      exec "$BINDIR/ergon-toggle" "$(awk '{print $1}' <<<"$sel")"
      ;;
  esac
}

# ergon-wallpaper --list prints each candidate as its ABSOLUTE PATH (or the
# "generated (from <palette>)" label) -- bin/ergon-wallpaper:199-205. A path
# under .local/share/ergon/backgrounds/<palette>/ runs 60+ columns, past
# fuzzel's default width=48 (fuzzel.ini.in), and every background under the
# SAME palette directory shares that first 48-column prefix -- so all of
# them showed as one indistinguishable truncated line (rendered and
# screenshotted in headless sway, ERGON-31 review). Show basename(dirname)
# instead and keep a parallel array back to the real path, rather than
# re-deriving the path from the label by re-walking the directories --list
# already walked -- that would be the second parser this card avoids
# elsewhere, just moved here.
background_menu() {
  local raw path labels=() paths=() sel i
  while IFS= read -r raw; do
    path=$(unmarked <<<"$raw")
    paths+=("$path")
    case "$path" in
      'generated ('*) labels+=("$path") ;;
      *)              labels+=("$(basename "$path")  ($(basename "$(dirname "$path")"))") ;;
    esac
  done < <("$BINDIR/ergon-wallpaper" --list)
  # --list itself can refuse with nothing on stdout (no imagemagick and no
  # background on disk yet -- see its own comment above that check), which
  # used to reach fuzzel as empty input and, per fuzzel.ini's
  # exit-immediately-if-empty, close the menu with nothing on screen saying
  # why. Same failure dump() now reports instead of dying on; here there is
  # no dump to write it into, so it goes to notify-send.
  if [ "${#labels[@]}" -eq 0 ]; then
    command -v notify-send >/dev/null 2>&1 \
      && notify-send "ergon-menu" "no backgrounds to choose from (see: ergon wallpaper --list)"
    exit 0
  fi
  sel=$(printf '%s\n' "${labels[@]}" | pick background 60) || exit 0
  for i in "${!labels[@]}"; do
    [ "${labels[$i]}" = "$sel" ] || continue
    case "${paths[$i]}" in
      # The generated gradient's own flag is --generated, not --set, because
      # there is no FILE to give --set (bin/ergon-wallpaper:216-217 requires
      # one that exists).
      'generated ('*) exec "$BINDIR/ergon-wallpaper" --generated ;;
      *)              exec "$BINDIR/ergon-wallpaper" --set "${paths[$i]}" ;;
    esac
  done
}

commands_menu() {
  local g sel
  g=$(groups | pick commands) || exit 0
  # 76: what `ergon --pick` already uses for the same "name  summary" shape
  # (bin/ergon), wide enough that a summary is not cut to the same prefix
  # every other command in the group shares.
  sel=$(in_group "$g" | pick "$g" 76) || exit 0
  run_in_terminal "$(awk '{print $1}' <<<"$sel")"
}

help_menu() {
  local sel
  sel=$({ printf 'Keybindings\n'; topics; } | pick help) || exit 0
  if [ "$sel" = Keybindings ]; then
    exec "$BINDIR/ergon-keys"   # already fuzzel-driven; no terminal needed
  fi
  show_topic "$sel"
}

# Prints the same tree the interactive menu walks, flattened, so a person or
# the session test can see it without a compositor. Group and command lines
# are exactly `ergon --groups`/`ergon --group`'s own output, indented -- the
# coverage test in bin/test-cli.sh compares the Commands section against
# `ergon --list` (not --groups/--group, which this function itself calls --
# see that test for why comparing it to itself would be circular).
dump() {
  printf 'System\n  session menu (ergon session)\n  Wi-Fi (ergon wifi)\n  Sign in to Wi-Fi (ergon captive)\n  DNS (ergon dns)\n  SSH server (ergon ssh-enable)\n  Vault (ergon vault)\n  Tailscale (ergon tailscale)\n  Restart (ergon restart: audio, bluetooth, wifi, trackpad)\n  Touchpad, Touchscreen (ergon toggle-input)\n  World clock (ergon clock)\n  Transcode (ergon transcode)\n  Timezone (ergon timezone)\n  Language (ergon language)\n  Channel (ergon channel)\n'
  printf 'Display\n  Present (mirror, no notifications)\n  Mirror\n  Extend right\n  Extend left\n  Extend (undo mirror)\n  Scale (next)\n  Resolution and refresh\n  Rotate\n  Keep this layout\n'
  printf 'Style\n  Palette\n'
  "$BINDIR/ergon-theme" --list | unmarked | sed 's/^/    /'
  printf '  Toggles\n'
  "$BINDIR/ergon-toggle" list | awk '{print "    " $1}'
  printf '  Background\n'
  # Non-fatal: --list itself refuses (exit 1, its error on stderr, nothing on
  # stdout) on a machine with neither imagemagick nor a background on disk
  # yet -- provisioning, or this sandboxed test -- and under set -e that used
  # to take Commands/Help down with it, a much bigger loss than one missing
  # sub-list. stderr stays SEPARATE from the captured list on the success
  # path: ergon-wallpaper can print an unrelated palette-fallback warning
  # there even while --list itself succeeds, and merging the two would file
  # that warning as if it were a background's own name.
  local bg
  if bg=$("$BINDIR/ergon-wallpaper" --list 2>/dev/null); then
    unmarked <<<"$bg" | sed 's/^/    /'
  else
    printf '    (unavailable: %s)\n' "$("$BINDIR/ergon-wallpaper" --list 2>&1 >/dev/null)"
  fi
  printf 'Commands\n'
  "$BINDIR/ergon" --tree | sed 's/^/  /'
  printf 'Help\n  Keybindings\n  Explain\n'
  topics | sed 's/^/    /'
}

if [ "${1:-}" = --dump ]; then
  dump
  exit 0
fi

command -v fuzzel >/dev/null 2>&1 || { echo "ergon-menu: fuzzel is not installed" >&2; exit 1; }

sel=$(printf 'System\nDisplay\nStyle\nCommands\nHelp\n' | pick ergon) || exit 0
case "$sel" in
  System)   system_menu ;;
  Display)  display_menu ;;
  Style)    style_menu ;;
  Commands) commands_menu ;;
  Help)     help_menu ;;
esac
