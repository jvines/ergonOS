#!/usr/bin/env bash
# ergon:summary=Switch a desktop effect on or off: animations, gaps, opacity, rounding, bar, widescreen, screensaver
# ergon:group=windows
# ergon:args=[list | show THING | THING [on | off | toggle]]
#
# One mechanism for the look-and-feel switches (ERGON-109, 150, 151, 155, 140).
# Bare `ergon-toggle` lists them. THING without an action toggles.
#
#   animations   window and workspace animations         default on
#   gaps         gaps between windows and at the edges   default on
#   opacity      the slight transparency of unfocused windows   default on
#   rounding     rounded window corners (off = sharp)    default on
#   bar          the status bar (waybar)                 default on
#   widescreen   a lone window keeps a 16:9 shape, centred, instead of
#                stretching across an ultrawide monitor  default OFF
#   screensaver  the idle screensaver before the lock    default on
#
# "On" means the repo's own look (hypr/common/looknfeel.lua.in); the values
# below are copied from it and bin/test-toggle.sh fails if they drift.
#
# Runtime and persistent. A switch is applied at once with `hyprctl eval`, and
# written to ~/.local/state/ergon/toggles (name=on|off). From that file this
# renders toggles.lua beside it, which hypr/hyprland.lua loads after the themed
# config, so a `hyprctl reload`, a palette switch or a new session keeps what you
# chose. Not in ~/.config/ergon: that directory is yours, nothing here writes it.
# The bar is not config: autostart.lua and ergon-theme ask `ergon-toggle get bar`
# before starting waybar. The screensaver is read by ergon-screensaver.
# shellcheck source=../lib/i18n.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/i18n.sh"
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/ergon"
file="$state/toggles"
lua="$state/toggles.lua"
names=(animations gaps opacity rounding bar widescreen screensaver)

default() { case "$1" in widescreen) echo off ;; *) echo on ;; esac; }

known() { local n; for n in "${names[@]}"; do [ "$n" = "$1" ] && return 0; done; return 1; }

# get NAME -> on|off, the stored choice or the default.
get() {
  local v
  v=$(sed -n "s/^$1=//p" "$file" 2>/dev/null | tail -n1)
  case "$v" in on|off) echo "$v" ;; *) default "$1" ;; esac
}

# snippet NAME STATE -> the Lua that puts that switch in that state ("" for the bar,
# which is not config).
snippet() {
  case "$1:$2" in
    animations:on)   echo 'hl.config({ animations = { enabled = true } })' ;;
    animations:off)  echo 'hl.config({ animations = { enabled = false } })' ;;
    gaps:on)         echo 'hl.config({ general = { gaps_in = 4, gaps_out = 8 } })' ;;
    gaps:off)        echo 'hl.config({ general = { gaps_in = 0, gaps_out = 0 } })' ;;
    opacity:on)      echo 'hl.config({ decoration = { inactive_opacity = 0.96 } })' ;;
    opacity:off)     echo 'hl.config({ decoration = { inactive_opacity = 1.0 } })' ;;
    rounding:on)     echo 'hl.config({ decoration = { rounding = 4 } })' ;;
    rounding:off)    echo 'hl.config({ decoration = { rounding = 0 } })' ;;
    widescreen:on)   echo 'hl.config({ layout = { single_window_aspect_ratio = { 16, 9 } } })' ;;
    widescreen:off)  echo 'hl.config({ layout = { single_window_aspect_ratio = { 0, 0 } } })' ;;
  esac
}

# Rewrite toggles.lua: only what differs from the default, so a clean state is an
# empty file and the themed config stays the single source of the look.
render() {
  local n s
  { echo "-- GENERATED by ergon-toggle from $file. Do not edit; run: ergon toggle"
    for n in "${names[@]}"; do
      s=$(get "$n")
      [ "$s" = "$(default "$n")" ] || snippet "$n" "$s"
    done; } > "$lua.new"
  mv "$lua.new" "$lua"
}

apply() {  # NAME STATE
  local r s
  if [ "$1" = bar ]; then
    if [ "$2" = off ]; then pkill -u "$(id -u)" -x waybar >/dev/null 2>&1 || true
    elif ! pgrep -u "$(id -u)" -x waybar >/dev/null 2>&1; then
      hyprctl dispatch 'hl.dsp.exec_raw("waybar")' >/dev/null 2>&1 || true
    fi
    return 0
  fi
  s=$(snippet "$1" "$2"); [ -n "$s" ] || return 0
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0   # no session: persisted only
  r=$(hyprctl eval "$s" 2>&1) || true
  [ "$r" = ok ] || { echo "ergon-toggle: hyprland refused $1 $2: $r" >&2; return 1; }
}

list() { local n; for n in "${names[@]}"; do printf '%-12s %s\n' "$n" "$(get "$n")"; done; }

arg=${1:-list}
case "$arg" in
  -h|--help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  list) list; exit 0 ;;
  get)  known "${2:-}" || { echo "ergon-toggle: unknown toggle '${2:-}'" >&2; exit 2; }; get "$2"; exit 0 ;;
  show) known "${2:-}" || { echo "ergon-toggle: unknown toggle '${2:-}'" >&2; exit 2; }; get "$2"; exit 0 ;;
  render) mkdir -p "$state"; render; exit 0 ;;
esac
known "$arg" || { echo "ergon-toggle: unknown toggle '$arg' (try: ergon toggle list)" >&2; exit 2; }

cur=$(get "$arg")
case "${2:-toggle}" in
  on|off) new=$2 ;;
  toggle) [ "$cur" = on ] && new=off || new=on ;;
  *) echo "ergon-toggle: unknown action '$2'" >&2; exit 2 ;;
esac

mkdir -p "$state"
{ grep -v "^$arg=" "$file" 2>/dev/null || true; echo "$arg=$new"; } > "$file.new"
mv "$file.new" "$file"
render
apply "$arg" "$new"

command -v notify-send >/dev/null 2>&1 &&
  notify-send -u low -t 1500 -h string:x-canonical-private-synchronous:ergon-toggle \
    "$arg" "$new" || true
echo "$arg $new"
