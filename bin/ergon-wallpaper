#!/usr/bin/env bash
# ergon:summary=Set, cycle or regenerate the desktop background
# ergon:group=theme
# ergon:args=[--next|--prev|--list|--generated|--set FILE|WIDTHxHEIGHT]
#
# A background is EITHER an image file or a generated gradient, and both are
# first-class. The generated one is derived from the active palette -- the same
# ramp as every plot this machine makes -- and is what a fresh install shows,
# because it needs no image and is correct at any resolution.
#
# Images are looked for in, first match wins per directory, all of them merged:
#
#   $XDG_CONFIG_HOME/ergon/backgrounds/<palette>/   user, for one palette
#   $XDG_CONFIG_HOME/ergon/backgrounds/             user, any palette
#   $XDG_DATA_HOME/ergon/backgrounds/<palette>/     generated (ergon-wallpaper-gen)
#   $ERGON/theme/backgrounds/<palette>/             shipped, for one palette
#   $ERGON/theme/backgrounds/                       shipped, any palette
#
# The user directories come first so a shipped image can be overridden without
# touching the repo, and nothing here ever writes to them.
#
# The generated image is not committed, and neither are the rendered configs
# any more -- but for a different reason each. A config is text, and the cost of
# tracking it was that a palette switch left every machine dirty. This is binary
# and its correct size is a property of the panel it will be shown on, so a repo
# copy would be a 300 KB blob wrong for every machine but one. Shipped images
# under theme/backgrounds/ are a different thing and do belong in the repo --
# with their provenance recorded next to them.
set -euo pipefail

# readlink -f: this is reached through /usr/local/bin/<name>, which is a symlink
# into the repo. Without resolving it, BASH_SOURCE is the symlink's own path and
# the root comes out as /usr/local -- so every repo-relative file is looked for
# somewhere it cannot be. ergon-wallpaper died exactly that way, under set -e,
# before it could start hyprpaper, and the desktop had no wallpaper.
ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
OUT="${ERGON_WALLPAPER_OUT:-$HOME/.local/share/ergon/wallpaper.png}"

FORCE=0
ACTION=show          # show | next | prev | list | generated | set
SETFILE=
while :; do
  case "${1:-}" in
    --force)     FORCE=1; shift ;;
    --next)      ACTION=next; shift ;;
    --prev)      ACTION=prev; shift ;;
    --list)      ACTION=list; shift ;;
    --generated) ACTION=generated; shift ;;
    --set)       ACTION=set; SETFILE="${2:-}"; shift 2 || shift
                 [ -n "$SETFILE" ] || { echo "--set needs a file" >&2; exit 2; } ;;
    *)           break ;;
  esac
done

# Unquoted on purpose below: it is a list of magick arguments, not one string.
# Dither amount, as a percentage blend of a TILED noise pattern. 0 disables it.
#
# if/fi, NOT `[ ... ] && DITHER=""`: that returns 1 when the test is false and
# under `set -e` it exits the script -- which it did, killing the render.
DITHER_PCT="${ERGON_WALLPAPER_DITHER:-2}"

# The ACTIVE palette, not cool.env.
#
# This was hardcoded to theme/cool.env, so the wallpaper stayed cool whatever
# `ergon theme` had rendered -- and since the wallpaper is most of the screen,
# every palette looked identical. Six candidates were rendered side by side
# before that was obvious.
#
# Resolution matches ergon-theme's: an explicit argument, then ERGON_PALETTE,
# then the remembered choice, then cool.
_state="${XDG_STATE_HOME:-$HOME/.local/state}/ergon/palette"
if [ -n "${ERGON_PALETTE:-}" ]; then
  _want="$ERGON_PALETTE"
elif [ -f "$_state" ]; then
  _want=$(cat "$_state")
else
  _want=cool
fi
case "$_want" in
  /*|./*|../*) PALETTE="$_want" ;;
  *)           PALETTE="$ERGON/theme/$_want.env" ;;
esac
[ -f "$PALETTE" ] || PALETTE="$ERGON/theme/cool.env"
# shellcheck source=/dev/null
. "$PALETTE"

command -v magick >/dev/null || { echo "imagemagick required" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Which background
#
# The candidate list is the generated gradient FIRST, then every image found,
# in directory order. The gradient is a member of the cycle rather than a
# special case outside it, so --next walks off the last image back to it and a
# machine with no images at all still has a one-item cycle that behaves.
_pal_name=$(basename "$PALETTE" .env)
BG_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ergon/background"

GENERATED=':generated:'        # not a path, and cannot collide with one
CANDIDATES=("$GENERATED")

for _dir in \
  "${XDG_CONFIG_HOME:-$HOME/.config}/ergon/backgrounds/$_pal_name" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/ergon/backgrounds" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/ergon/backgrounds/$_pal_name" \
  "$ERGON/theme/backgrounds/$_pal_name" \
  "$ERGON/theme/backgrounds"
do
  [ -d "$_dir" ] || continue
  # -maxdepth 1 so a palette subdirectory is not also walked as part of its
  # parent, which would list every image twice. Sorted, so the cycle order is
  # the same on every machine instead of whatever readdir returns.
  while IFS= read -r _f; do
    [ -n "$_f" ] && CANDIDATES+=("$_f")
  done < <(find -L "$_dir" -maxdepth 1 -type f \
             \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
                -o -iname '*.webp' -o -iname '*.avif' \) 2>/dev/null | sort)
done

if [ "$ACTION" = list ]; then
  _cur=$( [ -f "$BG_STATE" ] && cat "$BG_STATE" || echo "$GENERATED" )
  for _c in "${CANDIDATES[@]}"; do
    _label=$( [ "$_c" = "$GENERATED" ] && echo "generated (from $_pal_name)" || echo "$_c" )
    [ "$_c" = "$_cur" ] && printf '   * %s\n' "$_label" || printf '     %s\n' "$_label"
  done
  exit 0
fi

# ONE SWITCH AT A TIME. Pressing next faster than a switch completes ran
# several of these at once: each read the same state and computed the same
# "next", and each started its own downscale. With 8K images that was several
# ImageMagick processes of ~1 GB each in a 4 GB VM, and the OOM killer took
# the whole compositor session with them (2026-09-21). Queued instead: every
# press still counts, in order.
if command -v flock >/dev/null 2>&1; then
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ergon-wallpaper.lock"
  flock -w 120 9 || { echo "  another switch is still running" >&2; exit 1; }
fi

# What is wanted, before it is checked for existence.
_cur=$( [ -f "$BG_STATE" ] && cat "$BG_STATE" || echo "$GENERATED" )
case "$ACTION" in
  set)       WANT="$SETFILE"
             [ -f "$WANT" ] || { echo "no such file: $WANT" >&2; exit 1; } ;;
  generated) WANT="$GENERATED" ;;
  next|prev)
    _n=${#CANDIDATES[@]}
    if [ "$_n" -le 1 ]; then
      echo "  only the generated background is available" >&2
      echo "  put images in ${XDG_CONFIG_HOME:-$HOME/.config}/ergon/backgrounds/" >&2
      WANT="$GENERATED"
    else
      _i=0
      for _k in "${!CANDIDATES[@]}"; do
        [ "${CANDIDATES[$_k]}" = "$_cur" ] && { _i=$_k; break; }
      done
      if [ "$ACTION" = next ]; then
        WANT="${CANDIDATES[$(( (_i + 1) % _n ))]}"
      else
        WANT="${CANDIDATES[$(( (_i - 1 + _n) % _n ))]}"
      fi
    fi ;;
  *)
    # A remembered image that has since been deleted must not leave the desktop
    # with no wallpaper at all; fall back to the one thing that always exists.
    if [ "$_cur" != "$GENERATED" ] && [ ! -f "$_cur" ]; then
      WANT="$GENERATED"
    else
      WANT="$_cur"
    fi ;;
esac

mkdir -p "$(dirname "$BG_STATE")"
printf '%s\n' "$WANT" > "$BG_STATE"

# The chosen image stays the SOURCE of record here -- the state file names it,
# not a scaled copy. What hyprpaper is actually handed is decided further down,
# where an image larger than the panel is downsampled properly first; see the
# block above the hyprpaper config for why hyprpaper must not scale it itself.
if [ "$WANT" != "$GENERATED" ]; then
  ACTIVE="$WANT"
  echo "  $ACTIVE"
fi

# Default to the largest connected output, so this is right on the laptop panel
# and right again once it is docked to something bigger.
if [ -n "${1:-}" ]; then
  SIZE="$1"
elif command -v hyprctl >/dev/null && SIZE=$(hyprctl monitors -j 2>/dev/null \
     | jq -r 'max_by(.width * .height) | "\(.width)x\(.height)"' 2>/dev/null) \
     && [ -n "$SIZE" ] && [ "$SIZE" != "null" ]; then
  :
else
  SIZE=2880x1920          # Framework 13 panel
fi

mkdir -p "$(dirname "$OUT")"

# A true diagonal two-point ramp via sparse-color, NOT gradient: + -rotate --
# rotating a gradient leaves the canvas corners empty and you then have to
# oversize and crop to hide it.
#
# Blended at 18% over the dark ground so this reads as a dark desktop with the
# palette in it rather than a screensaver. Windows sit on top of it all day and
# it must not compete with them.
#
# NO added noise, however tempting as a debanding trick: gaussian grain defeats
# PNG's filters completely and takes this file from 324 KB to 29 MB. At an 18%
# blend the tonal range is narrow enough that there is nothing much to band.
# Rendering is a multi-megapixel magick run, and autostart calls this on every
# session. Skip it when the file is already there and no older than the palette
# it came from -- edit theme/cool.env and the next run rebuilds it.
if [ "$WANT" = "$GENERATED" ]; then
ACTIVE="$OUT"
# Compared against $PALETTE, not theme/cool.env. Hardcoding cool.env meant
# switching palettes did not make the rendered gradient stale, so it was only
# ever rebuilt because ergon-theme passes --force.
if [ "$FORCE" = 0 ] && [ -z "${1:-}" ] && [ -s "$OUT" ] && [ "$OUT" -nt "$PALETTE" ]; then
  echo "  $OUT  (unchanged)"
else
  # DITHER is the last step and it is not optional: an 18% blend spans only a
  # few dozen 8-bit values across the whole panel, so the ramp quantises into
  # visible bands. A tiny amount of noise breaks the steps into a texture the
  # eye reads as smooth.
  #
  # attenuate 0.03 keeps it to roughly +/-1 level. The earlier note here said
  # noise takes this from 324 KB to 29 MB -- that is true of noise at full
  # amplitude, which is uncorrelated at every bit and defeats PNG's filters
  # entirely. At one level it perturbs only the bottom bit and compresses fine.
  # ERGON_WALLPAPER_DITHER=0 turns it off if a panel ever looks worse with it.
  # The dither is a TILED 8x8 noise cell, not full-frame noise.
  #
  # Full-frame gaussian is uncorrelated at every pixel, so PNG's filters have
  # nothing to predict: measured at 1280x800 it took this file from 48 KB to
  # 4.4 MB, which is the blowup the original note warned about. An 8x8 cell
  # repeated across the image carries the same per-pixel jitter and is perfectly
  # periodic, so it compresses to almost nothing.
  if [ "$DITHER_PCT" = 0 ]; then
    magick -size "$SIZE" xc:"$COOL_BG0" \
      \( -size "$SIZE" xc: -sparse-color barycentric \
           "0,0 $COOL_0  %[fx:w-1],%[fx:h-1] $COOL_4" \) \
      -compose blend -define compose:args=18 -composite \
      "$OUT"
  else
    magick -size "$SIZE" xc:"$COOL_BG0" \
      \( -size "$SIZE" xc: -sparse-color barycentric \
           "0,0 $COOL_0  %[fx:w-1],%[fx:h-1] $COOL_4" \) \
      -compose blend -define compose:args=18 -composite \
      \( -size 8x8 xc:gray50 +noise Random -write mpr:cell +delete \
         -size "$SIZE" tile:mpr:cell \) \
      -compose blend -define compose:args="$DITHER_PCT" -composite \
      "$OUT"
  fi
  echo "  $OUT  ($SIZE, $(du -h "$OUT" | cut -f1))"
fi
fi

# Downscale HERE, properly, instead of letting hyprpaper do it.
#
# Backgrounds are rendered at 4K precisely so they can be downsampled to any
# panel -- and hyprpaper's own scaling threw that away. Measured on a 4K
# Clifford shown on a 1280x800 panel: stair-stepped edges and moire through
# every fine striation, where the same file downsampled with a real filter was
# clean. A cheap scaler point-samples, and point-sampling fine structure is
# exactly how aliasing is made.
#
# So the image is scaled once, in LINEAR light with Lanczos, and hyprpaper is
# given a file at the panel's exact size: it then has nothing left to scale.
# Linear light because averaging sRGB values darkens every edge where a bright
# strand meets the dark ground -- the colour fringing a gamma-naive resize
# leaves -- whereas light actually adds linearly. Cover-fit, matching what
# hyprpaper would have done, so framing does not change.
#
# Cached by source path, source mtime and panel size, so switching back to a
# background is instant and re-rendering one invalidates its copy.
SHOWN="$ACTIVE"
if [ "$ACTIVE" != "$OUT" ] && command -v magick >/dev/null 2>&1; then
  _dims=$(magick identify -format '%w %h' "$ACTIVE" 2>/dev/null || true)
  _iw=${_dims% *}; _ih=${_dims#* }
  _pw=${SIZE%x*};  _ph=${SIZE#*x}
  if [ -n "$_dims" ] && { [ "$_iw" -gt "$_pw" ] || [ "$_ih" -gt "$_ph" ]; }; then
    _cache="${XDG_CACHE_HOME:-$HOME/.cache}/ergon/wallpaper"
    mkdir -p "$_cache"
    _key=$(printf '%s %s %s' "$ACTIVE" "$(stat -c %Y "$ACTIVE")" "$SIZE" \
           | md5sum | cut -c1-12)
    _base=$(basename "$ACTIVE"); _base=${_base%.*}
    SHOWN="$_cache/$_base-$SIZE-$_key.png"
    if [ ! -s "$SHOWN" ]; then
      # Memory-capped. An HDRI ImageMagick holds each pixel as four floats, so
      # an 8K image is ~600 MB before the resize allocates anything; past the
      # cap it pages to a disk cache instead of being OOM-killed. The cache
      # directory, not /tmp, which may itself be RAM.
      MAGICK_TEMPORARY_PATH="$_cache" \
      magick -limit memory 256MiB -limit map 512MiB "$ACTIVE" \
        -colorspace RGB -filter Lanczos \
        -resize "${SIZE}^" -gravity center -extent "$SIZE" \
        -colorspace sRGB "$SHOWN.tmp.png" && mv "$SHOWN.tmp.png" "$SHOWN"
      rm -f "$SHOWN.tmp.png"
      # Keep the cache bounded, but above the size of a curated set: at twenty,
      # cycling a larger set evicted each copy before it came round again.
      ls -1t "$_cache"/*.png 2>/dev/null | tail -n +65 | xargs -r rm -f
    fi
    if [ -s "$SHOWN" ]; then
      echo "  shown at $SIZE (downsampled from ${_iw}x${_ih})"
    else
      # Never hand hyprpaper a path that was not written -- it then shows
      # nothing and stops answering. Unscaled is worse-looking, not broken.
      echo "  could not downsample; showing it unscaled" >&2
      SHOWN="$ACTIVE"
    fi
  fi
fi

# A config with ABSOLUTE paths, written next to the image, and hyprpaper started
# against it with -c.
#
# The shipped hypr/hyprpaper.conf writes its paths with a leading ~, and that
# file cannot be made per-machine: ~/.config/hypr is a symlink to the repo, so
# anything written there is written to the repo. hyprpaper also reads its config
# only at startup. Between those two, a desktop whose wallpaper was absent or
# whose ~ went unexpanded came up flat and never recovered.
#
# Writing our own config removes both: the path is absolute, and it exists
# before hyprpaper is started because this starts it.
PAPER_CONF="$(dirname "$OUT")/hyprpaper.conf"
# Per session, in the runtime dir, and truncated at every start: it holds what
# the current (or the last) hyprpaper said, and does not pile up across switches.
PAPER_LOG="${XDG_RUNTIME_DIR:-/tmp}/hyprpaper.log"
cat > "$PAPER_CONF" <<CONF
# Written by ergon-wallpaper. Absolute paths on purpose -- see that script.
preload = $SHOWN
wallpaper = , $SHOWN
splash = false
ipc = on
CONF

# Start it if it is not up, then SET the wallpaper over IPC.
#
# Starting it with -c is not enough on its own: hyprpaper comes up with nothing
# loaded (listactive returns empty), so the background layer is never mapped and
# the desktop shows the compositor's background_color. Proven in the VM, where
# the wallpaper only appeared once an IPC request was made.
#
# The request is `wallpaper`, and that spelling matters. On this version
# `preload` and `reload` both answer "invalid hyprpaper request"; `wallpaper`
# is accepted and maps the layer immediately. ergon-wallpaper used `reload`,
# which silently failed every time.
#
# hyprpaper is RESTARTED, not merely poked, and that is the whole point. It
# caches decoded images by path, and this script always writes the same path.
# Asking it to set a path it already holds is a no-op: the file on disk changes
# and the screen does not. That is exactly what happened when switching
# palettes -- every one of them rendered correctly and every one of them looked
# identical on screen, because the first image stayed mapped.
#
# There is no IPC request that drops the cache on this version (`preload` and
# `reload` both answer "invalid hyprpaper request"), so the cache is dropped by
# ending the process that holds it. Restarting is cheap; it draws one image.
# Switch over IPC when the PATH changes; restart only when it does not.
#
# Restarting on every switch is what made cycling backgrounds flash and take a
# second and a half: kill, wait, start, wait, then ask. That was written to
# beat hyprpaper's image cache, which is keyed by path -- and the cache is only
# a problem when the file behind an unchanged path has been rewritten, which
# happens for the generated gradient and never for an image. For a different
# path, preload + wallpaper swaps it immediately with no process restart and no
# gap on screen.
_running=0
pgrep -x hyprpaper >/dev/null 2>&1 && _running=1

_prev=$( [ -f "$BG_STATE.applied" ] && cat "$BG_STATE.applied" || echo "" )
_same_path=0
[ "$_prev" = "$SHOWN" ] && _same_path=1

if [ "$_running" = 1 ] && [ "$_same_path" = 0 ] && command -v hyprctl >/dev/null 2>&1; then
  # Fast path: no restart. preload first so the image is decoded before it is
  # asked for, otherwise the compositor shows the old one until decoding ends.
  hyprctl hyprpaper preload "$SHOWN" >/dev/null 2>&1 || true
  if hyprctl hyprpaper wallpaper ",$SHOWN" >/dev/null 2>&1; then
    applied=1
    # Drop the images no longer on screen. Without this every background ever
    # shown stays decoded in memory, which for 8K images is ~130 MB each.
    hyprctl hyprpaper unload unused >/dev/null 2>&1 || true
  fi
fi

if [ "${applied:-0}" != 1 ]; then
  pkill -x hyprpaper >/dev/null 2>&1 || true
  sleep 0.3
  # 9>&-: the daemon must not inherit the switch lock, or it holds it for
  # its whole life and every later switch waits out the timeout.
  #
  # Its output goes to a log rather than /dev/null. hyprpaper that cannot start
  # says why on stderr and exits, and with that discarded the only symptom was
  # a flat desktop and "did not accept the wallpaper" -- which is how the VM
  # suite's background check stayed red for days with nothing to read.
  hyprpaper -c "$PAPER_CONF" 9>&- >"$PAPER_LOG" 2>&1 &
  sleep 1
  if command -v hyprctl >/dev/null 2>&1; then
    for _ in $(seq 15); do
      if hyprctl hyprpaper wallpaper ",$SHOWN" >/dev/null 2>&1; then
        applied=1; break
      fi
      sleep 1
    done
  fi
fi

printf '%s\n' "$SHOWN" > "$BG_STATE.applied"
if [ "${applied:-0}" = 1 ]; then
  echo "  wallpaper set on all outputs"
else
  echo "  hyprpaper did not accept the wallpaper; it is set at the next session" >&2
  pgrep -x hyprpaper >/dev/null 2>&1 || echo "  hyprpaper exited; its output is in $PAPER_LOG" >&2
fi
