#!/usr/bin/env bash
# ergon:summary=Stay awake: no dimming, locking or screen-off (full: no suspend either, lid included)
# ergon:group=power
# ergon:args=[on | full | off | toggle | toggle-full | status]
#
# For a long run you are watching and for giving a talk. hypridle dims at 4
# min, locks at 10 and blanks the panel at 12 (hypr/hypridle.conf); this holds
# a logind "idle" inhibitor, which hypridle respects (ignore_systemd_inhibit
# is false there), so none of the three fires while it is held. Bare
# `ergon-awake` toggles.
#
# Why an inhibitor and not `pkill hypridle` (omarchy's way): stopping hypridle
# also loses its lock_cmd / before_sleep_cmd / after_sleep_cmd, so a lid-close
# suspend would sleep UNLOCKED, and a forgotten stop leaves nothing to say so.
# The inhibitor leaves hypridle running.
#
# Two modes. `on` (SUPER+CTRL+I) leaves the lid alone: closing it still
# suspends (or docks, see ergon-lid) -- shutting a laptop into a bag is a
# human decision. `full` (SUPER+CTRL+SHIFT+I) also holds "sleep" and
# "handle-lid-switch", for a run that must survive the lid being shut: logind
# neither suspends nor acts on the lid. ergon-lid then LOCKS the session and
# turns the panel off on close (a shut laptop that stays awake must not sit
# unlocked with its panel lit), and turns it back on at open. There is no idle
# suspend to disable in either mode (hypridle.conf says why).
#
# State is a transient user unit holding the inhibitor -- ergon-awake.service
# or ergon-awake-full.service, never both: it survives a waybar restart,
# ergon-status and ergon-lid ask the unit rather than a flag file, and it is
# gone at logout and reboot, so it can never outlive the session that asked
# for it. The bar shows which (ERGON-32/81/83) and is poked.
set -euo pipefail

IDLE=ergon-awake.service
FULL=ergon-awake-full.service
up()   { systemctl --user is-active --quiet "$1" 2>/dev/null; }
say()  { command -v notify-send >/dev/null 2>&1 && notify-send -a ergon-awake -t 3000 "ergon-awake" "$1" || true; }

start() {  # start <unit> <what> <message>
  up "$1" && return 0
  local other=$IDLE; [ "$1" = "$IDLE" ] && other=$FULL
  if up "$other"; then systemctl --user stop "$other"; fi
  systemd-run --user --quiet --unit="${1%.service}" \
    --description="ergon: stay awake ($2 inhibitor)" \
    systemd-inhibit --what="$2" --who=ergon-awake --why="stay awake is on" \
      --mode=block sleep infinity
  say "$3"
}
on()   { start "$IDLE" idle "staying awake: no dimming, lock or screen-off until you turn it off"; }
full() { start "$FULL" idle:sleep:handle-lid-switch \
           "staying fully awake: no suspend, not even on lid close (the lid locks and blanks)"; }
stop() {
  local u; for u in "$IDLE" "$FULL"; do if up "$u"; then systemctl --user stop "$u"; fi; done
  say "idle and suspend back to normal"
}
any() { up "$IDLE" || up "$FULL"; }

case "${1:-toggle}" in
  on)          on ;;
  full)        full ;;
  off)         stop ;;
  toggle)      if any; then stop; else on; fi ;;
  toggle-full) if up "$FULL"; then stop; else full; fi ;;
  status)      if up "$FULL"; then echo full; elif up "$IDLE"; then echo on; else echo off; fi; exit 0 ;;
  -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "usage: ergon-awake [on|full|off|toggle|toggle-full|status]" >&2; exit 2 ;;
esac
command -v ergon-status >/dev/null 2>&1 && ergon-status --poke || true
