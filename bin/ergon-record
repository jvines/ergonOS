#!/usr/bin/env bash
# ergon:summary=Start or stop a screen recording
# ergon:group=capture
# ergon:args=[region] [--audio desktop|mic|both]
#
# Toggle. Running it with a recording in flight stops that recording.
#
# pkill -x, never pkill -f: -f matches the whole command line, which includes
# THIS script's own invocation, so `pkill -f wf-recorder` kills the toggle
# before it can signal the recorder. -x matches the executable name only.
#
# --audio desktop/mic pass wf-recorder the PulseAudio SPECIAL names
# @DEFAULT_MONITOR@ (the default sink's monitor) and @DEFAULT_SOURCE@ (the
# mic) -- `pactl --help` documents both -- rather than a name resolved here.
# wf-recorder hands the string straight to libpulse, which re-resolves it at
# connect time, so this needs no pactl call of its own and cannot go stale
# between the moment "ergon record" is pressed and the moment it is stopped.
#
# --audio both is refused, not attempted: `wf-recorder --help` and its man
# page both document exactly one -a/--audio DEVICE, singular, with no way to
# give it a second. Mixing the monitor with the mic needs a combined PipeWire
# sink of its own (pw-loopback, or a module-combine-sink) that nothing here
# creates or tears down; building that is more machinery than this card is
# for, so it says so rather than silently recording only one side.
set -euo pipefail

OUT="${ERGON_RECORD_DIR:-$HOME/recordings}"
# Where the in-flight recording's own filename lives, so the STOP half of
# this toggle -- a separate invocation of this same script -- knows what to
# offer opening. Runtime state, not a setting: lib/user-config.sh and
# ergon-lint's ~/.config/ergon rule are about the user's own preferences, not
# a pointer to a file this process is still writing.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ergon"

if pgrep -x wf-recorder >/dev/null; then
  # SIGINT, not SIGTERM: wf-recorder finalises the container on INT and leaves
  # an unplayable file on TERM.
  pkill -INT -x wf-recorder
  file=$(cat "$STATE/recording" 2>/dev/null || true)
  rm -f "$STATE/recording"
  if [ -n "$file" ]; then
    # -A implies --wait, so this is backgrounded: the keybind, and a person
    # who ran `ergon record` by hand, gets control back at once instead of
    # blocking until the notification is clicked or expires. -t gives it
    # longer than mako's own default-timeout (6s, mako/config.in) to be
    # clicked at all.
    #
    # The chosen action reaches mpv as its OWN argv element, never through a
    # shell string built by concatenation -- $file is a path this script
    # built from a timestamp it also chose, but nothing downstream of here
    # should have to re-derive that to stay safe.
    ( action=$(notify-send -t 15000 -A "open=Open" "ergon-record" \
                 "stopped — $(basename "$file")")
      [ "$action" = open ] && exec mpv "$file" ) </dev/null >/dev/null 2>&1 &
    disown
  else
    notify-send "ergon-record" "stopped — $OUT"
  fi
  exit 0
fi

region=0
audio=""
while [ $# -gt 0 ]; do
  case "$1" in
    region) region=1 ;;
    --audio) audio="${2:?--audio needs a value: desktop, mic or both}"; shift ;;
    --audio=*) audio="${1#--audio=}" ;;
    *) echo "ergon-record: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

audio_opt=()
case "$audio" in
  '') ;;
  desktop) audio_opt=(--audio=@DEFAULT_MONITOR@) ;;
  mic)     audio_opt=(--audio=@DEFAULT_SOURCE@) ;;
  both)
    echo "ergon-record: --audio both is not supported here -- wf-recorder takes one PulseAudio source, and mixing the desktop monitor with the mic needs a combined PipeWire sink this repo does not set up. Use --audio desktop or --audio mic." >&2
    exit 2 ;;
  *)
    echo "ergon-record: --audio must be desktop, mic or both, not '$audio'" >&2
    exit 2 ;;
esac

mkdir -p "$OUT" "$STATE"
file="$OUT/$(date +%Y%m%d-%H%M%S).mp4"
printf '%s' "$file" > "$STATE/recording"

args=(-f "$file")
if [ "$region" = 1 ]; then
  geom=$(slurp) || { rm -f "$STATE/recording"; exit 0; }
  args+=(-g "$geom")
fi
args+=("${audio_opt[@]}")

# VAAPI on the iGPU. Software encoding a 2880x1920 panel pins several cores,
# which on this machine means competing with whatever is actually running.
if [ -e /dev/dri/renderD128 ]; then
  args+=(-c h264_vaapi -d /dev/dri/renderD128)
fi

msg="recording"
[ -n "$audio" ] && msg="$msg, $audio audio"
notify-send "ergon-record" "$msg → $(basename "$file")"
exec wf-recorder "${args[@]}"
