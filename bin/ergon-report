#!/usr/bin/env bash
# ergon:summary=Collect a scrubbed, local-only log bundle for a bug report
# ergon:group=system
# ergon:args=[--out FILE] [--scrub]
# ergon:help=native
#
#   ergon report              -> ~/ergon-report-<date>.txt, path printed
#   ergon report --scrub      -> filter: stdin to stdout, scrubbed (what the
#                                report pipes everything through; also for
#                                checking a file by hand)
#
# One text file you can read BEFORE you send it. Nothing is uploaded, ever:
# this prints a path and stops. The header lists what was collected.
#
# Scrubbed: tokens and API keys, password/secret/psk-style assignments, PEM
# blocks, user:pass@ in URLs, Bearer/JWT strings, IPv4/IPv6 and MAC addresses,
# Wi-Fi SSIDs, long hex ids (machine-id), your username and this hostname.
# That is a best effort on text we recognise, not a guarantee: read the file.
set -uo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
BIN="$ERGON/bin"

# Reads stdin, writes stdout. Secrets first, so a token that happens to look
# like hex or contain the username is caught as a token; identity last.
scrub() {
  local u h
  u="${ERGON_SCRUB_USER:-${USER:-$(id -un)}}"
  h="${ERGON_SCRUB_HOST:-$(hostname 2>/dev/null)}"
  local -a ex=()
  # Names under 3 characters would shred unrelated words.
  [ "${#u}" -ge 3 ] && ex+=(-e "s#(^|[^A-Za-z0-9_])${u//[^A-Za-z0-9_.-]/}([^A-Za-z0-9_]|\$)#\1<user>\2#g" -e "s#(^|[^A-Za-z0-9_])${u//[^A-Za-z0-9_.-]/}([^A-Za-z0-9_]|\$)#\1<user>\2#g")
  [ "${#h}" -ge 3 ] && ex+=(-e "s#(^|[^A-Za-z0-9_.-])${h//[^A-Za-z0-9_.-]/}([^A-Za-z0-9_.-]|\$)#\1<host>\2#g" -e "s#(^|[^A-Za-z0-9_.-])${h//[^A-Za-z0-9_.-]/}([^A-Za-z0-9_.-]|\$)#\1<host>\2#g")
  sed -E \
    -e '/-----BEGIN [A-Z ]*PRIVATE KEY-----/,/-----END [A-Z ]*PRIVATE KEY-----/c\<private key removed>' \
    -e 's#://[^/[:space:]:@]+:[^/[:space:]@]+@#://<credentials>@#g' \
    -e 's#(gh[pousr]_|github_pat_|glpat-|xox[abprs]-|sk-ant-|sk-|AKIA|AIza)[A-Za-z0-9_-]{8,}#<token>#g' \
    -e 's#eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]*#<jwt>#g' \
    -e 's#([Bb]earer|[Bb]asic)[[:space:]]+[A-Za-z0-9._~+/=-]{8,}#\1 <token>#g' \
    -e 's#([A-Za-z0-9_.-]*([Pp]ass(word|wd|phrase)?|[Ss]ecret|[Tt]oken|[Aa]pi[_-]?[Kk]ey|PSK|psk|[Cc]redential)[A-Za-z0-9_.-]*[[:space:]]*[=:][[:space:]]*)("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:]"'"'"']+)#\1<redacted>#g' \
    -e 's#([Ss][Ss][Ii][Dd][[:space:]]*[=:][[:space:]]*)("[^"]*"|[^,;[:space:]]+)#\1<ssid>#g' \
    -e 's#([Ss][Ss][Ii][Dd]|[Cc]onnected to|connection|Associated with|Auto connecting to)([[:space:]]+)("[^"]*"|'"'"'[^'"'"']*'"'"')#\1\2<ssid>#g' \
    -e 's#\b([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b#<mac>#g' \
    -e 's#\b[0-9a-fA-F]{32,}\b#<hex-id>#g' \
    -e 's#(^|[^0-9A-Fa-f:])(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{0,4}:){1,6}:[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{1,4}){0,6})(%[A-Za-z0-9]+)?([^0-9A-Fa-f:]|$)#\1<ip6>\7#g' \
    -e 's#(^|[^0-9A-Fa-f:])(([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{0,4}:){1,6}:[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{1,4}){0,6})(%[A-Za-z0-9]+)?([^0-9A-Fa-f:]|$)#\1<ip6>\7#g' \
    -e 's#\b127\.0\.0\.1\b#@@LO1@@#g' -e 's#\b0\.0\.0\.0\b#@@LO0@@#g' \
    -e 's#\b(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(\.(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}\b#<ip>#g' \
    -e 's#@@LO1@@#127.0.0.1#g' -e 's#@@LO0@@#0.0.0.0#g' \
    "${ex[@]}"
}

OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --scrub) scrub; exit $? ;;
    --out) OUT="${2:?}"; shift 2 ;;
    -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ergon-report: unknown argument $1" >&2; exit 2 ;;
  esac
done
OUT="${OUT:-$HOME/ergon-report-$(date +%Y%m%d-%H%M%S).txt}"

RAW="$(mktemp)"; trap 'rm -f "$RAW"' EXIT
COLLECTED=()
section() {  # section <title> <cmd...>   (a missing tool is a note, not a failure)
  local title="$1"; shift
  COLLECTED+=("$title")
  { printf '\n===== %s =====\n' "$title"
    if ! command -v "$1" >/dev/null 2>&1 && [ ! -x "$1" ]; then echo "(not available: $1)"
    else timeout 60 "$@" 2>&1 | head -n 400; fi
  } >> "$RAW"
}
tail_file() {  # tail_file <title> <file> <lines> [grep-pattern]
  local title="$1" f="$2" n="$3"
  COLLECTED+=("$title")
  { printf '\n===== %s =====\n' "$title"
    if [ -r "$f" ]; then tail -n "$n" "$f"; else echo "(not readable: $f)"; fi; } >> "$RAW"
}

section "ergon version" bash -c "git -C '$ERGON' describe --always --dirty 2>/dev/null; git -C '$ERGON' log -1 --format='%h %cd %s' 2>/dev/null; true"
section "ergon-doctor" "$BIN/ergon-doctor"
section "ergon-bundle list" "$BIN/ergon-bundle" list
section "kernel and os" bash -c 'uname -srvm; grep -E "^(PRETTY_NAME|VERSION_ID|BUILD_ID)=" /etc/os-release'
section "ergon-hardware detect" "$BIN/ergon-hardware" detect
section "hyprland version" hyprctl version
section "hyprland config verify" Hyprland --verify-config
section "failed units (system)" systemctl --failed --no-pager --plain
section "failed units (user)" systemctl --user --failed --no-pager --plain
section "journal errors, this boot, system (priority<=3, last 150)" journalctl -b -p 3 -n 150 --no-pager -q
section "journal errors, this boot, user (priority<=3, last 100)" journalctl --user -b -p 3 -n 100 --no-pager -q

COLLECTED+=("hyprland crash report (newest, first 80 lines)")
{ printf '\n===== hyprland crash report (newest, first 80 lines) =====\n'
  cr=$(ls -t "${XDG_CACHE_HOME:-$HOME/.cache}"/hyprland/hyprlandCrashReport*.txt 2>/dev/null | head -n 1)
  if [ -n "$cr" ]; then echo "# $(basename "$cr")"; head -n 80 "$cr"; else echo "(none)"; fi; } >> "$RAW"

tail_file "pacman log (last 100 lines)" /var/log/pacman.log 100
COLLECTED+=("last system upgrade (pacman.log, from the last full upgrade)")
{ printf '\n===== last system upgrade (pacman.log, from the last full upgrade) =====\n'
  if [ -r /var/log/pacman.log ]; then
    start=$(grep -n 'starting full system upgrade' /var/log/pacman.log | tail -n 1 | cut -d: -f1)
    if [ -n "$start" ]; then tail -n +"$start" /var/log/pacman.log | head -n 300; else echo "(no full upgrade recorded)"; fi
  else echo "(not readable)"; fi; } >> "$RAW"

mkdir -p "$(dirname "$OUT")"
{
  echo "ergon report, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "Local file only: nothing was uploaded. Read it before you share it."
  echo "Collected:"; printf '  - %s\n' "${COLLECTED[@]}"
  echo "Scrubbed: tokens/keys, password/secret assignments, private keys, URL credentials,"
  echo "  IP and MAC addresses, Wi-Fi SSIDs, long hex ids, the username and the hostname."
  echo "  Best effort on recognisable text; free-form content (window titles, file names) is not."
  cat "$RAW"
} | scrub > "$OUT"
echo "$OUT"
