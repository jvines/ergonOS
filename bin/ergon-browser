#!/usr/bin/env bash
# ergon:summary=Open the default web browser, or a link in the one already running
# ergon:group=launch
# ergon:args=[url...]
# ergon:help=native
#
# ERGON-103. The browser is whatever this machine's x-scheme-handler/https
# default says, not a name written into binds.lua: install a second browser and
# pick it with `xdg-settings set default-web-browser`, and SUPER+B, xdg-open
# and links from other apps all follow. Firefox is only the fallback for a
# machine whose default is unset or points at something uninstalled.
#
# A link goes to the running browser (Firefox and Chromium both hand a second
# invocation to the first), and the window is then focused. An Electron app or
# a flatpak asks the desktop portal to open the link, and the portal starts the
# browser without an activation token, so the tab opens in a window that stays
# on its own workspace unseen. Focusing it by class is what makes it visible.
#
# session: uwsm/env-hyprland.d/ergon-browser points $BROWSER here, which is what
# xdg-open reads first on a session it does not recognise as a desktop.
set -euo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# $BROWSER points back here; xdg-mime does not read it, but unset it anyway so
# nothing below can loop.
unset BROWSER

desktop=$(xdg-mime query default x-scheme-handler/https 2>/dev/null || true)
[ -n "$desktop" ] || desktop=$(xdg-mime query default x-scheme-handler/http 2>/dev/null || true)

# First Exec= of the entry, if its command resolves; else Firefox.
cmd=(); class=""
IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for d in "${dirs[@]}"; do
  f="$d/applications/$desktop"
  [ -n "$desktop" ] && [ -r "$f" ] || continue
  exec_line=$(sed -n 's/^Exec=//p' "$f" | head -1)
  # Drop the field codes (%u %U %f ...): the URLs are appended below.
  read -ra cmd <<<"$(sed 's/ %[a-zA-Z]//g' <<<"$exec_line")"
  class=$(sed -n 's/^StartupWMClass=//p' "$f" | head -1)
  break
done
if [ "${#cmd[@]}" -eq 0 ] || ! command -v "${cmd[0]}" >/dev/null 2>&1; then
  cmd=(firefox); class=""
fi
[ -n "$class" ] || class=$(basename "${cmd[0]}")

if command -v uwsm-app >/dev/null 2>&1; then
  uwsm-app -- "${cmd[@]}" "$@" || true   # own scope, as every other launch
else
  "${cmd[@]}" "$@" || true
fi

# A bare SUPER+B opens a window, which Hyprland focuses by itself.
[ "$#" -gt 0 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || exit 0
addr=""
# The browser may need a moment to take the tab before its window is the one to raise.
for _ in 1 2 3 4 5; do
  addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$class" \
    'sort_by(.focusHistoryID) | map(select((.class // "" | ascii_downcase) == ($c | ascii_downcase))) | first.address // empty' || true)
  [ -n "$addr" ] && break
  sleep 0.2
done
[ -n "$addr" ] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
exit 0
