#!/usr/bin/env bash
# ergon:summary=Render every themed config from the palette
# ergon:group=theme
# ergon:args=[--check] [palette]
# Expands the palette into every committed config that carries colours.
#
#   ergon-theme                   # render, report what changed
#   ergon-theme --check           # exit 1 if anything is stale (for CI / pre-commit)
#
# Every themed config is committed as <name>.in alongside its output, with
# @COOL_*@ placeholders. This renders, rather than reading the palette at
# runtime, for one reason: install.sh links the repo into $HOME, so a file
# generated into $HOME at install time would be clobbered by the next link()
# and a file generated into the repo at install time would make every host
# permanently dirty. Rendering here, committing the result, keeps the tree
# clean on every machine and keeps the palette in exactly one place.
#
# Unexpanded placeholders are a hard error. A silently un-substituted @COOL_X@
# in a CSS file is invisible -- the rule is simply dropped and the surface
# renders with a default colour that looks plausible.
set -euo pipefail

# pwd -P, not pwd: ~/ergonOS is a symlink into ~/projects on every host, and
# `find` does not descend into a symlinked starting directory without -L. With
# the logical path this script finds zero templates and cheerfully reports
# "up to date" forever, on every machine, having rendered nothing.
# readlink -f: this is reached through /usr/local/bin/<name>, which is a symlink
# into the repo. Without resolving it, BASH_SOURCE is the symlink's own path and
# the root comes out as /usr/local -- so every repo-relative file is looked for
# somewhere it cannot be. ergon-wallpaper died exactly that way, under set -e,
# before it could start hyprpaper, and the desktop had no wallpaper.
ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
CHECK=0; [ "${1:-}" = "--check" ] && { CHECK=1; shift; }
# --no-apply renders the config files and stops: no wallpaper, no hyprctl
# reload, no waybar restart. For callers that need the rendered files to be
# correct but must not disturb a session someone is using -- the VM harness
# re-renders after syncing the repo, and restarting the bar under someone who
# is looking at it is not an acceptable side effect of a file sync.
APPLY=1; [ "${1:-}" = "--no-apply" ] && { APPLY=0; shift; }

# ONE palette, and that is a decision rather than an unfinished job.
#
# `cool` is not a preference: matplotlib/matplotlibrc sets image.cmap to cool
# because every plot this machine makes uses cool, and theme/cool.env is that
# same ramp -- COOL_0 and COOL_4 are its endpoints. That is why btop's
# temperature gradient and a hot line in a figure are the same colour, and it is
# the only reason the palette means anything rather than merely looking a way.
#
# A second SHIPPED palette would break exactly that. "Warm mode" would put the
# desktop and the figures in different languages, and the coupling is the point.
#
# But the coupling is an argument about THIS user, not about everyone: someone
# who does not plot in cool inherits none of it. So the palette is a variable
# they can point elsewhere, while the shipped default stays the one that is
# tested and coherent.
#
#   ergon theme                 re-render the palette in use
#   ergon theme warm            switch to theme/warm.env
#   ergon theme ~/mine.env      any file
#   ergon theme --list          what is available, and what is active
#
# The choice is REMEMBERED, in $XDG_STATE_HOME/ergon/palette. Without that,
# `ergon theme` with no argument after switching would quietly render the
# default back over your choice -- and install.sh runs it on every session.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ergon"
PALETTE_FILE="$STATE/palette"

# --current prints just the active palette's name, for a status bar or a prompt
# to read. Separate from --list because a caller that wants one word should not
# have to parse a decorated list to find the line with the asterisk on it.
if [ "${1:-}" = "--current" ]; then
  _active=$( [ -f "$PALETTE_FILE" ] && cat "$PALETTE_FILE" || echo cool )
  basename "$_active" .env
  exit 0
fi

if [ "${1:-}" = "--list" ]; then
  _active=$( [ -f "$PALETTE_FILE" ] && cat "$PALETTE_FILE" || echo cool )
  for _p in "$ERGON"/theme/*.env; do
    _n=$(basename "$_p" .env)
    [ "$_n" = "$_active" ] && printf '   * %s\n' "$_n" || printf '     %s\n' "$_n"
  done
  exit 0
fi

# --next / --prev step through theme/*.env in name order, wrapping. This is how
# a palette is CHOSEN: comparing six of them by editing a name in a command is
# not comparing them, and the difference between two neighbouring palettes is
# only visible if the desktop in front of you flips between them. Bound to a key
# in hypr/, so the comparison is a keypress.
#
# An active palette from outside theme/ (a candidate on a scratch path) has no
# position in that list, so stepping from it starts at the first entry rather
# than failing.
case "${1:-}" in
  --next|--prev)
    _dir="$1"; shift
    _all=(); for _p in "$ERGON"/theme/*.env; do _all+=("$(basename "$_p" .env)"); done
    [ "${#_all[@]}" -gt 1 ] || { echo "only one palette installed" >&2; exit 0; }
    _cur=$( [ -f "$PALETTE_FILE" ] && cat "$PALETTE_FILE" || echo cool )
    _i=-1; for _n in "${!_all[@]}"; do [ "${_all[$_n]}" = "$_cur" ] && { _i=$_n; break; }; done
    if [ "$_i" -lt 0 ]; then
      _j=0
    elif [ "$_dir" = --next ]; then
      _j=$(( (_i + 1) % ${#_all[@]} ))
    else
      _j=$(( (_i - 1 + ${#_all[@]}) % ${#_all[@]} ))
    fi
    set -- "${_all[$_j]}"
    ;;
esac

if [ -n "${1:-}" ]; then
  _want="$1"
elif [ -n "${ERGON_PALETTE:-}" ]; then
  _want="$ERGON_PALETTE"
elif [ -f "$PALETTE_FILE" ]; then
  _want=$(cat "$PALETTE_FILE")
else
  _want=cool
fi

case "$_want" in
  /*|./*|../*) PALETTE="$_want" ;;
  *)           PALETTE="$ERGON/theme/$_want.env" ;;
esac
[ -f "$PALETTE" ] || PALETTE="$_want"

[ -f "$PALETTE" ] || {
  echo "no palette '$_want' (try: ergon theme --list)" >&2; exit 1
}
if [ "$CHECK" != 1 ]; then
  mkdir -p "$STATE"
  # Record the full path for a palette outside theme/, so it can be found
  # again; a bare basename would resolve to theme/<name>.env, which may not
  # exist. ergon-wallpaper reads this same file.
  case "$PALETTE" in
    "$ERGON"/theme/*) basename "$PALETTE" .env > "$PALETTE_FILE" ;;
    *)                printf '%s\n' "$PALETTE" > "$PALETTE_FILE" ;;
  esac
fi

# Build the sed program from the palette. Keys are validated so a stray line in
# cool.env cannot inject sed syntax.
SEDPROG=$(mktemp); trap 'rm -f "$SEDPROG"' EXIT
while IFS='=' read -r k v; do
  case "$k" in
    ''|'#'*) continue ;;
    COOL_[A-Z0-9_]*) ;;
    *) echo "bad key in cool.env: $k" >&2; exit 1 ;;
  esac
  v="${v%%[[:space:]]*}"                       # strip trailing comments
  case "$v" in
    '#'[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
    *) echo "$k is not a 6-digit hex colour: '$v'" >&2; exit 1 ;;
  esac
  # Two forms: @COOL_X@ -> #RRGGBB, and @COOL_X:raw@ -> RRGGBB (hyprland wants
  # 0xAARRGGBB or bare hex; CSS and ini want the hash).
  printf 's|@%s@|%s|g\ns|@%s:raw@|%s|g\n' "$k" "$v" "$k" "${v#\#}" >> "$SEDPROG"
done < "$PALETTE"

# Derived, non-colour substitutions.
#
# These cannot live in the palette file: every value there is validated as a
# 6-digit hex, deliberately, so that a typo cannot become a sed program. They
# are computed here instead -- and computing them is better than declaring them
# anyway, because a palette that SAYS it is dark while shipping a light
# background is a contradiction nobody notices until the desktop is unreadable.
#
# Light or dark is decided by the relative luminance of the background, by the
# usual Rec. 709 weights. Integer arithmetic: this is /bin/sh maths, and the
# threshold is 50% of 255.
# Read from the file rather than a shell variable: this script never sources
# the palette (sourcing would execute it), so COOL_BG0 is not in scope here.
_bg0=$(sed -n 's/^COOL_BG0=\(#[0-9A-Fa-f]\{6\}\).*/\1/p' "$PALETTE" | head -1)
[ -n "$_bg0" ] || { echo "palette has no COOL_BG0: $PALETTE" >&2; exit 1; }
_hex=${_bg0#\#}
_r=$((16#${_hex:0:2})); _g=$((16#${_hex:2:2})); _b=$((16#${_hex:4:2}))
_lum=$(( (2126 * _r + 7152 * _g + 722 * _b) / 10000 ))
if [ "$_lum" -gt 127 ]; then
  MODE=light; PREFER_DARK=0; GTK_THEME=Adwaita;      ICON_THEME=Papirus-Light
else
  MODE=dark;  PREFER_DARK=1; GTK_THEME=Adwaita-dark; ICON_THEME=Papirus-Dark
fi
{
  printf 's|@COOL_MODE@|%s|g\n'        "$MODE"
  printf 's|@COOL_PREFER_DARK@|%s|g\n' "$PREFER_DARK"
  printf 's|@COOL_GTK_THEME@|%s|g\n'   "$GTK_THEME"
  printf 's|@COOL_ICON_THEME@|%s|g\n'  "$ICON_THEME"
} >> "$SEDPROG"

rc=0; rendered=0; changed=0
while IFS= read -r tpl; do
  out="${tpl%.in}"
  new=$(sed -f "$SEDPROG" "$tpl")

  if leftover=$(printf '%s\n' "$new" | grep -oE '@COOL_[A-Z0-9_]+(:raw)?@' | sort -u); then
    echo "!! $tpl references undefined colours:" >&2
    # Unquoted on purpose: grep -o gives one placeholder per line and the
    # split is what puts each on its own printf iteration.
    # shellcheck disable=SC2086
    printf '     %s\n' $leftover >&2
    rc=1; continue
  fi

  rendered=$((rendered+1))
  if [ -f "$out" ] && [ "$new" = "$(cat "$out")" ]; then continue; fi
  changed=$((changed+1))
  if [ "$CHECK" = 1 ]; then
    echo "   stale: ${out#"$ERGON"/}"
    rc=1
  else
    printf '%s\n' "$new" > "$out"
    echo "   rendered ${out#"$ERGON"/}"
  fi
done < <(find -L "$ERGON" -name '*.in' -not -path '*/.git/*' | sort)

if [ "$CHECK" = 1 ]; then
  [ "$changed" = 0 ] && echo "   $rendered rendered files are up to date"
  exit $rc
fi
[ "$changed" = 0 ] && echo "   $rendered files already up to date"

# Rendering a config is not applying it. Every running program already has the
# old colours in memory: hyprland holds its border colours, waybar parses its
# CSS once at startup, and the wallpaper is a PNG that has to be redrawn from
# the new ramp. Leaving this to the caller meant `ergon theme winter` changed
# nothing visible and looked broken -- and the VM harness grew its own private
# copy of these four steps, which then drifted from the real thing.
#
# Only when there is a compositor to talk to: this also runs from install.sh on
# a tty and from CI, where there is not.
if [ "$APPLY" = 1 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
  echo "   applying"
  # GTK4 and libadwaita read the theme from gsettings, NOT from settings.ini,
  # so a light palette that only rewrote the ini would leave every GTK4 app
  # dark. Needs a session bus, which is why this is here and not in the
  # provisioner -- provisioning over ssh has none.
  if command -v gsettings >/dev/null 2>&1; then
    _cs=$( [ "$MODE" = light ] && echo prefer-light || echo prefer-dark )
    gsettings set org.gnome.desktop.interface color-scheme "$_cs"       2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme   "$GTK_THEME"  2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme  "$ICON_THEME" 2>/dev/null || true
  fi
  "$ERGON/bin/ergon-wallpaper" --force >/dev/null 2>&1 || true
  hyprctl reload >/dev/null 2>&1 || true
  # waybar has no reload signal that re-reads the stylesheet; SIGUSR2 reloads
  # the config but keeps the parsed CSS, which is the half that carries the
  # palette. Restarting is the only thing that actually recolours the bar.
  pkill -x waybar >/dev/null 2>&1 || true
  sleep 0.5
  hyprctl dispatch 'hl.dsp.exec_raw("waybar")' >/dev/null 2>&1 || true
fi
exit $rc
