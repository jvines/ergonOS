#!/usr/bin/env bash
# ergon:summary=Render every themed config from the palette
# ergon:group=theme
# ergon:args=[--check] [palette]
# Expands the palette into every committed config that carries colours.
#
#   ergon-theme                   # render, report what changed
#   ergon-theme --check           # exit 1 if anything is stale (for CI / pre-commit)
#
# Every themed config is committed as <name>.in, with @COOL_*@ placeholders.
# The rendered output beside it is NOT committed -- it is gitignored, and
# install.sh renders it before it links anything.
#
# It used to be committed, and the reason given was that the alternatives were
# worse: a file generated into $HOME would be clobbered by install.sh's link(),
# and one generated into the repo would leave every host permanently dirty.
# Half of that was wrong and the other half had a third option nobody took.
#
# link() does not clobber a real file -- it warns and returns, leaving it alone
# (see install.sh). The actual consequence of rendering into $HOME is quieter
# and worse: the surface is then never linked to the repo at all, so it stops
# following the checkout without saying so.
#
# The dirty-tree half was true, and it was the real cost: a palette other than
# the default rewrote sixteen tracked files, so pressing the palette keybind
# once made `ergon sync` refuse to run on that machine. Gitignoring the outputs
# removes that without moving where they are written. Rendering still targets
# the repo path, which is what keeps link() pointing at something real.
#
# What that costs, and it is not nothing: a fresh clone has no rendered files,
# and hypr/common/looknfeel.lua is one of them. hypr/hyprland.lua requires it
# WITHOUT a pcall, and a Lua config is one chunk -- so a missing looknfeel.lua
# does not mean an unthemed desktop, it means the requires after it never run:
# no keybinds, no autostart, no waybar, no notifications. Measured, not feared.
# That is why install.sh renders before it links and treats a failure here as
# fatal, and why this script is the thing that creates the user override files
# (lib/user-config.sh) rather than leaving that to a separate step.
#
# Unexpanded placeholders are a hard error. A silently un-substituted @COOL_X@
# in a CSS file is invisible -- the rule is simply dropped and the surface
# renders with a default colour that looks plausible.
set -euo pipefail

# pwd -P, not pwd: ~/ergonOS is a symlink into ~/projects on every host, and
# `find` does not descend into a symlinked starting directory without -L. With
# the logical path this script finds zero templates and cheerfully reports
# "up to date" forever, on every machine, having rendered nothing.
# readlink -f: this is reached through /usr/local/bin/<name>, which is a symlink
# into the repo. Without resolving it, BASH_SOURCE is the symlink's own path and
# the root comes out as /usr/local -- so every repo-relative file is looked for
# somewhere it cannot be. ergon-wallpaper died exactly that way, under set -e,
# before it could start hyprpaper, and the desktop had no wallpaper.
ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
# The user's half of the desktop, and the only code that creates it. Sourced
# here rather than in install.sh because the include lines that point at those
# files are written by THIS script -- keeping the two together is what stops a
# skipped step from leaving waybar importing a stylesheet that is not there.
# shellcheck source=../lib/user-config.sh
. "$ERGON/lib/user-config.sh"

CHECK=0; [ "${1:-}" = "--check" ] && { CHECK=1; shift; }
# --no-apply renders the config files and stops: nothing is reloaded, nothing
# is signalled, nothing is restarted and no terminal is written to. For callers
# that need the rendered files to be correct but must not disturb a session
# someone is using -- the VM harness re-renders after syncing the repo, and
# restarting the bar under someone who is looking at it is not an acceptable
# side effect of a file sync.
APPLY=1; [ "${1:-}" = "--no-apply" ] && { APPLY=0; shift; }

# ONE palette, and that is a decision rather than an unfinished job.
#
# `cool` is not a preference: matplotlib/matplotlibrc sets image.cmap to cool
# because every plot this machine makes uses cool, and theme/cool.env is that
# same ramp -- COOL_0 and COOL_4 are its endpoints. That is why btop's
# temperature gradient and a hot line in a figure are the same colour, and it is
# the only reason the palette means anything rather than merely looking a way.
#
# A second SHIPPED palette would break exactly that. "Warm mode" would put the
# desktop and the figures in different languages, and the coupling is the point.
#
# But the coupling is an argument about THIS user, not about everyone: someone
# who does not plot in cool inherits none of it. So the palette is a variable
# they can point elsewhere, while the shipped default stays the one that is
# tested and coherent.
#
#   ergon theme                 re-render the palette in use
#   ergon theme warm            switch to theme/warm.env
#   ergon theme ~/mine.env      any file
#   ergon theme --list          what is available, and what is active
#
# The choice is REMEMBERED, in $XDG_STATE_HOME/ergon/palette. Without that,
# `ergon theme` with no argument after switching would quietly render the
# default back over your choice -- and install.sh runs it on every session.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ergon"
PALETTE_FILE="$STATE/palette"

# --current prints just the active palette's name, for a status bar or a prompt
# to read. Separate from --list because a caller that wants one word should not
# have to parse a decorated list to find the line with the asterisk on it.
if [ "${1:-}" = "--current" ]; then
  _active=$( [ -f "$PALETTE_FILE" ] && cat "$PALETTE_FILE" || echo cool )
  basename "$_active" .env
  exit 0
fi

if [ "${1:-}" = "--list" ]; then
  _active=$( [ -f "$PALETTE_FILE" ] && cat "$PALETTE_FILE" || echo cool )
  for _p in "$ERGON"/theme/*.env; do
    _n=$(basename "$_p" .env)
    [ "$_n" = "$_active" ] && printf '   * %s\n' "$_n" || printf '     %s\n' "$_n"
  done
  exit 0
fi

# --next / --prev step through theme/*.env in name order, wrapping. This is how
# a palette is CHOSEN: comparing six of them by editing a name in a command is
# not comparing them, and the difference between two neighbouring palettes is
# only visible if the desktop in front of you flips between them. Bound to a key
# in hypr/, so the comparison is a keypress.
#
# An active palette from outside theme/ (a candidate on a scratch path) has no
# position in that list, so stepping from it starts at the first entry rather
# than failing.
case "${1:-}" in
  --next|--prev)
    _dir="$1"; shift
    _all=(); for _p in "$ERGON"/theme/*.env; do _all+=("$(basename "$_p" .env)"); done
    [ "${#_all[@]}" -gt 1 ] || { echo "only one palette installed" >&2; exit 0; }
    _cur=$( [ -f "$PALETTE_FILE" ] && cat "$PALETTE_FILE" || echo cool )
    _i=-1; for _n in "${!_all[@]}"; do [ "${_all[$_n]}" = "$_cur" ] && { _i=$_n; break; }; done
    if [ "$_i" -lt 0 ]; then
      _j=0
    elif [ "$_dir" = --next ]; then
      _j=$(( (_i + 1) % ${#_all[@]} ))
    else
      _j=$(( (_i - 1 + ${#_all[@]}) % ${#_all[@]} ))
    fi
    set -- "${_all[$_j]}"
    ;;
esac

if [ -n "${1:-}" ]; then
  _want="$1"
elif [ -n "${ERGON_PALETTE:-}" ]; then
  _want="$ERGON_PALETTE"
elif [ -f "$PALETTE_FILE" ]; then
  _want=$(cat "$PALETTE_FILE")
else
  _want=cool
fi

case "$_want" in
  /*|./*|../*) PALETTE="$_want" ;;
  *)           PALETTE="$ERGON/theme/$_want.env" ;;
esac
[ -f "$PALETTE" ] || PALETTE="$_want"

[ -f "$PALETTE" ] || {
  echo "no palette '$_want' (try: ergon theme --list)" >&2; exit 1
}
if [ "$CHECK" != 1 ]; then
  mkdir -p "$STATE"
  # Record the full path for a palette outside theme/, so it can be found
  # again; a bare basename would resolve to theme/<name>.env, which may not
  # exist. ergon-wallpaper reads this same file.
  case "$PALETTE" in
    "$ERGON"/theme/*) basename "$PALETTE" .env > "$PALETTE_FILE" ;;
    *)                printf '%s\n' "$PALETTE" > "$PALETTE_FILE" ;;
  esac
fi

# Build the sed program from the palette. Keys are validated so a stray line in
# cool.env cannot inject sed syntax.
SEDPROG=$(mktemp); trap 'rm -f "$SEDPROG"' EXIT
while IFS='=' read -r k v; do
  case "$k" in
    ''|'#'*) continue ;;
    COOL_[A-Z0-9_]*) ;;
    *) echo "bad key in cool.env: $k" >&2; exit 1 ;;
  esac
  v="${v%%[[:space:]]*}"                       # strip trailing comments
  case "$v" in
    '#'[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
    *) echo "$k is not a 6-digit hex colour: '$v'" >&2; exit 1 ;;
  esac
  # Two forms: @COOL_X@ -> #RRGGBB, and @COOL_X:raw@ -> RRGGBB (hyprland wants
  # 0xAARRGGBB or bare hex; CSS and ini want the hash).
  printf 's|@%s@|%s|g\ns|@%s:raw@|%s|g\n' "$k" "$v" "$k" "${v#\#}" >> "$SEDPROG"
done < "$PALETTE"

# Derived, non-colour substitutions.
#
# These cannot live in the palette file: every value there is validated as a
# 6-digit hex, deliberately, so that a typo cannot become a sed program. They
# are computed here instead -- and computing them is better than declaring them
# anyway, because a palette that SAYS it is dark while shipping a light
# background is a contradiction nobody notices until the desktop is unreadable.
#
# Light or dark is decided by the relative luminance of the background, by the
# usual Rec. 709 weights. Integer arithmetic: this is /bin/sh maths, and the
# threshold is 50% of 255.
# Read from the file rather than a shell variable: this script never sources
# the palette (sourcing would execute it), so COOL_BG0 is not in scope here.
_bg0=$(sed -n 's/^COOL_BG0=\(#[0-9A-Fa-f]\{6\}\).*/\1/p' "$PALETTE" | head -1)
[ -n "$_bg0" ] || { echo "palette has no COOL_BG0: $PALETTE" >&2; exit 1; }
_hex=${_bg0#\#}
_r=$((16#${_hex:0:2})); _g=$((16#${_hex:2:2})); _b=$((16#${_hex:4:2}))
_lum=$(( (2126 * _r + 7152 * _g + 722 * _b) / 10000 ))
if [ "$_lum" -gt 127 ]; then
  MODE=light; PREFER_DARK=0; GTK_THEME=Adwaita;      ICON_THEME=Papirus-Light
else
  MODE=dark;  PREFER_DARK=1; GTK_THEME=Adwaita-dark; ICON_THEME=Papirus-Dark
fi
{
  printf 's|@COOL_MODE@|%s|g\n'        "$MODE"
  printf 's|@COOL_PREFER_DARK@|%s|g\n' "$PREFER_DARK"
  printf 's|@COOL_GTK_THEME@|%s|g\n'   "$GTK_THEME"
  printf 's|@COOL_ICON_THEME@|%s|g\n'  "$ICON_THEME"
} >> "$SEDPROG"

rc=0; rendered=0; changed=0
while IFS= read -r tpl; do
  out="${tpl%.in}"
  new=$(sed -f "$SEDPROG" "$tpl")

  if leftover=$(printf '%s\n' "$new" | grep -oE '@COOL_[A-Z0-9_]+(:raw)?@' | sort -u); then
    echo "!! $tpl references undefined colours:" >&2
    # Unquoted on purpose: grep -o gives one placeholder per line and the
    # split is what puts each on its own printf iteration.
    # shellcheck disable=SC2086
    printf '     %s\n' $leftover >&2
    rc=1; continue
  fi

  rendered=$((rendered+1))
  if [ -f "$out" ] && [ "$new" = "$(cat "$out")" ]; then continue; fi
  changed=$((changed+1))
  if [ "$CHECK" = 1 ]; then
    echo "   stale: ${out#"$ERGON"/}"
    rc=1
  else
    # Written to a neighbour and renamed, never straight into place. Two renders
    # can overlap -- the VM harness re-renders on every file sync while a
    # palette switch is running the same script -- and `> "$out"` truncates
    # first and writes second, so the overlap is a window in which a config
    # file is empty or half a file. For hypr/common/looknfeel.lua that is a Lua
    # syntax error in the middle of the compositor's config, which costs every
    # keybinding in the session (see hypr/hyprland.lua). A rename is atomic:
    # a reader gets the old file or the new one.
    _tmp="$out.ergon-render.$$"
    if printf '%s\n' "$new" > "$_tmp" && mv -f "$_tmp" "$out"; then
      echo "   rendered ${out#"$ERGON"/}"
    else
      rm -f "$_tmp"
      echo "!! could not write ${out#"$ERGON"/}" >&2
      rc=1
    fi
  fi
done < <(find -L "$ERGON" -name '*.in' -not -path '*/.git/*' | sort)

if [ "$CHECK" = 1 ]; then
  [ "$changed" = 0 ] && echo "   $rendered rendered files are up to date"
  exit $rc
fi
[ "$changed" = 0 ] && echo "   $rendered files already up to date"

# The files the rendering above just pointed at. waybar, mako, fuzzel and foot
# do not merely lose their override when this is missing -- they fail to start
# or fail their own --check-config, and in waybar's case GTK throws away the
# whole stylesheet rather than the one bad line. So this is part of rendering,
# not a separate courtesy, and its failure is the render's failure.
ergon_ensure_user_files || rc=1

# Recolour the foot windows that are already open.
#
# Everything else in the apply step below either re-reads a file (mako, btop)
# or is restarted (waybar, swayosd). A terminal can do neither: it holds your
# shell, your history and whatever is running in it. What it can do is accept
# the colours as escape sequences on its own output stream -- OSC 4, 10, 11,
# 12, 17 and 19, all six of which foot documents and implements
# (foot-ctlseqs(7)).
#
# The sequences are built from the RENDERED foot.ini, not from the palette
# directly. Which palette role lands in which ANSI slot is decided once, in
# foot/foot.ini.in, and writing that mapping out a second time here is exactly
# how the two would drift -- a palette that is right in new windows and wrong
# in the one you are looking at is worse than one that is wrong everywhere.
# Reading the file back also means this follows the template automatically when
# a slot is reassigned.
foot_osc() {
  local ini="$ERGON/foot/foot.ini"
  [ -f "$ini" ] || return 0
  # [colors-dark] and [colors-light] carry the same palette -- see the
  # template's header for why both exist -- so the first of them answers.
  # BEL rather than ST as the terminator: both are accepted, and a lone
  # backslash through awk, bash and a pty is three chances to be wrong.
  awk '
    /^\[colors-(dark|light)\]/ { sec++; next }
    /^\[/                       { if (sec) exit }
    sec != 1                    { next }
    /^[ \t]*[#;]/               { next }
    /=/ {
      split($0, kv, "=")
      k = kv[1]; v = kv[2]
      gsub(/[ \t]/, "", k)
      sub(/[#;].*/, "", v); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (v == "") next
      # cursor is two colours -- "text cursor" -- and OSC 12 sets the second.
      if (k == "cursor") { n = split(v, c, /[ \t]+/); v = c[n] }
      if      (k == "foreground")           printf "\033]10;#%s\007", v
      else if (k == "background")           printf "\033]11;#%s\007", v
      else if (k == "cursor")               printf "\033]12;#%s\007", v
      else if (k == "selection-background") printf "\033]17;#%s\007", v
      else if (k == "selection-foreground") printf "\033]19;#%s\007", v
      else if (k ~ /^regular[0-7]$/)        printf "\033]4;%d;#%s\007", substr(k, 8) + 0, v
      else if (k ~ /^bright[0-7]$/)         printf "\033]4;%d;#%s\007", substr(k, 7) + 8, v
    }
  ' "$ini" 2>/dev/null || true
}

# Every pty that a running foot is the far end of. foot's own child is the
# shell, and the shell's controlling terminal is the slave side -- writing
# there is indistinguishable from the shell printing, which is what makes foot
# parse it. It is also why this cannot disturb what is running: an OSC colour
# sequence produces no output and moves no cursor.
foot_windows() {
  local pid child tty
  # -u: this user's terminals only. Run as root -- which `ergon theme` is not,
  # but nothing stops it -- an unrestricted pgrep would reach into every foot
  # on the machine and write escape sequences into other people's shells.
  for pid in $(pgrep -u "$(id -u)" -x foot 2>/dev/null || true); do
    for child in $(pgrep -P "$pid" 2>/dev/null || true); do
      tty=$(ps -o tty= -p "$child" 2>/dev/null | tr -d '[:space:]')
      case "$tty" in pts/[0-9]*) printf '/dev/%s\n' "$tty" ;; esac
    done
  done
}

# Rendering a config is not applying it. Every running program already has the
# old colours in memory: hyprland holds its border colours, waybar parses its
# CSS once at startup, and the wallpaper is a PNG that has to be redrawn from
# the new ramp. Leaving this to the caller meant `ergon theme winter` changed
# nothing visible and looked broken -- and the VM harness grew its own private
# copy of these four steps, which then drifted from the real thing.
#
# Only when there is a compositor to talk to: this also runs from install.sh on
# a tty and from CI, where there is not.
if [ "$APPLY" = 1 ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1; then
  echo "   applying"
  # One apply at a time, for the reason autostart.lua names in its own header:
  # you end up with two waybars.
  #
  # This step kills two daemons, waits half a second, and starts them again.
  # SUPER+T is bound to `ergon theme --next` so that nineteen palettes can be
  # compared by holding a key, and a second press landing inside that gap finds
  # nothing to kill and starts a second pair -- which then survive until
  # logout, both drawing. Measured with stubs: two runs 200ms apart, two
  # waybars.
  #
  # flock and not a pid check: the same shape bin/ergon-wallpaper already uses,
  # and for the same reason -- the later press is the one whose palette should
  # win, so it queues rather than giving up.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ergon-theme-apply.lock"
    flock -w 10 9 || echo "   another apply is still running; carrying on without the lock" >&2
  fi
  # Re-colour the generated backgrounds for the palette just chosen.
  #
  # They are coloured FROM the palette, so before this a palette switch left
  # the new palette with no backgrounds at all and the desktop fell back to the
  # plain gradient -- the images were not lost, they simply did not exist in
  # that palette yet. Re-colouring runs from cached fields, so it is seconds
  # rather than the minutes a re-simulation would take.
  #
  # Detached, because even seconds should not be spent between pressing the
  # keybind and the palette appearing. It sets the background itself when it
  # finishes.
  if command -v ergon-wallpaper-gen >/dev/null 2>&1; then
    #
    # 9>&- closes the apply lock in the child. Without it the detached
    # recolour INHERITS the lock fd and holds it for as long as it runs --
    # minutes -- so the next press of the palette key waits out the whole
    # `flock -w 10` before anything moves. Measured: 10.7s of nothing, where
    # the unlocked code took 0.6s. A lock that outlives the thing it protects
    # is worse than no lock, and this is the shape that does it.
    ( setsid ergon-wallpaper-gen --recolour >/dev/null 2>&1 9>&- & ) || true
  fi
  # GTK4 and libadwaita read the theme from gsettings, NOT from settings.ini,
  # so a light palette that only rewrote the ini would leave every GTK4 app
  # dark. Needs a session bus, which is why this is here and not in the
  # provisioner -- provisioning over ssh has none.
  if command -v gsettings >/dev/null 2>&1; then
    _cs=$( [ "$MODE" = light ] && echo prefer-light || echo prefer-dark )
    gsettings set org.gnome.desktop.interface color-scheme "$_cs"       2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme   "$GTK_THEME"  2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme  "$ICON_THEME" 2>/dev/null || true
  fi
  "$ERGON/bin/ergon-wallpaper" --force >/dev/null 2>&1 || true
  hyprctl reload >/dev/null 2>&1 || true
  # waybar and swayosd both parse everything they draw exactly once, at
  # startup, and neither can be told to read it again: waybar's SIGUSR2 reloads
  # the config and keeps the parsed CSS, which is the half carrying the
  # palette, and swayosd-server has no signal handler at all -- it loads the
  # system sheet and then ~/.config/swayosd/style.css in main() and never looks
  # again. Restarting is the only thing that recolours either.
  #
  # Killed together and respawned together, so a palette switch costs one 0.5s
  # gap between the keybind and a repainted desktop rather than two.
  pkill -x waybar         >/dev/null 2>&1 || true
  pkill -x swayosd-server >/dev/null 2>&1 || true
  sleep 0.5
  hyprctl dispatch 'hl.dsp.exec_raw("waybar")'         >/dev/null 2>&1 || true
  hyprctl dispatch 'hl.dsp.exec_raw("swayosd-server")' >/dev/null 2>&1 || true

  # mako does have a reload, and it keeps the notifications already on screen.
  makoctl reload >/dev/null 2>&1 || true

  # btop rereads its THEME on SIGUSR2, not merely its config: the handler sets
  # reload_conf, and the reload path calls Theme::updateThemes() and
  # Theme::setTheme() (btop.cpp). So an open btop on another workspace follows
  # the palette without being restarted under someone who is watching it.
  #
  # Except when the GPU box is shown. btop#860 is open: the redraw after a
  # reload indexes past the end of a vector in Gpu::draw and the process dies
  # with SIGABRT. Omarchy ships this exact signal and collected the bug report
  # (omarchy#8711). A stale btop is a nuisance; a btop that disappears when you
  # change palette is the desktop breaking in front of you, so the signal is
  # sent only where the crash cannot happen.
  #
  # Read from btop.conf rather than from the running process, and btop writes
  # that file when it EXITS -- so a box toggled on with `6` in this session and
  # never saved is not visible here. That window is the one case this misses,
  # and it is smaller than the one it covers.
  _btopconf="${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf"
  if ! grep -qE '^shown_boxes.*gpu' "$_btopconf" 2>/dev/null; then
    pkill -USR2 -x btop >/dev/null 2>&1 || true
  fi

  # And the terminals, which cannot be restarted at all. Not wezterm: it
  # watches its own config file and reloads without being asked
  # (automatically_reload_config, which wezterm.lua.in does not override), so
  # it is the one surface here that was never stale.
  #
  # Through `timeout`, because a write to a pty is a write to a buffer that a
  # wedged terminal is not draining: the palette keybind must not be able to
  # hang on the one window that has stopped reading. A second is four orders of
  # magnitude more than half a kilobyte needs.
  if _osc=$(foot_osc) && [ -n "$_osc" ]; then
    while IFS= read -r _pts; do
      timeout 1 sh -c 'printf "%s" "$1" > "$2"' _ "$_osc" "$_pts" 2>/dev/null || true
    done < <(foot_windows)
  fi
fi
exit $rc
