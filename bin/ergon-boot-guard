#!/usr/bin/env bash
# ergon:summary=Boot the last known-good snapshot after repeated failed boots
# ergon:group=system
# ergon:args=install | ok | status | disable
# ergon:help=native
#
# Snapshots are bootable already (the boot menu lists them) and ergon-rollback
# can make one permanent. Both need someone who knows that, at a boot menu, on
# a machine that has just failed to boot. This closes the gap: two boots that
# never reach the default target, and the third boots the last snapshot that
# did.
#
#   install   arm the counter, the fallback entry and the success unit
#   ok        run by ergon-boot-ok.service once the default target is reached:
#             re-arms the counter and records the newest snapshot as known-good
#   status    the counter, the known-good snapshot, what / is mounted from
#   disable   remove all of it
#
# Two layouts (lib/bootloader.sh):
#
#   systemd-boot  (installs from ERGON-123) the counter is systemd-boot's own
#                 boot counting: the main entry is ergon-linux+2.conf, the
#                 loader renames it +1-1, then +0-2, and an entry with no tries
#                 left sorts last, so the fallback entry (sort-key ergon-2,
#                 written by ergon-boot-entries) becomes the default. The
#                 known-good number is EFI/ergon/known-good on the ESP.
#                 systemd-bless-boot is masked: it would mark a boot good long
#                 before the default target, and drop the counter for good.
#   grub          (older installs) a counter in a grubenv on the EFI partition,
#                 written by grub/09_ergon_boot_counter, and a fallback entry
#                 from grub/99_ergon_boot_fallback. Two files because in one the
#                 entry came out first, which makes it the default every time.
#
# Falling back is never sticky: a successful boot of the snapshot re-arms the
# counter too, and says how to keep it or how to go back.
set -euo pipefail

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
# shellcheck source=../lib/bootloader.sh
. "$ERGON/lib/bootloader.sh"
COUNTER_SRC="$ERGON/grub/09_ergon_boot_counter"
FALLBACK_SRC="$ERGON/grub/99_ergon_boot_fallback"
COUNTER=/etc/grub.d/09_ergon_boot_counter
FALLBACK=/etc/grub.d/99_ergon_boot_fallback
# The one-file version put the fallback entry BEFORE the normal ones, where it
# became entry 0 and GRUB booted it every time. Left behind, it would still do
# that, so it is removed on every install.
OLD_SNIPPET=/etc/grub.d/09_ergon_boot_guard
UNIT=/etc/systemd/system/ergon-boot-ok.service
TRIES="${ERGON_GUARD_TRIES:-2}"
SNAPDIR="${ERGON_GUARD_SNAPDIR:-/.snapshots}"
LAYOUT=$(ergon_boot_layout)

ok()   { printf '   ok   %s\n' "$*"; }
warn() { printf '   !!   %s\n' "$*" >&2; }
die()  { printf '   !!   %s\n' "$*" >&2; exit 1; }

_envfile() { printf '%s/EFI/ergon/grubenv\n' "$1"; }
_fsroot()  { findmnt -no FSROOT / 2>/dev/null; }
_on_snapshot() { case "$(_fsroot)" in /@snapshots/*) return 0 ;; *) return 1 ;; esac; }
_snapnum() { _fsroot | sed -n 's|^/@snapshots/\([0-9]*\)/snapshot$|\1|p'; }

# snapper numbers snapshots upward, so the newest is the largest. Taken at a
# successful boot, this is the state that booted -- which, after an update that
# breaks the next boot, is exactly the one to go back to.
_newest_snapshot() {
  local n best=0
  for n in "$SNAPDIR"/*/; do
    n=${n%/}; n=${n##*/}
    case $n in ''|*[!0-9]*) continue ;; esac
    [ "$n" -gt "$best" ] && best=$n
  done
  [ "$best" -gt 0 ] && printf '%s\n' "$best"
}

_get() {  # _get <envfile> <key>
  grub-editenv "$1" list 2>/dev/null | sed -n "s/^$2=//p" | head -1
}

# --- systemd-boot ------------------------------------------------------------
# The main entry, whatever counter its name carries.
_sd_main() {
  local f
  for f in "$ESP/loader/entries/ergon-linux.conf" "$ESP/loader/entries/ergon-linux"+*.conf; do
    [ -e "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}
_sd_tries() {  # tries left, from the name; "off" when it carries no counter
  local f; f=$(_sd_main) || { echo none; return; }
  case "${f##*/}" in
    ergon-linux+*.conf) f=${f##*+}; f=${f%.conf}; echo "${f%%-*}" ;;
    *) echo off ;;
  esac
}
_sd_arm() {  # rename the main entry to carry a fresh counter
  local f new
  f=$(_sd_main) || die "no ergon-linux entry on the ESP (ergon-boot-entries sync)"
  new="$ESP/loader/entries/ergon-linux+$TRIES.conf"
  [ "$f" = "$new" ] || sudo mv "$f" "$new"
}
_sd_good() { tr -dc '0-9' < "$ESP/EFI/ergon/known-good" 2>/dev/null || true; }
_sd_record() {  # _sd_record <snapshot>
  printf '%s\n' "$1" | sudo tee "$ESP/EFI/ergon/known-good" >/dev/null
  sudo "$ERGON/bin/ergon-boot-entries" sync >/dev/null
}

_write_unit() {  # _write_unit <condition path>
  sudo install -Dm644 /dev/stdin "$UNIT" <<UNITF
# Written by ergon-boot-guard. Marks this boot good once the machine reaches the
# target it boots to, which is what re-arms the boot counter.
[Unit]
Description=Mark this boot as good (ergon boot guard)
After=default.target
ConditionPathExists=$1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$ERGON/bin/ergon-boot-guard ok

[Install]
WantedBy=default.target
UNITF
  sudo systemctl daemon-reload
  sudo systemctl enable ergon-boot-ok.service >/dev/null
}

case "${1:-status}" in -h|--help|help) ;; *)
  [ "$LAYOUT" != none ] || { echo "   no systemd-boot or GRUB configuration here; the boot guard does not apply"; exit 0; }
  # The ESP is root-only on systemd-boot installs (umask 0077): even reading
  # the counter in an entry's name needs root.
  if [ "$LAYOUT" = systemd-boot ] && ! ergon_esp_access; then exec sudo "$0" "$@"; fi ;;
esac

case "${1:-status}" in

install)
  ESP=$(ergon_esp) || die "no EFI partition mounted (looked at /efi, /boot/efi, /boot)"
  [ "$(findmnt -no FSTYPE /)" = btrfs ] || die "/ is not btrfs; this needs the snapshot layout"
  [ -d "$SNAPDIR" ] || die "no $SNAPDIR; this needs snapper's layout"

  if [ "$LAYOUT" = systemd-boot ]; then
    sudo "$ERGON/bin/ergon-boot-entries" sync >/dev/null
    _sd_arm
    # It would bless the boot at boot-complete.target, before the default
    # target is known to be up, and take the counter off the entry.
    sudo systemctl mask systemd-bless-boot.service >/dev/null 2>&1 || true
    _write_unit "$ESP/loader/entries"
    if [ -z "$(_sd_good)" ] && ! _on_snapshot && snap=$(_newest_snapshot); then
      _sd_record "$snap"
    fi
    [ "$(_sd_tries)" = "$TRIES" ] || die "the main entry does not carry the counter"
    ok "boot guard: after $TRIES failed boots, the last known-good snapshot boots instead"
    exit 0
  fi

  for f in "$COUNTER_SRC" "$FALLBACK_SRC"; do [ -f "$f" ] || die "missing $f"; done
  ESPUUID=$(findmnt -no UUID "$ESP")
  [ -n "$ESPUUID" ] || die "could not read $ESP's UUID"
  command -v grub-editenv >/dev/null || die "grub-editenv is not installed"

  ENVF=$(_envfile "$ESP")
  sudo mkdir -p "$(dirname "$ENVF")"
  # `create` writes the 1024-byte block GRUB later rewrites in place. Created
  # once only: recreating it would throw away the known-good snapshot.
  [ -f "$ENVF" ] || sudo grub-editenv "$ENVF" create
  sudo grub-editenv "$ENVF" set ergon_tries="$TRIES"

  sudo rm -f "$OLD_SNIPPET"
  sudo install -Dm755 "$COUNTER_SRC" "$COUNTER"
  sudo install -Dm755 "$FALLBACK_SRC" "$FALLBACK"
  _write_unit "$COUNTER"
  sudo grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 \
    || die "grub-mkconfig failed; the snippets are in place but grub.cfg was not rebuilt"
  # The whole mechanism is this entry existing. Assert it rather than trusting
  # that a script in /etc/grub.d ran.
  grep -q 'ergon-fallback' /boot/grub/grub.cfg || die "the fallback entry did not reach grub.cfg"
  ok "boot guard: after $TRIES failed boots, the last known-good snapshot boots instead"
  ;;

ok)
  ESP=$(ergon_esp) || exit 0
  if [ "$LAYOUT" = systemd-boot ]; then
    _sd_main >/dev/null || exit 0
  else
    ENVF=$(_envfile "$ESP")
    [ -f "$ENVF" ] || exit 0
  fi

  # systemd running this unit does NOT mean the boot worked. `After=` only
  # orders it: when the default target fails, its job fails but this one still
  # runs, and the counter was cleared on every broken boot -- the guard could
  # never fire. Ask what the target actually did instead.
  #
  # Polled, because the unit can be reached while the target is still
  # activating, and refusing then would mean never clearing the counter.
  target=$(systemctl get-default 2>/dev/null || echo default.target)
  state=""
  for _ in $(seq 60); do
    state=$(systemctl is-active "$target" 2>/dev/null || true)
    [ "$state" = active ] && break
    sleep 1
  done
  if [ "$state" != active ]; then
    warn "$target is $state, so this boot is not being marked good (the guard keeps counting)"
    exit 0
  fi

  if [ "$LAYOUT" = systemd-boot ]; then
    _sd_arm
  else
    sudo grub-editenv "$ENVF" set ergon_tries="$TRIES"
    sudo grub-editenv "$ENVF" unset ergon_fell_back 2>/dev/null || true
  fi
  if _on_snapshot; then
    # This boot came FROM the fallback. Re-arm the counter so the machine is
    # not stuck here, but leave the known-good marker alone: a snapshot booted
    # in anger is the old good state, not a new one.
    warn "this is the last known-good snapshot (number $(_snapnum)), booted automatically after failed boots"
    warn "keep it:      sudo ergon-rollback $(_snapnum)"
    warn "or reboot to try the normal system again"
    exit 0
  fi
  snap=$(_newest_snapshot || true)
  [ -n "${snap:-}" ] || exit 0
  if [ "$LAYOUT" = systemd-boot ]; then
    _sd_record "$snap"
  else
    sudo grub-editenv "$ENVF" set ergon_good_snapshot="$snap"
  fi
  ;;

# record <n>: set the known-good snapshot and re-arm the counter, without the
# health check ok makes. For bin/test-boot-guard.sh, which arms its test on a
# boot that may have inherited a break.
record)
  [ -n "${2:-}" ] || die "usage: ergon-boot-guard record <snapshot>"
  ESP=$(ergon_esp) || die "no EFI partition mounted"
  if [ "$LAYOUT" = systemd-boot ]; then
    _sd_record "$2"; _sd_arm
  else
    ENVF=$(_envfile "$ESP")
    sudo grub-editenv "$ENVF" set ergon_good_snapshot="$2"
    sudo grub-editenv "$ENVF" set ergon_tries="$TRIES"
  fi
  ;;

# get tries|good: one value, for scripts.
get)
  ESP=$(ergon_esp) || die "no EFI partition mounted"
  case "${2:-}" in
    tries) if [ "$LAYOUT" = systemd-boot ]; then _sd_tries; else _get "$(_envfile "$ESP")" ergon_tries; fi ;;
    good)  if [ "$LAYOUT" = systemd-boot ]; then _sd_good; else _get "$(_envfile "$ESP")" ergon_good_snapshot; fi ;;
    *) die "usage: ergon-boot-guard get tries|good" ;;
  esac
  ;;

status)
  ESP=$(ergon_esp) || die "no EFI partition mounted"
  if [ "$LAYOUT" = systemd-boot ]; then
    [ -f "$UNIT" ] || die "boot guard is not installed (ergon-boot-guard install)"
    printf '   bootloader:                  systemd-boot\n'
    printf '   tries left before fallback:  %s\n' "$(_sd_tries)"
    printf '   known-good snapshot:         %s\n' "$(_sd_good)"
  else
    ENVF=$(_envfile "$ESP")
    { [ -f "$COUNTER" ] && [ -f "$FALLBACK" ] && [ -f "$ENVF" ]; } || die "boot guard is not installed (ergon-boot-guard install)"
    printf '   bootloader:                  GRUB\n'
    printf '   tries left before fallback:  %s\n' "$(_get "$ENVF" ergon_tries)"
    printf '   known-good snapshot:         %s\n' "$(_get "$ENVF" ergon_good_snapshot)"
  fi
  printf '   / is mounted from:           %s\n' "$(_fsroot)"
  if _on_snapshot; then
    warn "running the fallback snapshot: ergon-rollback $(_snapnum) keeps it, a reboot retries the normal system"
  else
    ok "running the normal root"
  fi
  if systemctl is-enabled ergon-boot-ok.service >/dev/null 2>&1; then
    ok "ergon-boot-ok.service is enabled"
  else
    warn "ergon-boot-ok.service is not enabled, so nothing re-arms the counter"
  fi
  if [ "$LAYOUT" = systemd-boot ]; then
    [ -f "$ESP/loader/entries/ergon-fallback.conf" ] \
      && ok "the fallback entry is on the ESP" || warn "no fallback entry on the ESP yet (no known-good snapshot)"
  else
    grep -q 'ergon-fallback' /boot/grub/grub.cfg 2>/dev/null \
      && ok "the fallback entry is in grub.cfg" || warn "no fallback entry in grub.cfg (grub-mkconfig?)"
  fi
  ;;

disable)
  sudo systemctl disable --now ergon-boot-ok.service >/dev/null 2>&1 || true
  sudo rm -f "$UNIT"
  if [ "$LAYOUT" = systemd-boot ]; then
    ESP=$(ergon_esp) || die "no EFI partition mounted"
    if f=$(_sd_main) && [ "$f" != "$ESP/loader/entries/ergon-linux.conf" ]; then
      sudo mv "$f" "$ESP/loader/entries/ergon-linux.conf"
    fi
    sudo rm -f "$ESP/EFI/ergon/known-good"
    sudo systemctl unmask systemd-bless-boot.service >/dev/null 2>&1 || true
    sudo "$ERGON/bin/ergon-boot-entries" sync >/dev/null || true
    sudo systemctl daemon-reload 2>/dev/null || true
    ok "boot guard removed"
  else
    sudo rm -f "$COUNTER" "$FALLBACK" "$OLD_SNIPPET"
    sudo systemctl daemon-reload 2>/dev/null || true
    sudo grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || warn "grub-mkconfig failed"
    ok "boot guard removed (the grubenv on the EFI partition is left alone)"
  fi
  ;;

-h|--help|help) sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command '$1' (install|ok|record|get|status|disable)" ;;
esac
