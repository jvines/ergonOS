#!/usr/bin/env bash
# ergon:summary=Back-of-the-envelope with units
# ergon:group=data
# ergon:args=<expression>
# ergon:help=native
#
#   ergon calc '3 Rjup in Rearth'
#   ergon calc '1 AU / c in minutes'
#
# astropy.units underneath, so a dimensional mistake fails loudly instead of
# producing a plausible number. Faster than opening a REPL, which is the only
# reason it exists.
set -euo pipefail

# ERGON-30: answered here, ahead of the pyfleet-venv check -- see ergon-cite
# for the fuller reasoning.
for a in "$@"; do
  case "$a" in
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  esac
done

ERGON="$(cd "${ERGON:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..}" && pwd -P)"
VENV="${PYFLEET_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/pyfleet}"
[ -x "$VENV/bin/python" ] || { echo "ergon-calc: run: pyfleet sync" >&2; exit 1; }
exec "$VENV/bin/python" "$ERGON/lib/ergon_calc.py" "$@"
