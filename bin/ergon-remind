#!/usr/bin/env bash
# ergon:summary=Reminders and timers that pop up as a notification that stays until dismissed
# ergon:group=system
# ergon:args=[--alert] [<when> <message> | list | clear [id|all]]
#
# SUPER+CTRL+R with no arguments asks for a time in fuzzel, then a message.
#
#   ergon remind 25m "take flats"       in 25 minutes (also 90s, 2h, 1h30m; a bare 10 is minutes)
#   ergon remind 14:30 "seminar"        at 14:30 (tomorrow if that has passed today)
#   ergon remind "tomorrow 9:00" "x"    anything else is handed to `date -d`
#   ergon remind list                   what is pending, with ids
#   ergon remind clear [id|all]         cancel one, or all (the default)
#   --alert                             also raise it through ergon-alert, which reaches
#                                       an Alertmanager when ERGON_ALERT_URL is set
#
# A reminder is a transient systemd user timer, ergon-remind-<id>.timer, firing
# a notify-send (critical, so mako never expires it; app name ergon-remind).
# There is no state file: `list` and `clear` ask the user manager, and the unit
# is gone after it fires, at logout and at reboot.
#
# The timer is OnCalendar with a wall-clock time worked out here, not
# OnActiveSec: a monotonic timer does not count time spent suspended, so a 25
# minute reminder set before closing the lid would be late by the whole sleep.
# AccuracySec=1s because the default of one minute would make "5s" mean "up to
# a minute". Nothing is left running in the caller's shell: systemd-run returns
# once the unit is queued and its output is captured, not inherited.
set -euo pipefail
export LC_ALL=C

PFX=ergon-remind-
SELF=$(readlink -f "${BASH_SOURCE[0]}")
die() { echo "ergon-remind: $*" >&2; [ -t 2 ] || notify-send -a ergon-remind -u normal "ergon remind" "$*" >/dev/null 2>&1 || true; exit 1; }
say() { notify-send -a ergon-remind -u low -t 4000 "Reminder" "$1" >/dev/null 2>&1 || true; echo "$1"; }

# parse_when <text>: sets EPOCH, or dies with a message that says what was wrong.
parse_when() {
  local t=${1,,} now d=0 n u rest
  now=$(date +%s)
  if [[ $t =~ ^[0-9]+$ ]]; then
    EPOCH=$((now + 10#$t * 60))
  elif [[ $t =~ ^([0-9]+[dhms])+$ ]]; then
    rest=$t
    while [[ $rest =~ ^([0-9]+)([dhms])(.*)$ ]]; do
      n=$((10#${BASH_REMATCH[1]})) u=${BASH_REMATCH[2]} rest=${BASH_REMATCH[3]}
      case $u in d) d=$((d + n * 86400));; h) d=$((d + n * 3600));; m) d=$((d + n * 60));; s) d=$((d + n));; esac
    done
    EPOCH=$((now + d))
  else
    EPOCH=$(date -d "$1" +%s 2>/dev/null) || die "cannot read '$1' as a time (try 25m, 14:30, 2pm, 'tomorrow 9:00')"
    # A bare clock time that has gone by today means the next one.
    if (( EPOCH <= now )) && [[ $t =~ ^[0-9]{1,2}(:[0-9]{2}){1,2}\ ?([ap]m)?$|^[0-9]{1,2}\ ?[ap]m$ ]]; then
      EPOCH=$((EPOCH + 86400))
    fi
  fi
  (( EPOCH > now )) || die "'$1' is not in the future"
}

units() {  # "unit<TAB>next-epoch" per pending reminder, soonest first
  systemctl --user list-timers --all --output=json "${PFX}*.timer" 2>/dev/null \
    | jq -r '.[] | select(.next != null and .next > 0) | [.unit, (.next / 1000000 | floor)] | @tsv' | sort -k2 -n
}

desc() { systemctl --user show -p Description --value "$1" 2>/dev/null; }

cmd_list() {
  local u next found=0 id
  while IFS=$'\t' read -r u next; do
    [ -n "$u" ] || continue
    id=${u#"$PFX"}; id=${id%.timer}
    printf '%s\t%s\t%s\n' "$id" "$(date -d "@$next" '+%a %H:%M:%S')" "$(desc "$u")"
    found=1
  done < <(units)
  (( found )) || echo "no reminders pending"
}

cmd_clear() {
  local want=${1:-all} u id n=0
  while IFS=$'\t' read -r u _; do
    [ -n "$u" ] || continue
    id=${u#"$PFX"}; id=${id%.timer}
    [[ $want == all || $want == "$id" ]] || continue
    systemctl --user stop "$u" "${u%.timer}.service" >/dev/null 2>&1 || true
    n=$((n + 1))
  done < <(units)
  if (( n == 0 )) && [[ $want != all ]]; then die "no pending reminder with id '$want' (see: ergon remind list)"; fi
  say "cleared $n reminder(s)"
}

# Runs from the timer. Hidden: `ergon remind` never documents it.
cmd_fire() {
  local alert=$1 msg=$2
  notify-send -a ergon-remind -u critical -t 0 "Reminder" "$msg" >/dev/null 2>&1 || true
  if [ "$alert" = 1 ]; then
    "$(dirname "$SELF")/ergon-alert" ergon-remind "$msg" >/dev/null 2>&1 || true
  fi
}

new_id() {
  local id=1 used
  used=$(units | cut -f1 | sed "s/^$PFX//; s/\.timer\$//")
  while grep -qx "$id" <<<"$used"; do id=$((id + 1)); done
  echo "$id"
}

cmd_add() {
  local alert=$1 when=$2 msg=$3 id out
  [ -n "$msg" ] || msg="Reminder"
  parse_when "$when"
  id=$(new_id)
  out=$(systemd-run --user --quiet --collect --unit="$PFX$id" --description="$msg" \
        --on-calendar="$(date -d "@$EPOCH" '+%Y-%m-%d %H:%M:%S')" \
        --timer-property=AccuracySec=1s --timer-property=RemainAfterElapse=no \
        "$SELF" fire "$alert" "$msg" </dev/null 2>&1) \
    || die "systemd-run failed: $out"
  say "reminder $id at $(date -d "@$EPOCH" '+%a %H:%M:%S'): $msg"
}

cmd_ask() {
  local alert=$1 when msg
  when=$(fuzzel --dmenu --lines 0 --prompt 'remind in/at (25m, 14:30)  ' </dev/null) || exit 0
  [ -n "$when" ] || exit 0
  parse_when "$when" || exit 1
  msg=$(fuzzel --dmenu --lines 0 --prompt 'remind about  ' </dev/null) || exit 0
  cmd_add "$alert" "$when" "$msg"
}

alert=0
args=()
for a in "$@"; do
  if [ "$a" = --alert ]; then alert=1; else args+=("$a"); fi
done
set -- ${args[@]+"${args[@]}"}

case "${1:-}" in
  "")      cmd_ask "$alert" ;;
  list)    cmd_list ;;
  clear)   cmd_clear "${2:-all}" ;;
  fire)    cmd_fire "$2" "$3" ;;
  -h|--help) sed -n 5,18p "$SELF" | sed 's/^# \{0,1\}//' ;;
  *)       [ $# -ge 2 ] || die "need a time and a message: ergon remind 25m \"take flats\""
           when=$1; shift; cmd_add "$alert" "$when" "$*" ;;
esac
