# GENERATED from newsboat/config.in — edit the .in, then run: ergon theme
#
# The arXiv feed lives here (see ergon-arxiv), so this is read most mornings.
color background          default   default
color listnormal          color250  default
color listnormal_unread   color159  default
color listfocus           color234  color159
color listfocus_unread    color234  color159  bold
color info                color234  color219
color article             color250  default
color end-of-text-marker  color240  default

# Unread and read must differ at a glance in a list of two hundred, and the
# only honest signal in a cool palette is brightness rather than hue.
highlight article "^(Feed|Title|Author|Date|Link):.*$" color159 default bold
highlight article "https?://[^ ]+" color219 default underline
