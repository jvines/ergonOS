# GENERATED from lazygit/config.yml.in — edit the .in, then run: ergon theme
#
# lazygit is where commits get written on this machine, so it is on screen for
# real work rather than in passing. Its default green-and-red diff is the one
# place a cool palette has to be careful: additions and deletions must stay
# instantly distinguishable, and mint-versus-magenta does that without reaching
# for the traffic-light colours the rest of the desktop avoids.

gui:
  theme:
    activeBorderColor:
      - "@COOL_ACCENT@"
      - bold
    inactiveBorderColor:
      - "@COOL_BG2@"
    searchingActiveBorderColor:
      - "@COOL_HOT_0@"
      - bold
    optionsTextColor:
      - "@COOL_DIM@"
    selectedLineBgColor:
      - "@COOL_BG1@"
    inactiveViewSelectedLineBgColor:
      - "@COOL_BG1@"
    cherryPickedCommitFgColor:
      - "@COOL_BG0@"
    cherryPickedCommitBgColor:
      - "@COOL_3@"
    markedBaseCommitFgColor:
      - "@COOL_BG0@"
    markedBaseCommitBgColor:
      - "@COOL_HOT_4@"
    unstagedChangesColor:
      - "@COOL_URGENT@"
    defaultFgColor:
      - "@COOL_FG0@"

  # Author initials in the commit list get a colour each. Left to lazygit's
  # defaults they are arbitrary ANSI; pinned to the ramp they stay inside the
  # palette and remain distinguishable from one another.
  authorColors:
    "*": "@COOL_2@"

  # Branch colours by type. The point is that a long-lived branch and a throwaway
  # one do not look the same in a list of thirty.
  branchColors:
    main: "@COOL_0@"
    master: "@COOL_0@"
    develop: "@COOL_1@"
    feature: "@COOL_3@"
    fix: "@COOL_4@"

  nerdFontsVersion: "3"
  showCommandLog: false
  showBottomLine: false

git:
  # `paging.pager`/`colorArg` is the schema lazygit 0.65 deprecated (ERGON-68):
  # it migrated this file on every launch, rewriting it and printing a notice
  # instead of opening. `diffRenderers` is the replacement -- a list so lazygit
  # can cycle renderers with `|`, but one entry behaves exactly like the old
  # single global pager. Measured against lazygit 0.65.1: it migrates the old
  # shape into precisely this one (colorArg unchanged, pager -> command).
  diffRenderers:
    - # delta, so diffs are the same renderer git uses at the terminal. The theme
      # name must match the bat theme this repo installs -- see bat/.
      colorArg: always
      command: delta --dark --paging=never --syntax-theme=ergon
