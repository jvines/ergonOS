{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#D6D6FF" },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1A1A2E", "background_color": "#FFADFF", "bold": true },
  "h2": { "prefix": "", "color": "#FFADFF", "bold": true },
  "h3": { "prefix": "", "color": "#D6D6FF", "bold": true },
  "h4": { "prefix": "", "color": "#ADFFFF", "bold": true },
  "h5": { "prefix": "", "color": "#ADFFFF" },
  "h6": { "prefix": "", "color": "#ADFFFF", "faint": true },
  "text": {},
  "strong": { "bold": true, "color": "#FFADFF" },
  "emph": { "italic": true },
  "hr": { "color": "#9494B0", "format": "\n──────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[x] ", "unticked": "[ ] " },
  "link": { "color": "#ADFFFF", "underline": true },
  "link_text": { "color": "#D6D6FF", "bold": true },
  "image": { "color": "#ADFFFF", "underline": true },
  "code": { "color": "#FFE0FF", "background_color": "#2A2A3E", "prefix": " ", "suffix": " " },
  "code_block": { "color": "#EDEDF8", "margin": 2, "chroma": {
      "text": { "color": "#EDEDF8" },
      "keyword": { "color": "#FFADFF", "bold": true },
      "name_builtin": { "color": "#ADFFFF" },
      "name_function": { "color": "#D6D6FF" },
      "literal_string": { "color": "#D0FFEA" },
      "comment": { "color": "#A6A6BC", "italic": true },
      "number": { "color": "#FFE0FF" }
  }},
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {}, "definition_term": {}, "definition_description": {},
  "html_block": {}, "html_span": {}
}
