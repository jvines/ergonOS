<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED from bat/themes/cool.tmTheme.in — edit the .in, then: ergon theme
     Then `bat cache --build`, which install.sh does.

     bat is the pager for `bat`, for `git` through delta, and for anything that
     pipes to it, so this is the syntax highlighting seen most often on the
     machine. .tmTheme is Sublime's format; bat reads it because its highlighter
     is syntect.

     The assignment is deliberate and not decorative:
       strings   mint    — the thing you are usually scanning for in a config
       numbers   blush   — distinct from strings at a glance, which matters in
                           data files where both are dense
       keywords  hot_4   — the saturated end, used sparingly
       comments  dim     — present, never competing
     Types and functions sit on the ramp between them. -->
<plist version="1.0">
<dict>
  <key>name</key><string>cool</string>
  <key>semanticClass</key><string>theme.dark.cool</string>
  <key>uuid</key><string>b7c1a6e2-1f3d-4a58-9c21-5d0e7f3a2b94</string>
  <key>colorSpaceName</key><string>sRGB</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#1A1A2E</string>
        <key>foreground</key><string>#EDEDF8</string>
        <key>caret</key><string>#ADFFFF</string>
        <key>lineHighlight</key><string>#2A2A3E</string>
        <key>selection</key><string>#3A3A4E</string>
        <key>invisibles</key><string>#3A3A4E</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#A6A6BC</string>
        <key>fontStyle</key><string>italic</string></dict>
    </dict>

    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>#D0FFEA</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Number, Constant</string>
      <key>scope</key><string>constant.numeric, constant.language, constant.character</string>
      <key>settings</key><dict><key>foreground</key><string>#FFE0FF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Keyword, Storage</string>
      <key>scope</key><string>keyword, storage.type, storage.modifier</string>
      <key>settings</key><dict><key>foreground</key><string>#FF40FF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Operator</string>
      <key>scope</key><string>keyword.operator, punctuation.separator</string>
      <key>settings</key><dict><key>foreground</key><string>#EBC2FF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function, meta.function-call</string>
      <key>settings</key><dict><key>foreground</key><string>#ADFFFF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Type, Class</string>
      <key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class</string>
      <key>settings</key><dict><key>foreground</key><string>#C2EBFF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Variable</string>
      <key>scope</key><string>variable, variable.other, variable.parameter</string>
      <key>settings</key><dict><key>foreground</key><string>#EDEDF8</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Tag, Key</string>
      <key>scope</key><string>entity.name.tag, support.type.property-name, meta.mapping.key</string>
      <key>settings</key><dict><key>foreground</key><string>#D6D6FF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid, invalid.illegal</string>
      <key>settings</key><dict><key>foreground</key><string>#1A1A2E</string>
        <key>background</key><string>#FF40FF</string></dict>
    </dict>

    <!-- Diffs. delta renders through this, so these are the colours on every
         `git diff` and every lazygit hunk. Mint and magenta rather than green
         and red: the distinction has to survive on a machine that otherwise
         has no traffic-light colours at all. -->
    <dict>
      <key>name</key><string>diff.inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#D0FFEA</string></dict>
    </dict>
    <dict>
      <key>name</key><string>diff.deleted</string>
      <key>scope</key><string>markup.deleted</string>
      <key>settings</key><dict><key>foreground</key><string>#FF40FF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>diff.changed</string>
      <key>scope</key><string>markup.changed</string>
      <key>settings</key><dict><key>foreground</key><string>#EBC2FF</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Markup heading</string>
      <key>scope</key><string>markup.heading</string>
      <key>settings</key><dict><key>foreground</key><string>#ADFFFF</string>
        <key>fontStyle</key><string>bold</string></dict>
    </dict>
  </array>
</dict>
</plist>
