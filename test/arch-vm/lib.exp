# Shared expect helpers for the VM harnesses.
#
# A COMMITTED file, copied into the work dir by whichever harness runs. It used
# to be generated by test-arch-vm.sh, which meant the other two harnesses
# depended on a file a different script happened to have left behind -- and an
# earlier copy-paste version of this proc had already let two phases silently
# diverge. One definition, three consumers, in version control.
#
# Pure Tcl: every variable here is a proc parameter or a local, so nothing needs
# escaping and nothing is interpolated by a shell.

# Unlock LUKS, then wait for the shell that serial autologin drops us into.
#
# There is deliberately no login(1) handling. The harness configures autologin
# on ttyS0 (see guest-serial-console.sh) precisely so this does not have to deal
# with it: login prints "Password: " with no newline and with echo off, expect
# did not see it promptly, and the password ended up typed at the NEXT login
# prompt as a username -- three boots running.
proc unlock_and_login {passphrase host user userpass} {
  # Answer GRUB's passphrase prompt, then WAIT for the kernel to take over
  # before sending anything else.
  #
  # That wait is not politeness. After the passphrase GRUB shows its menu and
  # counts down, and ANY keystroke cancels the countdown -- so a poll loop that
  # starts typing immediately types into GRUB and the machine never boots. It
  # looks exactly like a broken install: megabytes of menu redraws, no kernel.
  #
  # The marker must work for a RESUME as well as a fresh boot. systemd prints
  # "Welcome to Arch Linux!" only when it starts normally; restoring a
  # hibernation image prints nothing of the sort, so waiting on that banner
  # alone hangs forever on exactly the path hibernation exists for. The
  # initramfs messages below appear either way.
  expect {
    timeout { puts "\n!! never reached the LUKS prompt"; exit 1 }
    -nocase "passphrase" { send "$passphrase\r"; exp_continue }
    -re {Welcome to|Reached target|Cryptography Setup|Resume from hibernation} {}
  }

  set saved $::timeout
  set ::timeout 10
  set ready 0
  for {set i 0} {$i < 40} {incr i} {
    send "echo VM''_READY\r"
    # Multi-line, ALWAYS. A single-line expect block silently never matches:
    # no error, the pattern simply never fires, and the loop spins out.
    expect {
      timeout {}
      -nocase "passphrase"  { send "$passphrase\r" }
      -re "$host login:"    {
        # Autologin SHOULD mean this never appears. If it does, log in the slow
        # way rather than failing: send the user, PAUSE so login can print its
        # echo-suppressed "Password: " and switch the tty, then send the
        # password. The pause is the entire fix.
        send "$user\r"
        sleep 2
        send "$userpass\r"
        sleep 1
      }
      "VM_READY"            { set ready 1 }
    }
    if {$ready} break
  }
  set ::timeout $saved
  if {!$ready} { puts "\n!! autologin never produced a usable shell"; exit 1 }

  # Leave zsh for a bash whose behaviour does not depend on a config this VM
  # never installs.
  send "exec /bin/bash --norc --noprofile\r"
  set ::timeout 10
  set ready 0
  for {set i 0} {$i < 10} {incr i} {
    send "echo BASH''_READY\r"
    expect {
      timeout {}
      "BASH_READY" { set ready 1 }
    }
    if {$ready} break
  }
  set ::timeout $saved
  if {!$ready} { puts "\n!! could not switch to bash"; exit 1 }
}
