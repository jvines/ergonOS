# GENERATED from fuzzel/fuzzel.ini.in — edit the .in, then run: ergon theme
#
# Launcher. Deliberately small: this opens GUI apps, which on this machine is a
# short list — browser, discord, moonlight, a PDF, an image. Everything else is
# started from a shell that is already open.
#
# fuzzel rather than a menu system: it reads .desktop files and nothing else,
# has no plugin surface, and is one ini file. Both of those are the point.

[main]
font=JetBrainsMono Nerd Font:size=12
dpi-aware=no
prompt="  "
icon-theme=Papirus-Dark
icons-enabled=yes
fields=name,generic,comment,categories,filename,keywords
# ERGON-19. Without these two lines everything the launcher starts is a child of
# fuzzel, which is a child of the compositor's own systemd unit -- so a browser
# or a notebook that exhausts memory is a process the kernel kills INSIDE
# wayland-wm@hyprland.service, and uwsm ends the session on that. uwsm-app puts
# each launch in its own scope under app-graphical.slice, where systemd-oomd may
# kill it and nothing else.
launch-prefix=uwsm-app --
# ergon-term rather than `wezterm start --`: it passes --always-new-process (a
# shared wezterm process means one cgroup for every terminal, so one kill takes
# them all) and it falls back to foot on a machine where the AUR build is
# missing or mid-rebuild.
terminal=ergon-term
layer=overlay
lines=12
width=48
horizontal-pad=20
vertical-pad=14
inner-pad=6
line-height=22
tabs=4

[colors]
# fuzzel wants RRGGBBAA with no hash.
background=@COOL_BG0:raw@f2
text=@COOL_FG0:raw@ff
prompt=@COOL_ACCENT:raw@ff
placeholder=@COOL_DIMMER:raw@ff
input=@COOL_FG0:raw@ff
match=@COOL_ACTIVE:raw@ff
selection=@COOL_BG1:raw@ff
selection-text=@COOL_FG0:raw@ff
selection-match=@COOL_ACTIVE:raw@ff
counter=@COOL_DIMMER:raw@ff
border=@COOL_ACCENT:raw@ff

[border]
width=1
radius=4

[dmenu]
exit-immediately-if-empty=yes

[key-bindings]
# Ctrl-n/p as well as arrows: same motion as every other list on this machine.
next=Down Control+n
prev=Up Control+p

# Your overrides, from a file this repo never renders over.
#
# [main] is reopened because `include` has to be in a section, and last in the
# file because fuzzel applies keys in source order with unconditional
# overwrite -- anything after the include would clobber you instead.
#
# ~/ is required: fuzzel rejects a bare relative path outright, and expands ~
# itself. A missing file is survivable at runtime but fails --check-config,
# which is what bin/test-hypr-config.sh runs, so lib/user-config.sh creates it.
[main]
include=~/.config/ergon/fuzzel.ini
