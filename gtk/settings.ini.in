# GENERATED from gtk/settings.ini.in — edit the .in, then run: ergon theme
#
# Linked to BOTH ~/.config/gtk-3.0/settings.ini and ~/.config/gtk-4.0/settings.ini.
#
# GTK4 reads its theme from gsettings, not from this file, and provision-arch.sh
# sets those keys too — but only when there is a session bus to set them on.
# Provisioning over ssh has no bus, so this file is what makes a freshly
# installed machine come up dark instead of blinding you on first login.

[Settings]
gtk-application-prefer-dark-theme=@COOL_PREFER_DARK@
gtk-theme-name=@COOL_GTK_THEME@
gtk-icon-theme-name=@COOL_ICON_THEME@
gtk-font-name=Noto Sans 11
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24

# Middle-click paste from the PRIMARY selection. Off by default in GTK3 since
# 3.24 and the reason pasting into a GTK app behaves differently from pasting
# into every terminal on this machine.
gtk-enable-primary-paste=1

# Hyprland draws the borders; client-side decorations would add a second title
# bar inside the window frame.
gtk-decoration-layout=:
