# Fleet matplotlib defaults. Linked to ~/.config/matplotlib/matplotlibrc.
#
# image.cmap is `cool` because every plot on this fleet uses `cool` -- this makes
# it the DEFAULT rather than something to remember on each imshow/pcolormesh.
#
# It does NOT cover the discrete-colour case. For a handful of series, sample
# cool and pastelise it (cool_pastel() in CLAUDE-shared.md); matplotlib has no
# rcParam that can express that.
image.cmap: cool

# Sensible for reading on screen and for figures that end up in a paper.
figure.dpi: 110
savefig.dpi: 300
savefig.bbox: tight
figure.autolayout: True
axes.grid: True
grid.alpha: 0.3
font.size: 11
legend.frameon: False
